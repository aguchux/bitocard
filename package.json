{
  "name": "bitocard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck && turbo run build && turbo run test",
    "dev:storefront": "turbo run dev --filter=@bitocard/storefront",
    "dev:api": "turbo run dev --filter=@bitocard/api",
    "dev:docs": "turbo run dev --filter=@bitocard/docs",
    "dev:admin": "turbo run dev --filter=@bitocard/admin",
    "dev:shq": "turbo run dev --filter=@bitocard/shq",
    "dev:legals": "turbo run dev --filter=@bitocard/legals",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:api": "docker compose --profile api up -d --build --wait",
    "test:docker": "turbo run build --filter=@bitocard/api && npm run test:docker -w @bitocard/api"
  },
  "devDependencies": {
    "turbo": "2.11.5"
  }
}
