# /etc/udozo/api.env on the droplet (mode 600, owner deploy): Udozo's API instance (api.udozo.com,
# docs/UDOZO_SPINOFF_PLAN.md). Never commit the real file. Its presence switches Udozo's API on at the next deploy
# (deploy.sh). docker-compose.yml adds APP_PRODUCT=udozo, APP_ENV=production, PORT=3001 and TRUST_PROXY=1 itself.
# Nothing here is shared with BitoCard: its own database, Redis, keys and secrets.

# Udozo's own Neon database, the pooled address (never BitoCard's: each deploy checks the two differ).
DATABASE_URL=
# A new key of its own, made once (`openssl rand -base64 32`) and kept safe: it seals Udozo's stored secrets.
ENCRYPTION_KEY=
# The scheduler sends it to Udozo's /v1/cron/<job>: 32 characters or more, its own.
CRON_SECRET=
# Shared with udozo.com's app (apps/udozo) only.
STORE_SERVER_SECRET=
ALLOWED_ORIGINS=https://udozo.com,https://www.udozo.com,https://shq.udozo.com,https://admin.udozo.com,https://verify.udozo.com
SESSION_COOKIE_DOMAIN=.udozo.com
COOKIE_SECURE=on
ADMIN_APP_URL=https://admin.udozo.com
ADMIN_EMAIL_DOMAINS=udozo.com
ADMIN_SETUP_EMAILS=
# Udozo's own Upstash database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=600
WEBHOOK_ALLOW_PRIVATE_URLS=off
EVENTS_SETTLE_SECONDS=5
LOG_LEVEL=info
