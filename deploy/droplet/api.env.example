# /etc/bitocard/api.env on the droplet (mode 600, owner deploy). Never commit the real file.
# The same variables as the Vercel project bitocard-api (team golojan-tech-ltd), with the same values: service keys are
# integration settings in the database (Settings > Integrations), so nothing else moves. docker-compose.yml adds
# APP_ENV=production, PORT=3001 and TRUST_PROXY=1 itself.

# Neon, the pooled address. Migrations switch to the direct address themselves (scripts/migrate-url.mjs).
DATABASE_URL=
# Exactly the production value: it decrypts everything already stored. Never generate a new one.
ENCRYPTION_KEY=
# The scheduler sends it to /v1/cron/<job>. Keep Vercel's value until the Vercel project is paused (README, Cutover).
CRON_SECRET=
# Shared with the storefront.
STORE_SERVER_SECRET=
ALLOWED_ORIGINS=https://shq.bitocard.com,https://admin.bitocard.com,https://docs.bitocard.com,https://verify.bitocard.com,https://*.bitocard.com
SESSION_COOKIE_DOMAIN=.bitocard.com
COOKIE_SECURE=on
ADMIN_EMAIL_DOMAINS=bitocard.com,golojan.co.uk
ADMIN_SETUP_EMAILS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=600
WEBHOOK_ALLOW_PRIVATE_URLS=off
EVENTS_SETTLE_SECONDS=5
LOG_LEVEL=info
