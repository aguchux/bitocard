# api.udozo.com: Udozo's API instance (docs/UDOZO_SPINOFF_PLAN.md, step 5), on this droplet beside BitoCard's, behind
# Cloudflare (proxied, SSL mode Full (strict)) with Cloudflare's origin certificate for udozo.com. deploy.sh copies this
# file into sites-enabled/ only once /etc/udozo/api.env and the certificate are there, so BitoCard never depends on it.
api.udozo.com {
	tls /etc/caddy/certs/udozo-origin.pem /etc/caddy/certs/udozo-origin.key

	request_body {
		max_size 12MB
	}

	reverse_proxy api-udozo:3001 {
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	log {
		output stdout
		format json
	}
}
