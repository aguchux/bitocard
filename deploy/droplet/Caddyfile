# api.bitocard.com behind Cloudflare (proxied, SSL mode Full (strict)) with Cloudflare's origin certificate.
# The droplet's DigitalOcean firewall lets only Cloudflare's addresses reach ports 80 and 443 (README.md).
{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/); only requests from these may name the visitor
		# in CF-Connecting-IP. Anything else is taken at its own address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

api.bitocard.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Uploads (identity documents, chat files) are at most 4 MB; leave room for multipart overhead.
	request_body {
		max_size 12MB
	}

	reverse_proxy api:3001 {
		# One address: the visitor's (from Cloudflare) or the peer's. The API trusts exactly this one hop (TRUST_PROXY=1).
		header_up X-Forwarded-For {client_ip}
		# While a deploy restarts the API, hold requests for up to 30 seconds instead of failing them.
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	log {
		output stdout
		format json
	}
}
