# BitoCard's API: secrets. Copy to api.secret.env (never committed) and fill in from the droplet's
# /etc/bitocard/api.env, value for value. Never generate a new ENCRYPTION_KEY: it decrypts everything already stored.
# Neon, the pooled address (migrations switch to the direct address themselves, or DIRECT_URL when set).
DATABASE_URL=
ENCRYPTION_KEY=
# The scheduler sends it to /v1/cron/<job>: 32 characters or more.
CRON_SECRET=
# Shared with the storefront (web.secret.env).
STORE_SERVER_SECRET=
AFRIPPA_SERVER_SECRET=
ADMIN_SETUP_EMAILS=
AFRIPPA_ADMIN_SETUP_EMAILS=
