# BitoCard's API: settings that are not secret. Copy to api.config.env (never committed).
# The same values as deploy/droplet/api.env, less the secrets (api.secret.env).
APP_ENV=production
PORT=3001
# Cloudflare, then Traefik: the visitor is two hops back (Traefik trusts only Cloudflare's addresses, so the first hop
# is always Cloudflare's, never one the client wrote).
TRUST_PROXY=2
# HTTPS origins only in production.
ALLOWED_ORIGINS=https://*.bitocard.com,https://shq.bitocard.com,https://admin.bitocard.com,https://bitocard.com,https://www.bitocard.com,https://docs.bitocard.com,https://verify.bitocard.com
SESSION_COOKIE_DOMAIN=.bitocard.com
COOKIE_SECURE=on
ADMIN_EMAIL_DOMAINS=bitocard.com,golojan.co.uk
RATE_LIMIT_PER_MINUTE=600
WEBHOOK_ALLOW_PRIVATE_URLS=off
# Off Vercel, webhook deliveries go straight after each commit (with the webhooks job as backstop).
WEBHOOK_QUEUE=database
EVENTS_SETTLE_SECONDS=5
LOG_LEVEL=info
