# BitoCard's frontends: the addresses their servers use. Copy to web.config.env (never committed).
# Their servers call the API inside the cluster; browsers always use https://api.bitocard.com.
API_URL=http://bitocard-api
STOREFRONT_URL=https://bitocard.com
LEGALS_URL=https://legals.bitocard.com
SHQ_URL=https://shq.bitocard.com
