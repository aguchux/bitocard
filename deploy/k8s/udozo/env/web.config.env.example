# Udozo's frontends: the addresses their servers use. Copy to web.config.env (never committed).
API_URL=http://udozo-api
UDOZO_URL=https://udozo.com
CONNECT_URL=https://connect.udozo.com
POS_URL=https://pos.udozo.com
# Optional (udozo.com): search engines' site verification, and the app links once the store accounts exist
# (apps/udozo/lib/app-links.ts; /.well-known answers 404 until all three are set). Leave out what is not used:
# deploy.sh refuses a line with an empty value.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# UDOZO_IOS_APP_IDS=
# UDOZO_ANDROID_PACKAGE=
# UDOZO_ANDROID_CERT_SHA256=
