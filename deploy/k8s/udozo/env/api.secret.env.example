# Udozo's API: secrets. Copy to api.secret.env (never committed) and fill in from the Vercel project udozo-api
# (`vercel env pull` there). Never BitoCard's values, and never a new ENCRYPTION_KEY.
DATABASE_URL=
ENCRYPTION_KEY=
CRON_SECRET=
# Shared with udozo.com, Connect and POS (web.secret.env).
STORE_SERVER_SECRET=
ADMIN_SETUP_EMAILS=
RESEND_API_KEY=
