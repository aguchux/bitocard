# Udozo's API: settings that are not secret. Copy to api.config.env (never committed).
# The same values as the Vercel project udozo-api's (apps/udozo-api/vercel.env.example), less the secrets.
APP_ENV=production
APP_PRODUCT=udozo
PORT=3010
TRUST_PROXY=2
ALLOWED_ORIGINS=https://udozo.com,https://www.udozo.com,https://shq.udozo.com,https://admin.udozo.com,https://verify.udozo.com,https://connect.udozo.com,https://pos.udozo.com
SESSION_COOKIE_DOMAIN=.udozo.com
COOKIE_SECURE=on
ADMIN_APP_URL=https://admin.udozo.com
ADMIN_EMAIL_DOMAINS=udozo.com
RATE_LIMIT_PER_MINUTE=600
WEBHOOK_ALLOW_PRIVATE_URLS=off
# Off Vercel, no Vercel Queues: deliveries go straight after each commit (with the webhooks job as backstop).
WEBHOOK_QUEUE=database
EVENTS_SETTLE_SECONDS=5
LOG_LEVEL=info
UPSTASH_REDIS_REST_URL=http://redis-udozo
