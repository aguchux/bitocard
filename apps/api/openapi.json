  "info": {
    "title": "BitoCard API",
    "description": "One API for catalogue, quotes, orders, wallets and webhooks. Sandbox and live share this address; your API key decides the mode.",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://api.bitocard.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "API key",
        "type": "http",
        "description": "API key: bc_test_… (sandbox) or bc_live_… (live)."
      }
    },
    "schemas": {
      "OptionValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "example": "bank"
          }
        },
        "required": [
          "value"
        ]
      },
      "ResellerProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "description": "Business country, if not yet set. Cannot be changed afterwards.",
            "example": "NG"
          }
        }
      },
      "CreateStoreDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "Ada Digital"
          },
          "subdomain": {
            "type": "string",
            "description": "The store address: <subdomain>.bitocard.com.",
            "example": "adadigital"
          },
          "logo_url": {
            "type": "object",
            "description": "HTTPS URL of the logo, or null to remove it.",
            "nullable": true
          },
          "primary_color": {
            "type": "string",
            "example": "#070f4c"
          },
          "accent_color": {
            "type": "string",
            "example": "#ff2382"
          }
        }
      },
      "StoreFieldsDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "Ada Digital"
          },
          "subdomain": {
            "type": "string",
            "description": "The store address: <subdomain>.bitocard.com.",
            "example": "adadigital"
          },
          "logo_url": {
            "type": "object",
            "description": "HTTPS URL of the logo, or null to remove it.",
            "nullable": true
          },
          "primary_color": {
            "type": "string",
            "example": "#070f4c"
          },
          "accent_color": {
            "type": "string",
            "example": "#ff2382"
          }
        }
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Your full name.",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ada Obi"
          },
          "email": {
            "type": "string",
            "description": "Email address; a 6-digit code is sent to confirm it.",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "description": "At least 10 characters. Passwords found in public data breaches are refused.",
            "minLength": 10,
            "maxLength": 128,
            "example": "correct horse battery"
          },
          "business_name": {
            "type": "string",
            "description": "Business name shown on the reseller account. Defaults to your name.",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ada Digital"
          },
          "country": {
            "type": "string",
            "description": "Country the business operates in (ISO 3166-1 alpha-2). During the pilot: NG, GH or KE. Not needed with an invitation.",
            "pattern": "^[A-Z]{2}$",
            "example": "NG"
          },
          "invitation_token": {
            "type": "string",
            "description": "Join a reseller's team from an invitation link, instead of creating a reseller account."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Email address, or a verified mobile number in international format.",
            "minLength": 3,
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "correct horse battery"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "CodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The 6-digit code that was sent to you.",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "code"
        ]
      },
      "PhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Mobile number in international format, or local format for your business country.",
            "minLength": 6,
            "maxLength": 20,
            "example": "+2348012345678"
          }
        },
        "required": [
          "phone"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "code": {
            "type": "string",
            "description": "The 6-digit code that was sent to you.",
            "pattern": "^\\d{6}$",
            "example": "482913"
          },
          "password": {
            "type": "string",
            "description": "At least 10 characters. Passwords found in public data breaches are refused.",
            "minLength": 10,
            "maxLength": 128,
            "example": "correct horse battery"
          }
        },
        "required": [
          "email",
          "code",
          "password"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "A name to recognise the key by, such as the system that uses it.",
            "minLength": 1,
            "maxLength": 60,
            "example": "Website backend"
          },
          "mode": {
            "type": "string",
            "enum": [
              "test",
              "live"
            ],
            "description": "test keys use the sandbox; live keys move real money."
          },
          "scopes": {
            "type": "array",
            "description": "What the key may do. Defaults to every scope.",
            "items": {
              "type": "string",
              "enum": [
                "catalogue:read",
                "quotes:write",
                "orders:read",
                "orders:write",
                "wallet:read",
                "webhooks:manage",
                "events:read",
                "stores:manage"
              ]
            }
          }
        },
        "required": [
          "name",
          "mode"
        ]
      },
      "RollApiKeyDto": {
        "type": "object",
        "properties": {
          "overlap_hours": {
            "type": "number",
            "description": "Hours the old key keeps working, so you can deploy the new one (0 to 72).",
            "minimum": 0,
            "maximum": 72,
            "default": 24
          }
        }
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "chidi@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "developer",
              "finance",
              "support"
            ],
            "description": "admin manages the team and keys; developer manages keys; finance and support have their own areas."
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "AcceptDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the invitation link."
          }
        },
        "required": [
          "token"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "developer",
              "finance",
              "support"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    }
  }
}
