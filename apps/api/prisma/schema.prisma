// BitoCard API database. Change models here, then create a migration with `npm run db:migrate:create -w @bitocard/api -- <name>`.
// Money is stored in integer minor units; balances are always derived from ledger entries (added in M4).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum IdempotencyState {
  in_progress
  completed
}

/// One row per idempotency key, so a retried POST returns the original result instead of acting twice.
model IdempotencyKey {
  id             String           @id @default(uuid()) @db.Uuid
  /// Who sent the request (API key or account once sign-in exists; "anonymous" until then). Keys are unique per scope.
  scope          String
  key            String           @db.VarChar(255)
  method         String           @db.VarChar(10)
  path           String
  /// SHA-256 of the request body, to reject a reused key with a different request.
  requestHash    String           @map("request_hash") @db.Char(64)
  state          IdempotencyState @default(in_progress)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at")
  expiresAt      DateTime         @map("expires_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// M2: sign-in and access
// ---------------------------------------------------------------------------

/// Two separate worlds: resellers (and their staff) sign in to the dashboard; admins sign in to admin.bitocard.com.
/// The same email can exist once in each realm.
enum Realm {
  reseller
  admin
}

enum UserStatus {
  active
  disabled
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  realm           Realm
  /// Stored lower-case.
  email           String
  emailVerifiedAt DateTime?   @map("email_verified_at")
  /// E.164, for example +2348012345678. Only resellers use phone sign-in.
  phone           String?
  phoneVerifiedAt DateTime?   @map("phone_verified_at")
  phones          UserPhone[]
  /// Argon2id. Null for Google-only accounts.
  passwordHash    String?     @map("password_hash")
  name            String
  status          UserStatus  @default(active)
  /// Admin roles (super_admin, operations, finance, support). Reseller staff roles live on ResellerMember.
  adminRoles      String[]    @default([]) @map("admin_roles")
  failedSignIns   Int         @default(0) @map("failed_sign_ins")
  lockedUntil     DateTime?   @map("locked_until")
  lastSignInAt    DateTime?   @map("last_sign_in_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  verificationCodes       VerificationCode[]
  totp                    TotpCredential?
  memberships             ResellerMember[]
  apiKeysCreated          ApiKey[]
  notifications           Notification[]
  devices                 Device[]
  notificationPreferences NotificationPreference[]
  emails                  UserEmail[]

  @@unique([realm, email])
  @@unique([realm, phone])
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A Google sign-in in progress (10 minutes). The browser holds the state token in a cookie; this holds the PKCE verifier.
model OAuthState {
  /// SHA-256 of the state token.
  id           String      @id @db.Char(64)
  codeVerifier String      @map("code_verifier")
  nonce        String
  returnTo     String      @map("return_to")
  /// Set when a signed-in person is linking Google to their existing account.
  linkUserId   String?     @map("link_user_id") @db.Uuid
  /// Only `signup` creates an account; `signin` with an unknown Google account fails.
  intent       OAuthIntent @default(signin)
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("oauth_states")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  realm       Realm
  /// SHA-256 of the session token; the token itself only ever lives in the cookie.
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  /// Admin sessions: sensitive and money actions are allowed until then (5 minutes after the admin entered their
  /// authenticator code). Fixed, never extended by use, and gone with the session.
  stepUpUntil DateTime? @map("step_up_until")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Why the Google round trip was started.
enum OAuthIntent {
  signin
  signup
  link
}

enum CodePurpose {
  email_verification
  phone_verification
  phone_add
  password_reset
  email_change
  admin_mfa_challenge
  /// A set-password link emailed to an admin from the sign-in page (first visit or Forgot password).
  admin_password_link
}

/// Single-use codes sent by email or SMS, and short-lived admin sign-in challenges. Only the hash is stored.
model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  purpose    CodePurpose
  /// The email address or phone number the code was sent to.
  target     String
  codeHash   String      @map("code_hash") @db.Char(64)
  attempts   Int         @default(0)
  expiresAt  DateTime    @map("expires_at")
  consumedAt DateTime?   @map("consumed_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

/// Step-by-step sign-up: the email is confirmed with a code before the account exists, then exchanged for a one-time
/// sign-up token. Only hashes are stored; rows are removed after a day.
model SignupVerification {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  /// When the code expires, then (once confirmed) when the sign-up token expires.
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  tokenHash  String?   @unique @map("token_hash") @db.Char(64)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("signup_verifications")
}

/// What a platform fee is charged on.
enum FeeKind {
  /// Orders fulfilled through the reseller's own supplier.
  supplier_order
  /// Payments taken through the reseller's own payment gateway.
  gateway_payment
}

/// An admin's fee rate. The most specific rule for a transaction wins (country, then category, then plan); none: no fee.
model FeeRule {
  id          String           @id @default(uuid()) @db.Uuid
  kind        FeeKind
  countryCode String?          @map("country_code") @db.Char(2)
  category    ProductCategory?
  planCode    String?          @map("plan_code")
  /// `kind:country:category:plan` with `*` for any, so a scope has one rule.
  scopeKey    String           @unique @map("scope_key")
  /// Parts per billion of the base: 1 = 0.0000001%, 100,000,000 = 10%.
  ratePpb     Int              @map("rate_ppb")
  /// Optional minimum per transaction, in the country's currency (needs a country).
  minFeeMinor BigInt?          @map("min_fee_minor")
  updatedById String?          @map("updated_by_id") @db.Uuid
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("fee_rules")
}

enum FeeChargeStatus {
  /// The most the fee can be is held from the wallet.
  held
  /// Charged (possibly nothing this time, the fraction carried).
  charged
  /// The transaction failed: the hold was returned and nothing charged.
  released
  /// Charged, then given back.
  refunded
}

/// One platform fee: its rule, base and exact amount, what was held and charged, and the carried fraction before and after.
model FeeCharge {
  id              String           @id @default(uuid()) @db.Uuid
  resellerId      String           @map("reseller_id") @db.Uuid
  mode            LedgerMode
  currency        String           @db.Char(3)
  kind            FeeKind
  /// What the fee is on: `order` or `payment`, and its id.
  sourceType      String           @map("source_type")
  sourceId        String           @map("source_id")
  /// `fee:<source type>:<source id>`: one fee per transaction.
  reference       String           @unique
  category        ProductCategory?
  /// The reseller's country and plan when charged, for reports.
  countryCode     String?          @map("country_code") @db.Char(2)
  planCode        String?          @map("plan_code")
  ruleId          String?          @map("rule_id") @db.Uuid
  ratePpb         Int              @map("rate_ppb")
  baseMinor       BigInt           @map("base_minor")
  minFeeMinor     BigInt?          @map("min_fee_minor")
  /// The exact fee in billionths of a minor unit (base x rate in parts per billion).
  exactNano       BigInt           @map("exact_nano")
  heldMinor       BigInt           @map("held_minor")
  holdId          String?          @map("hold_id") @db.Uuid
  status          FeeChargeStatus  @default(held)
  chargedMinor    BigInt?          @map("charged_minor")
  carryBeforeNano BigInt?          @map("carry_before_nano")
  carryAfterNano  BigInt?          @map("carry_after_nano")
  /// What a minimum fee added beyond the exact fee and carry (billionths), so reconciliation still adds up.
  extraNano       BigInt?          @map("extra_nano")
  refundReason    String?          @map("refund_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  settledAt       DateTime?        @map("settled_at")
  reseller        Reseller         @relation(fields: [resellerId], references: [id])

  @@index([resellerId, mode, createdAt])
  @@index([status, createdAt])
  @@map("fee_charges")
}

/// The fraction of a minor unit each reseller has accrued but not yet been charged (billionths, always below one unit).
model FeeCarry {
  resellerId String     @map("reseller_id") @db.Uuid
  mode       LedgerMode
  currency   String     @db.Char(3)
  carryNano  BigInt     @default(0) @map("carry_nano")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@id([resellerId, mode, currency])
  @@map("fee_carries")
}

enum IntegrationApproval {
  automatic
  review
}

/// Which integrations resellers may connect their own accounts to, and where. No row: not offered.
model IntegrationOffer {
  /// The connectable integration's id (`src/reseller-integrations/connectable.ts`).
  integrationId  String              @id @map("integration_id")
  /// Switched on by an admin (Settings > Integrations, on the integration's card): only then can resellers see and use
  /// it. Off hides it and stops resellers' connections being used, without erasing them.
  resellerAccess Boolean             @default(false) @map("reseller_access")
  /// Offered to resellers in every country.
  global         Boolean             @default(false)
  /// Offered to resellers in these countries (when not global).
  countries      String[]            @default([])
  /// Live connections start active, or wait for an admin's review.
  approval       IntegrationApproval @default(review)
  updatedById    String?             @map("updated_by_id") @db.Uuid
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("integration_offers")
}

/// When a reseller's own supplier is used: before BitoCard's suppliers, only when BitoCard has no offer, or never.
enum ConnectionRouting {
  preferred
  fallback
  off
}

/// An offer from a reseller's own supplier account, priced at their own cost. Only ever used for that reseller.
model ResellerOffer {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @map("connection_id") @db.Uuid
  resellerId   String             @map("reseller_id") @db.Uuid
  mode         LedgerMode
  /// The integration (supplier) code, for example `reloadly`.
  supplierCode String             @map("supplier_code")
  productId    String             @map("product_id") @db.Uuid
  sku          String
  costCurrency String             @map("cost_currency") @db.Char(3)
  costRatio    Decimal            @map("cost_ratio") @db.Decimal(24, 10)
  costFeeMinor BigInt             @default(0) @map("cost_fee_minor")
  meta         Json?
  available    Boolean            @default(true)
  syncedAt     DateTime           @map("synced_at")
  connection   ResellerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([connectionId, sku])
  @@index([resellerId, mode, productId])
  @@map("reseller_offers")
}

enum ConnectionStatus {
  pending_review
  active
  rejected
  suspended
  disconnected
}

/// A reseller's own account with a supplier or payment gateway, per mode. Credentials are encrypted, never returned.
model ResellerConnection {
  id                   String            @id @default(uuid()) @db.Uuid
  resellerId           String            @map("reseller_id") @db.Uuid
  integrationId        String            @map("integration_id")
  mode                 LedgerMode
  status               ConnectionStatus
  /// Every credential as encrypted JSON; erased on disconnection or rejection.
  credentialsEncrypted String?           @map("credentials_encrypted")
  /// Non-secret values (shown back), and the last four characters of secrets.
  publicValues         Json              @default("{}") @map("public_values")
  hints                Json              @default("{}")
  lastCheckedAt        DateTime?         @map("last_checked_at")
  lastCheckOk          Boolean?          @map("last_check_ok")
  lastCheckMessage     String?           @map("last_check_message")
  /// Why an admin rejected or suspended it (shown to the reseller).
  decisionNote         String?           @map("decision_note")
  decidedById          String?           @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?         @map("decided_at")
  connectedById        String?           @map("connected_by_id") @db.Uuid
  /// Suppliers: when to use this account's offers instead of BitoCard's.
  routing              ConnectionRouting @default(preferred)
  lastSyncedAt         DateTime?         @map("last_synced_at")
  lastSyncError        String?           @map("last_sync_error")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  reseller             Reseller          @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  offers               ResellerOffer[]

  @@unique([resellerId, integrationId, mode])
  @@index([status])
  @@map("reseller_connections")
}

/// Admin authenticator-app secret, encrypted at rest. Admins cannot use the admin app until it is confirmed.
model TotpCredential {
  userId             String    @id @map("user_id") @db.Uuid
  secretEncrypted    String    @map("secret_encrypted")
  confirmedAt        DateTime? @map("confirmed_at")
  /// SHA-256 hashes of one-time recovery codes; used codes are removed.
  recoveryCodeHashes String[]  @default([]) @map("recovery_code_hashes")
  /// Last accepted time step, so a code cannot be replayed.
  lastUsedStep       BigInt?   @map("last_used_step")
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_credentials")
}

enum ResellerStatus {
  pending
  active
  suspended
}

/// A reseller business. Stores, wallets and countries attach to it in later milestones.
model Reseller {
  id                        String                    @id @default(uuid()) @db.Uuid
  /// Who collects their hosted stores' customer payments: `own` (their own payment gateway, where they may use and have
  /// one; Premium and switched on for their market) or `bitocard` (BitoCard's gateways, the money reaching their wallet).
  paymentCollector          String                    @default("own") @map("payment_collector")
  name                      String
  /// ISO 3166-1 alpha-2 (NG, GH, KE during the pilot). Set at sign-up or during onboarding.
  country                   String?                   @db.Char(2)
  status                    ResellerStatus            @default(pending)
  /// When the business owner passed the identity check (Didit); required before going live.
  verifiedAt                DateTime?                 @map("verified_at")
  /// The owner's name as verified, for matching payout bank accounts.
  verifiedName              String?                   @map("verified_name")
  /// An admin let this reseller go live without the owner's identity check (audited). Payouts and the startup
  /// allowance still need the check itself.
  identityWaivedAt          DateTime?                 @map("identity_waived_at")
  identityWaivedBy          String?                   @map("identity_waived_by") @db.Uuid
  identityWaiverReason      String?                   @map("identity_waiver_reason")
  /// The owner's BVN was checked with Flutterwave and its name matched the verified owner (Nigeria; reserved accounts).
  bvnVerifiedAt             DateTime?                 @map("bvn_verified_at")
  /// KYB (BitoCard Verify): unregistered (a person trading) or a registered business; null until the owner chooses.
  businessType              ResellerBusinessType?     @map("business_type")
  /// The registered business's details, set when its KYB is approved (registered businesses only).
  registeredName            String?                   @map("registered_name")
  registrationNumber        String?                   @map("registration_number")
  businessAddress           String?                   @map("business_address")
  /// When BitoCard approved the business's KYB (registered businesses: documents checked). Registered, KYB-verified,
  /// active resellers review their own customers' identity checks.
  kybVerifiedAt             DateTime?                 @map("kyb_verified_at")
  /// The account's plan: the highest plan among its stores' subscriptions (Startup without one), kept by
  /// `StoreSubscriptionsService.syncAccountPlan`. Account-wide features and limits read it.
  planCode                  String                    @default("standard") @map("plan_code")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  members                   ResellerMember[]
  invitations               Invitation[]
  apiKeys                   ApiKey[]
  countryRef                Country?                  @relation(fields: [country], references: [code])
  plan                      Plan                      @relation(fields: [planCode], references: [code])
  stores                    Store[]
  domains                   StoreDomain[]
  options                   ResellerOption[]
  switches                  FeatureSwitch[]
  /// Premium billing (M4): when the next monthly charge is due. Null means not billed (Standard, or a plan set by an admin).
  planRenewsAt              DateTime?                 @map("plan_renews_at")
  /// Switch to Standard at the next renewal instead of charging.
  planCancelAtPeriodEnd     Boolean                   @default(false) @map("plan_cancel_at_period_end")
  /// Set when a renewal charge failed; the plan drops to Standard after the grace period.
  planPastDueSince          DateTime?                 @map("plan_past_due_since")
  /// What the account may owe BitoCard, in US cents: US$10 at first, raised a step at a time (25, 50, 100) after a full
  /// month's invoice is paid in full; admins may set any value up to US$100. An invoice unpaid past its due date drops it a step.
  creditLimitCents          Int                       @default(1000) @map("credit_limit_cents")
  creditLimitRaisedAt       DateTime?                 @map("credit_limit_raised_at")
  ledgerAccounts            LedgerAccount[]
  holds                     Hold[]
  earningsLots              EarningsLot[]
  payments                  Payment[]
  reservedAccounts          ReservedAccount[]
  bankAccounts              BankAccount[]
  payouts                   Payout[]
  markups                   ResellerMarkup[]
  quotes                    Quote[]
  orders                    Order[]
  events                    Event[]
  connections               ResellerConnection[]
  feeCharges                FeeCharge[]
  webhookEndpoints          WebhookEndpoint[]
  verifications             IdentityVerification[]
  kycCases                  KycCase[]
  mediaAssets               MediaAsset[]
  listings                  ResellerListing[]
  /// BitoCard's own store (bitocard.com): one house account per market sells to its retail customers, and one with no
  /// country owns the store itself. Never a real reseller.
  house                     Boolean                   @default(false)
  checkouts                 Checkout[]
  manualTopUps              ManualTopUp[]
  cryptoAddresses           CryptoAddress[]
  cryptoDeposits            CryptoDeposit[]
  cryptoWithdrawals         CryptoWithdrawal[]
  cryptoWithdrawalAddresses CryptoWithdrawalAddress[]
  @@map("resellers")
  invoices              Invoice[]
}

enum ResellerRole {
  owner
  admin
  developer
  finance
  support
}

model ResellerMember {
  resellerId String       @map("reseller_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       ResellerRole
  createdAt  DateTime     @default(now()) @map("created_at")
  reseller   Reseller     @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resellerId, userId])
  @@index([userId])
  @@map("reseller_members")
}

model Invitation {
  id          String       @id @default(uuid()) @db.Uuid
  resellerId  String       @map("reseller_id") @db.Uuid
  email       String
  role        ResellerRole
  tokenHash   String       @unique @map("token_hash") @db.Char(64)
  invitedById String       @map("invited_by_id") @db.Uuid
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  revokedAt   DateTime?    @map("revoked_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  reseller    Reseller     @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId])
  @@map("invitations")
}

enum ApiKeyMode {
  test
  live
}

/// Secret API keys for reseller systems. Only the SHA-256 hash is stored; the key is shown once at creation.
model ApiKey {
  id          String     @id @default(uuid()) @db.Uuid
  resellerId  String     @map("reseller_id") @db.Uuid
  /// The store the key belongs to: it sees only that store's orders, events and webhooks, within that store's plan.
  storeId     String     @map("store_id") @db.Uuid
  name        String
  mode        ApiKeyMode
  /// First characters of the key (for example bc_live_a1b2c3), shown so people can tell keys apart.
  prefix      String
  keyHash     String     @unique @map("key_hash") @db.Char(64)
  scopes      String[]
  createdById String     @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime?  @map("last_used_at")
  expiresAt   DateTime?  @map("expires_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  reseller    Reseller   @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id])

  @@index([resellerId])
  @@index([storeId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// M3: countries, settings chain, switches, plans and stores
// ---------------------------------------------------------------------------

/// A market BitoCard operates in. BitoCard decides what is available in each country.
model Country {
  /// ISO 3166-1 alpha-2.
  code                      String            @id @db.Char(2)
  name                      String
  /// ISO 4217, for example NGN. Resellers in this country trade in this currency.
  currency                  String            @db.Char(3)
  /// Resellers based here can sign up.
  resellerSignup            Boolean           @default(false) @map("reseller_signup")
  /// Reserved (dedicated) bank accounts for wallet funding; customer wallets exist only where this is on.
  reservedAccounts          Boolean           @default(false) @map("reserved_accounts")
  /// Markup Protection Scheme: highest markup over BitoCard's wholesale price, in percent.
  markupCapPercent          Int               @default(100) @map("markup_cap_percent")
  /// Days before a sale's profit can be withdrawn.
  payoutHoldDays            Int               @default(15) @map("payout_hold_days")
  /// Smallest withdrawal, in the currency's minor units (for example kobo).
  minWithdrawalMinor        BigInt            @map("min_withdrawal_minor")
  /// Who checks identities here: `bitocard` (BitoCard Verify, every African country) or `didit` (elsewhere).
  identityProvider          String            @default("didit") @map("identity_provider")
  /// Null disables profile phone verification in this market.
  smsProvider               String?           @map("sms_provider")
  /// Spin and win: spins each customer may take per day (UTC) in this market, 1 to 10.
  spinDailyLimit            Int               @default(2) @map("spin_daily_limit")
  /// Customer Catcher: signed-out visitors may use the public Spin and win page in this market.
  publicSpinsEnabled        Boolean           @default(false) @map("public_spins_enabled")
  /// Spins kept in a visitor claim before sign-up (1 to 10; six by default).
  publicSpinLimit           Int               @default(6) @map("public_spin_limit")
  /// The most a reseller's own exchange desk may mark up (basis points, 0 to 2,000) in this market.
  exchangeMarkupCapBps      Int               @default(500) @map("exchange_markup_cap_bps")
  /// Admins are told when BitoCard's fiat exchange reserve in this market falls below this (minor units); null: never.
  exchangeReserveAlertMinor BigInt?           @map("exchange_reserve_alert_minor")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  categories                CountryCategory[]
  options                   CountryOption[]
  paymentMethods            PaymentMethod[]
  resellers                 Reseller[]
  customers                 Customer[]
  publicSpinClaims          PublicSpinClaim[]

  @@map("countries")
}

/// Product categories sold through BitoCard. Suppliers and products attach to these in M5.
enum ProductCategory {
  gift_cards
  airtime
  data
  bills
  pay_tv
  esim
  software
  /// Fixed-term VPN access (30 days, never renewed).
  vpn
  /// Remote desktop (RDP) servers. No supplier yet.
  rdp
  virtual_numbers
  virtual_cards
  /// Money sent to a customer's mobile money wallet (cash-in), for example through pawaPay.
  mobile_money
}

/// Whether a category is sold in a country, and whether storefront customers must verify their identity to buy it.
model CountryCategory {
  countryCode          String          @map("country_code") @db.Char(2)
  category             ProductCategory
  enabled              Boolean         @default(false)
  customerVerification Boolean         @default(false) @map("customer_verification")
  /// BitoCard collects tax on this category's sales here (set after tax advice; off by default).
  taxable              Boolean         @default(false)
  country              Country         @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([countryCode, category])
  @@map("country_categories")
}

/// Settings chain, BitoCard level: the options a country allows for a setting, and its default.
model CountryOption {
  countryCode  String   @map("country_code") @db.Char(2)
  key          String
  allowed      String[]
  defaultValue String   @map("default_value")
  country      Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([countryCode, key])
  @@map("country_options")
}

/// Settings chain, reseller level: the reseller's choice among the options their country allows.
model ResellerOption {
  resellerId String   @map("reseller_id") @db.Uuid
  key        String
  value      String
  updatedAt  DateTime @updatedAt @map("updated_at")
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@id([resellerId, key])
  @@map("reseller_options")
}

/// Admin on/off switches for gated features. A reseller switch overrides the country's, which overrides the global one.
model FeatureSwitch {
  id          String    @id @default(uuid()) @db.Uuid
  key         String
  /// Exactly one scope: global (both null), a country, or a reseller.
  countryCode String?   @map("country_code") @db.Char(2)
  resellerId  String?   @map("reseller_id") @db.Uuid
  enabled     Boolean
  updatedAt   DateTime  @updatedAt @map("updated_at")
  reseller    Reseller? @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@unique([key, countryCode, resellerId])
  @@map("feature_switches")
}

/// Reseller plans: Standard (free) and Premium. The admin sets Premium's price.
model Plan {
  code               String              @id
  name               String
  /// Monthly price in US cents; converted to the reseller's currency when billed.
  priceCents         Int                 @map("price_cents")
  /// Plan features, for example chargeback_protection or international_selling.
  features           String[]
  /// API features switched off for this plan. Empty means every API feature is on (the default).
  apiRestrictions    String[]            @default([]) @map("api_restrictions")
  /// What the plan is for, shown with it (admins edit it).
  description        String?
  /// Resellers can choose it. A hidden plan keeps those already on it (they renew as before) but takes no one new.
  available          Boolean             @default(true)
  /// BitoCard's margin on usage billed as it happens (AI replies beyond the allowance, mobile money deposit fees), in
  /// basis points over its cost.
  usageMarginBps     Int                 @default(2000) @map("usage_margin_bps")
  /// Where it is listed, lowest first.
  sortOrder          Int                 @default(0) @map("sort_order")
  /// How much the plan allows (`planLimitCatalogue`): a number, or null for unlimited; a limit not set has its default.
  limits             Json                @default("{}")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  resellers          Reseller[]
  localPrices        PlanPrice[]
  storeSubscriptions StoreSubscription[]

  @@map("plans")
}

/// A plan's fixed monthly price in one currency (minor units). Without one, the US dollar price is converted when charged.
model PlanPrice {
  planCode    String   @map("plan_code")
  currency    String   @db.Char(3)
  amountMinor BigInt   @map("amount_minor")
  updatedAt   DateTime @updatedAt @map("updated_at")
  plan        Plan     @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@id([planCode, currency])
  @@map("plan_prices")
}

enum StoreStatus {
  draft
  published
  suspended
}

/// A reseller's hosted storefront on <subdomain>.bitocard.com.
model Store {
  id                    String             @id @default(uuid()) @db.Uuid
  resellerId            String             @map("reseller_id") @db.Uuid
  name                  String
  /// Lower-case, unique, for example "adadigital" in adadigital.bitocard.com.
  subdomain             String             @unique
  status                StoreStatus        @default(draft)
  /// Customer checkout on the store: `test` (sandbox: simulated payments and orders) until the reseller switches it live.
  checkoutMode          LedgerMode         @default(test) @map("checkout_mode")
  /// The customer account app's menu on desktop: `rail` or `bottom`; null follows BitoCard (the
  /// `customer_app_bottom_bar_desktop` switch). Phones and tablets always use the bottom bar.
  desktopNav            String?            @map("desktop_nav")
  /// The store's customers are asked for the identity check where the market requires it (true) or never (false).
  /// The reseller's choice for their store; BitoCard's for bitocard.com.
  customerVerification  Boolean            @default(true) @map("customer_verification")
  /// bitocard.com only: customers are asked only once this many days have passed since their first paid purchase.
  verificationGraceDays Int?               @map("verification_grace_days")
  logoUrl               String?            @map("logo_url")
  primaryColor          String             @default("#070f4c") @map("primary_color")
  accentColor           String             @default("#ff2382") @map("accent_color")
  publishedAt           DateTime?          @map("published_at")
  /// The store's template (`src/stores/templates.ts`): what it sells and the sections its editor offers.
  template              String             @default("all_in_one")
  /// The template's design variant and its colour theme.
  variant               String             @default("classic")
  theme                 String             @default("navy_pink")
  /// Single product stores: the product key they sell.
  focus                 String?
  /// Beyond the month's AI replies on BitoCard's AI: `stop` (people answer) or `pay` (each reply billed as it goes).
  aiOverage             String             @default("stop") @map("ai_overage")
  /// The home page being edited in SHQ, and the one shoppers see (null: the variant's starting page).
  homeDraft             Json?              @map("home_draft")
  homePublished         Json?              @map("home_published")
  homeVersion           Int                @default(0) @map("home_version")
  homePublishedAt       DateTime?          @map("home_published_at")
  /// The store's address on bitocard.com (its Cloudflare record and the storefront's Vercel domain): `pending` until set
  /// up (the `domains` job retries), `ready`, or `failed` (`hostError` says why).
  hostStatus            String             @default("pending") @map("host_status")
  /// The subdomain whose address is set up now (differs from `subdomain` until a rename is applied).
  hostName              String?            @map("host_name")
  /// Cloudflare's ID of the store's CNAME record.
  hostRecordId          String?            @map("host_record_id")
  hostError             String?            @map("host_error")
  hostSyncedAt          DateTime?          @map("host_synced_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  /// A plan change in progress (a 2-minute claim), so two at once never both charge.
  planChangingAt        DateTime?          @map("plan_changing_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  reseller              Reseller           @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  notifications         Notification[]
  devices               Device[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  events                Event[]
  orders                Order[]
  customers             Customer[]
  checkouts             Checkout[]
  domains               StoreDomain[]
  visitDays             StoreVisitDay[]
  homeVersions          StoreHomeVersion[]
  subscription          StoreSubscription?
  publicSpinClaims      PublicSpinClaim[]

  @@index([resellerId])
  @@index([hostStatus])
  @@map("stores")
}

/**
 * A store's paid plan. A store without one is on the free plan (Startup). Each is billed on its own from the reseller's
 * live wallet; the account's plan (`resellers.plan_code`) is the highest plan among its stores.
 */
model StoreSubscription {
  storeId            String    @id @map("store_id") @db.Uuid
  resellerId         String    @map("reseller_id") @db.Uuid
  planCode           String    @map("plan_code")
  /// When the next monthly charge is due. Null: not billed (set by BitoCard).
  renewsAt           DateTime? @map("renews_at")
  /// When the paid month began, and what was paid for it (minor units, currency): the credit on an upgrade.
  periodStartedAt    DateTime? @map("period_started_at")
  paidMinor          BigInt    @default(0) @map("paid_minor")
  paidCurrency       String?   @map("paid_currency") @db.Char(3)
  /// Ends at the next renewal instead of charging.
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  /// A cheaper plan taking over at the next renewal.
  nextPlanCode       String?   @map("next_plan_code")
  /// Set when a renewal charge failed; the store goes back to Startup after the grace period.
  pastDueSince       DateTime? @map("past_due_since")
  /// Moved from the account's plan when plans became per store: the reseller is told before its first renewal.
  migrated           Boolean   @default(false)
  transitionNoticeAt DateTime? @map("transition_notice_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planCode], references: [code])

  @@index([resellerId])
  @@index([renewsAt])
  @@map("store_subscriptions")
}

/// Who changed what in the admin app. Written for every admin change; never edited.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M4: ledger, wallets, exchange rates, payments, payouts and tax
// ---------------------------------------------------------------------------

/// Sandbox (test) and live money never mix: every ledger account, payment and payout belongs to one mode.
enum LedgerMode {
  test
  live
}

/// What a ledger account holds. Reseller accounts are what BitoCard owes the reseller; platform accounts are BitoCard's own.
enum AccountKind {
  /// Topped-up money: pays wholesale cost, never withdrawn.
  reseller_funding
  /// What a reseller owes BitoCard for usage their wallet could not pay when it happened (debit-normal: an asset of
  /// BitoCard's). Paid off by their next top-ups, oldest invoice first. Never below zero.
  reseller_owed
  /// Profit past its payout hold: pays wholesale cost and can be withdrawn.
  reseller_earnings
  /// Profit still inside the payout hold.
  reseller_earnings_held
  /// Held for orders in progress.
  reseller_reserved
  /// Withdrawals on their way to the reseller's bank.
  reseller_payouts_pending
  /// The startup allowance (USD): restricted, never cash. Pays only the wholesale cost of customer-paid orders; never
  /// withdrawn, transferred or spent directly.
  reseller_allowance
  /// What a store's customers paid at checkout, held for their orders: taken when the order is delivered (wholesale and
  /// tax to BitoCard, the rest to the reseller's earnings) or refunded to the customer.
  customer_payments
  /// What BitoCard grants as promotions such as the startup allowance (a marketing expense).
  promotions
  /// Money BitoCard holds at a payment provider (an asset).
  provider_balance
  /// Fees payment providers charge BitoCard (an expense).
  processing_fees
  platform_revenue
  /// BitoCard's fees on resellers' own-integration transactions (revenue, kept apart from platform_revenue).
  platform_fees
  /// What resellers pay BitoCard for domains (registrations and renewals), kept apart from platform_revenue.
  domain_revenue
  tax_payable
  /// Counterpart of manual admin adjustments.
  adjustments
  /// Money BitoCard has prepaid to a supplier (an asset).
  supplier_float
  /// What suppliers charge BitoCard for fulfilled orders (an expense).
  cost_of_sales
  /// Card disputes BitoCard lost and bore itself: chargeback protection, or more than the reseller's wallet held (an expense).
  chargebacks
  /// A store customer's wallet (what BitoCard owes them): topped up through BitoCard's gateways or their reserved bank
  /// account, spent only on the store's products, never withdrawn. Never below zero.
  customer_wallet
  /// BitoCard's position from converting between wallets (US dollars and a country's currency): one account per
  /// currency, posted in pairs at BitoCard's exchange rate. May go either way.
  currency_exchange
  /// A customer's crypto, one account per asset (USDT, BTC...), in the asset's base units: spendable. Never below zero.
  crypto_wallet
  /// A customer's crypto locked for the market (their sell ads) or a withdrawal on its way.
  crypto_locked
  /// A customer's crypto frozen by an admin: nobody can move it until it is unfrozen (or seized by finance).
  crypto_frozen
  /// A customer's money from P2P sales, in their country's currency: spendable on P2P and withdrawable to their bank.
  customer_withdrawable
  /// A customer's money locked behind their P2P buy ads.
  p2p_fiat_locked
  /// The crypto BitoCard holds for its customers (on chain, or credited in the sandbox): an asset.
  crypto_custody
  /// BitoCard's P2P trading fees, taken in crypto (revenue).
  crypto_fees
  /// A customer's crypto on its way out in an on-chain withdrawal (the amount plus the network fee): back to the wallet
  /// if the withdrawal fails or is cancelled, out of custody once it is confirmed on chain. Never below zero.
  crypto_withdrawing
  /// A customer's P2P money on its way to their bank account: back to `customer_withdrawable` if the transfer fails.
  customer_payouts_pending
  /// A customer's Spin and win rewards, one account per coin, in its base units: never withdrawn on chain or traded,
  /// only exchanged into their store wallet (`customer_wallet`). Never below zero.
  crypto_spin_rewards
  /// What BitoCard has granted in Spin and win rewards, in each coin (a marketing expense, debit-normal): given back
  /// when rewards are exchanged, whose cost is then booked in money to `promotions`.
  crypto_promotions
  /// An exchange desk's money reserve in one currency (BitoCard's: each market's house account): what it pays out
  /// when customers sell coins to it, and where their money goes when they buy. Never below zero.
  reserve_fiat
  /// An exchange desk's coin reserve in one asset's base units (BitoCard's: the root house account, shared by every
  /// market): what customers buy from, and where coins they sell go. Never below zero.
  reserve_crypto
  /// A reseller's own coins bought from BitoCard, before they fund their customer-facing desk.
  reseller_crypto
  /// A reseller's coins on their way out on chain (asked, confirmed, being sent), never negative.
  reseller_crypto_withdrawing
}

/// A card payment into BitoCard's own gateway disputed by the cardholder with their bank (a chargeback): one per gateway dispute.
model Chargeback {
  id                String     @id @default(uuid()) @db.Uuid
  paymentId         String     @map("payment_id") @db.Uuid
  resellerId        String     @map("reseller_id") @db.Uuid
  mode              LedgerMode
  provider          String
  providerDisputeId String     @map("provider_dispute_id")
  amountMinor       BigInt     @map("amount_minor")
  currency          String     @db.Char(3)
  /// open, won or lost.
  status            String     @default("open")
  /// The reseller's plan has chargeback protection: BitoCard bears it and nothing is held.
  protected         Boolean    @default(false)
  /// Held from the reseller's wallet while open, and what the wallet could not cover (BitoCard's loss if lost).
  holdId            String?    @map("hold_id") @db.Uuid
  heldMinor         BigInt     @default(0) @map("held_minor")
  shortfallMinor    BigInt     @default(0) @map("shortfall_minor")
  reason            String?
  openedAt          DateTime   @default(now()) @map("opened_at")
  resolvedAt        DateTime?  @map("resolved_at")
  /// Finance settled a lost dispute's shortfall with the reseller: withdrawals resume.
  clearedAt         DateTime?  @map("cleared_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  payment           Payment    @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerDisputeId])
  @@index([resellerId, mode, status])
  @@map("chargebacks")
}

/// One account per kind, mode, currency and owner. The balance is kept in step with the postings in the same transaction.
model LedgerAccount {
  id           String          @id @default(uuid()) @db.Uuid
  kind         AccountKind
  mode         LedgerMode
  /// ISO 4217 for money, or a crypto asset's code (USDT, BTC) for crypto accounts, in that asset's base units.
  currency     String          @db.VarChar(10)
  /// reseller:<id>, customer:<id>, provider:<name> or platform.
  ownerKey     String          @map("owner_key")
  resellerId   String?         @map("reseller_id") @db.Uuid
  /// A store customer's wallet.
  customerId   String?         @map("customer_id") @db.Uuid
  /// Natural balance in minor units: positive means money held (assets, expenses) or owed (reseller and liability accounts).
  balanceMinor BigInt          @default(0) @map("balance_minor")
  /// Reseller money can never go below zero; a posting that would do so fails.
  nonNegative  Boolean         @map("non_negative")
  createdAt    DateTime        @default(now()) @map("created_at")
  postings     LedgerPosting[]
  reseller     Reseller?       @relation(fields: [resellerId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])

  @@unique([kind, mode, currency, ownerKey])
  @@index([resellerId])
  @@index([customerId])
  @@map("ledger_accounts")
}

/// A balanced set of postings (debits equal credits). Never edited; corrections are new entries.
model JournalEntry {
  id          String          @id @default(uuid()) @db.Uuid
  mode        LedgerMode
  /// top_up, deposit, hold, hold_release, hold_capture, earnings, earnings_release, payout, payout_reversal, payout_fee, adjustment, plan_charge.
  type        String
  /// Unique business reference, so the same event can never be posted twice (for example payment:<id>).
  reference   String          @unique
  resellerId  String?         @map("reseller_id") @db.Uuid
  description String
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  postings    LedgerPosting[]

  @@index([resellerId, createdAt])
  @@map("journal_entries")
}

model LedgerPosting {
  id          String        @id @default(uuid()) @db.Uuid
  entryId     String        @map("entry_id") @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  /// Positive is a debit, negative a credit. Each entry's postings sum to zero.
  amountMinor BigInt        @map("amount_minor")
  entry       JournalEntry  @relation(fields: [entryId], references: [id])
  account     LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_postings")
}

enum HoldStatus {
  held
  captured
  released
}

/// Wholesale cost held from a reseller's wallet while an order is fulfilled.
model Hold {
  id                String     @id @default(uuid()) @db.Uuid
  resellerId        String     @map("reseller_id") @db.Uuid
  mode              LedgerMode
  currency          String     @db.Char(3)
  amountMinor       BigInt     @map("amount_minor")
  /// How much came from topped-up funds and how much from earnings, so a release returns it to the same place.
  fromFundingMinor  BigInt     @map("from_funding_minor")
  fromEarningsMinor BigInt     @map("from_earnings_minor")
  /// Checkout orders: held from what the customer paid (`customer_payments`) instead of the wallet.
  fromCustomerMinor BigInt     @default(0) @map("from_customer_minor")
  status            HoldStatus @default(held)
  reference         String     @unique
  createdAt         DateTime   @default(now()) @map("created_at")
  resolvedAt        DateTime?  @map("resolved_at")
  reseller          Reseller   @relation(fields: [resellerId], references: [id])

  @@index([resellerId])
  @@map("holds")
}

/// Profit from one sale, withdrawable once its payout hold ends.
model EarningsLot {
  id          String     @id @default(uuid()) @db.Uuid
  resellerId  String     @map("reseller_id") @db.Uuid
  mode        LedgerMode
  currency    String     @db.Char(3)
  amountMinor BigInt     @map("amount_minor")
  reference   String     @unique
  releaseAt   DateTime   @map("release_at")
  releasedAt  DateTime?  @map("released_at")
  /// Taken back before release (the sale was refunded); `releasedAt` is set too, so it is never released.
  reversedAt  DateTime?  @map("reversed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  reseller    Reseller   @relation(fields: [resellerId], references: [id])

  @@index([releasedAt, releaseAt])
  @@index([resellerId])
  @@map("earnings_lots")
}

/// Latest rate from each source, in units of the currency per US dollar.
model ExchangeRate {
  currency    String   @db.Char(3)
  /// open_exchange_rates or flutterwave.
  source      String
  unitsPerUsd Decimal  @map("units_per_usd") @db.Decimal(24, 10)
  fetchedAt   DateTime @map("fetched_at")

  @@id([currency, source])
  @@map("exchange_rates")
}

/// Admin settings per currency: the disclosed conversion margin, and when to pause conversions.
model CurrencySetting {
  currency      String   @id @db.Char(3)
  /// Conversion margin in basis points (150 = 1.5%).
  marginBps     Int      @default(150) @map("margin_bps")
  /// Pause conversions when the two rate sources differ by more than this, in basis points.
  divergenceBps Int      @default(300) @map("divergence_bps")
  paused        Boolean  @default(false)
  pausedReason  String?  @map("paused_reason")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("currency_settings")
}

enum PaymentPurpose {
  wallet_top_up
  reserved_account_deposit
  /// A storefront customer paying for an order at checkout.
  checkout
  /// A storefront customer topping up their wallet through a payment page.
  customer_top_up
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

/// Money coming in: checkout top-ups and deposits into reserved bank accounts. Credited once, after the provider confirms.
model Payment {
  id                      String           @id @default(uuid()) @db.Uuid
  resellerId              String           @map("reseller_id") @db.Uuid
  /// A customer's wallet top-up (a payment page or a transfer into their reserved account): credited to their wallet.
  customerId              String?          @map("customer_id") @db.Uuid
  mode                    LedgerMode
  purpose                 PaymentPurpose
  /// flutterwave, monnify or sandbox.
  provider                String
  /// Our reference sent to the provider (tx_ref).
  reference               String           @unique
  /// The provider's own transaction ID, once known. Unique, so one provider transaction is credited once.
  providerTransactionId   String?          @map("provider_transaction_id")
  amountMinor             BigInt           @map("amount_minor")
  currency                String           @db.Char(3)
  /// Charged by the gateway in another currency (Stripe in USD where the account cannot take this one): what was
  /// charged. `amountMinor`/`currency` stay what the payer owed, as booked.
  chargeAmountMinor       BigInt?          @map("charge_amount_minor")
  chargeCurrency          String?          @map("charge_currency") @db.Char(3)
  feeMinor                BigInt           @default(0) @map("fee_minor")
  status                  PaymentStatus    @default(pending)
  checkoutUrl             String?          @map("checkout_url")
  returnUrl               String?          @map("return_url")
  reservedAccountId       String?          @map("reserved_account_id") @db.Uuid
  /// Taken through a reseller's own gateway (their connection), checked with their credentials: never in BitoCard's ledger.
  connectionId            String?          @map("connection_id") @db.Uuid
  failureReason           String?          @map("failure_reason")
  createdAt               DateTime         @default(now()) @map("created_at")
  completedAt             DateTime?        @map("completed_at")
  /// Money the provider took that BitoCard cannot credit: paid after the payment was closed (`late`) or for another amount
  /// (`mismatch`). Admins are told and it is refunded in full through the same gateway.
  unmatchedReason         String?          @map("unmatched_reason")
  unmatchedAmountMinor    BigInt?          @map("unmatched_amount_minor")
  unmatchedCurrency       String?          @map("unmatched_currency") @db.Char(3)
  unmatchedTransactionId  String?          @map("unmatched_transaction_id")
  unmatchedAt             DateTime?        @map("unmatched_at")
  /// The gateway's refund of the unmatched money, once sent; attempts count refusals.
  unmatchedRefundId       String?          @map("unmatched_refund_id")
  unmatchedRefundAttempts Int              @default(0) @map("unmatched_refund_attempts")
  unmatchedRefundedAt     DateTime?        @map("unmatched_refunded_at")
  reseller                Reseller         @relation(fields: [resellerId], references: [id])
  customer                Customer?        @relation(fields: [customerId], references: [id])
  reservedAccount         ReservedAccount? @relation(fields: [reservedAccountId], references: [id])
  checkout                Checkout?
  chargebacks             Chargeback[]

  @@unique([provider, providerTransactionId])
  @@index([resellerId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([unmatchedAt, unmatchedRefundedAt])
  @@map("payments")
}

/// A bank account number dedicated to one wallet; transfers into it top the wallet up.
model ReservedAccount {
  id                String     @id @default(uuid()) @db.Uuid
  resellerId        String     @map("reseller_id") @db.Uuid
  /// A store customer's account: transfers top up their wallet (`resellerId` is the store's seller in that market).
  customerId        String?    @map("customer_id") @db.Uuid
  mode              LedgerMode
  provider          String
  currency          String     @db.Char(3)
  bankName          String     @map("bank_name")
  accountNumber     String     @map("account_number")
  accountName       String     @map("account_name")
  /// Our reference for the reservation at the provider; deposits carry it.
  providerReference String     @map("provider_reference")
  createdAt         DateTime   @default(now()) @map("created_at")
  reseller          Reseller   @relation(fields: [resellerId], references: [id])
  customer          Customer?  @relation(fields: [customerId], references: [id])
  payments          Payment[]

  @@unique([provider, accountNumber])
  @@index([resellerId])
  @@index([customerId])
  @@index([providerReference])
  @@map("reserved_accounts")
}

/// Where a reseller's withdrawals go. The account name comes from the bank, never from the reseller.
model BankAccount {
  id                     String            @id @default(uuid()) @db.Uuid
  resellerId             String            @map("reseller_id") @db.Uuid
  mode                   LedgerMode
  country                String            @db.Char(2)
  currency               String            @db.Char(3)
  bankCode               String            @map("bank_code")
  bankName               String            @map("bank_name")
  accountNumberEncrypted String            @map("account_number_encrypted")
  accountNumberLast4     String            @map("account_number_last4")
  accountName            String            @map("account_name")
  /// `mobile_money`: bank_code is pawaPay's network (for example MTN_MOMO_GHA) and the number is the owner's confirmed phone.
  kind                   PayoutAccountKind @default(bank)
  createdById            String            @map("created_by_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at")
  removedAt              DateTime?         @map("removed_at")
  /// Set when the business is renamed after verification: live payouts wait until then (a fresh 24 hours).
  payoutsFrom            DateTime?         @map("payouts_from")
  reseller               Reseller          @relation(fields: [resellerId], references: [id])
  payouts                Payout[]

  @@index([resellerId])
  @@map("bank_accounts")
}

enum PayoutAccountKind {
  bank
  mobile_money
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
}

/// A withdrawal of earnings to a bank account.
model Payout {
  id                 String       @id @default(uuid()) @db.Uuid
  resellerId         String       @map("reseller_id") @db.Uuid
  mode               LedgerMode
  bankAccountId      String       @map("bank_account_id") @db.Uuid
  amountMinor        BigInt       @map("amount_minor")
  /// Taken out of the amount withdrawn (mobile money: pawaPay's fee); what is sent is amount less fee.
  feeMinor           BigInt       @default(0) @map("fee_minor")
  currency           String       @db.Char(3)
  status             PayoutStatus @default(pending)
  reference          String       @unique
  provider           String
  providerTransferId String?      @map("provider_transfer_id")
  failureReason      String?      @map("failure_reason")
  requestedById      String       @map("requested_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  completedAt        DateTime?    @map("completed_at")
  reseller           Reseller     @relation(fields: [resellerId], references: [id])
  bankAccount        BankAccount  @relation(fields: [bankAccountId], references: [id])

  @@index([resellerId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// Tax BitoCard collects as seller of record, by the customer's country. Live sales need a rate a finance admin has confirmed.
model TaxRate {
  countryCode      String   @id @map("country_code") @db.Char(2)
  /// For example VAT.
  name             String
  /// Basis points (750 = 7.5%).
  rateBps          Int      @map("rate_bps")
  /// Customer prices include the tax (the usual consumer display in the pilot countries).
  pricesIncludeTax Boolean  @default(true) @map("prices_include_tax")
  /// Confirmed by a finance admin after tax advice. Unconfirmed rates work in the sandbox only.
  confirmed        Boolean  @default(false)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// M5: suppliers, catalogue, pricing and quotes
// ---------------------------------------------------------------------------

enum SupplierStatus {
  mvp_live
  mvp_qualify
  pilot
  later
  backup
}

/// An upstream supplier. Never shown to resellers or customers. Every supplier has an adapter; admins decide which are used.
model Supplier {
  /// Adapter code, for example reloadly or vtpass.
  code                 String            @id
  name                 String
  /// Admin-only logo (the admin app and, for suppliers resellers can connect, SHQ). Never shown to customers.
  logoUrl              String?           @map("logo_url")
  categories           ProductCategory[]
  /// Where the supplier operates, as published (free text until confirmed).
  coverage             String
  status               SupplierStatus
  /// Master switch: a disabled supplier is never routed to.
  enabled              Boolean           @default(false)
  // Funding profile: "pay per item sold" is not "no minimum deposit".
  /// prepaid_wallet, per_order or credit_terms.
  billingModel         String?           @map("billing_model")
  fundingCurrency      String?           @map("funding_currency") @db.Char(3)
  minFirstDepositMinor BigInt?           @map("min_first_deposit_minor")
  minTopUpMinor        BigInt?           @map("min_top_up_minor")
  fees                 String?
  refunds              String?
  /// Written permission to serve downstream resellers under BitoCard.
  resaleApproved       Boolean           @default(false) @map("resale_approved")
  requiresIpAllowlist  Boolean?          @map("requires_ip_allowlist")
  notes                String?
  /// Admin feature rules for the supplier's products ({ feature: required | allowed | excluded }), for adapters with
  /// gatedFeatures (DIDWW's numbers). Products breaking a rule are not synced.
  featureRules         Json              @default("{}") @map("feature_rules")
  /// bitocard.com customers buying products routed here are asked for the identity check where the market requires it (true) or not.
  customerVerification Boolean           @default(true) @map("customer_verification")
  lastSyncedAt         DateTime?         @map("last_synced_at")
  lastSyncError        String?           @map("last_sync_error")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  markets              SupplierMarket[]
  products             SupplierProduct[]
  fundingMovements     SupplierFundingMovement[]

  @@map("suppliers")
}

/// Which supplier BitoCard uses for which category in which market (the reseller's country). Configuration, not code.
model SupplierMarket {
  supplierCode String          @map("supplier_code")
  countryCode  String          @map("country_code") @db.Char(2)
  category     ProductCategory
  enabled      Boolean         @default(false)
  supplier     Supplier        @relation(fields: [supplierCode], references: [code], onDelete: Cascade)

  @@id([supplierCode, countryCode, category])
  @@map("supplier_markets")
}

enum DenominationType {
  fixed
  range
}

/// A BitoCard product. Equivalent supplier products map to one product, so routing between suppliers is invisible.
model Product {
  id                 String            @id @default(uuid()) @db.Uuid
  /// category:country:brand:variant, for example airtime:NG:mtn:topup.
  key                String            @unique
  category           ProductCategory
  /// Where the product is used: the card region, or the network or biller country.
  country            String            @db.Char(2)
  brand              String
  name               String
  faceCurrency       String            @map("face_currency") @db.Char(3)
  denominationType   DenominationType  @map("denomination_type")
  /// Fixed face values in minor units.
  fixedValues        BigInt[]          @default([]) @map("fixed_values")
  minValueMinor      BigInt?           @map("min_value_minor")
  maxValueMinor      BigInt?           @map("max_value_minor")
  /// What the customer must give: phone, smartcard, meter, or none.
  recipientType      String            @default("none") @map("recipient_type")
  description        String?
  redeemInstructions String?           @map("redeem_instructions")
  /// From the supplier's catalogue (refreshed on every sync).
  logoUrl            String?           @map("logo_url")
  /// What the product can do (`src/catalogue/features.ts`), for example sms_in or app_codes on a virtual number.
  features           String[]          @default([])
  /// Listed on BitoCard's own store (bitocard.com) by an admin. Unlisted products are never shown there; resellers'
  /// catalogues and stores are not affected (they keep their own listings).
  listed             Boolean           @default(false)
  listedAt           DateTime?         @map("listed_at")
  /// Set by an admin (an uploaded image or an https address); shown instead of the supplier's logo. Never synced over.
  imageUrl           String?           @map("image_url")
  /// Admin switch; inactive products are hidden and cannot be quoted.
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  supplierProducts   SupplierProduct[]
  resellerOffers     ResellerOffer[]
  quotes             Quote[]
  orders             Order[]
  /// Resellers listing it on their hosted storefront.
  listings           ResellerListing[]

  @@index([category, country])
  @@index([listed])
  @@map("products")
}

/// A product a reseller lists on their hosted storefront (SHQ Catalogue > List). Their API catalogue is not gated by it:
/// a reseller's own systems can sell anything in their catalogue; the listing only decides what their BitoCard-hosted
/// store shows.
model ResellerListing {
  resellerId String   @map("reseller_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([resellerId, productId])
  @@index([productId])
  @@map("reseller_listings")
}

/// A supplier offer for a product, and what it costs BitoCard.
model SupplierProduct {
  id           String      @id @default(uuid()) @db.Uuid
  supplierCode String      @map("supplier_code")
  productId    String      @map("product_id") @db.Uuid
  /// The supplier identifier, for example a product ID or service:variation.
  sku          String
  costCurrency String      @map("cost_currency") @db.Char(3)
  /// Cost per unit of face value, in cost currency (for example 0.97 USD per 1 USD of face value), from the supplier catalogue.
  costRatio    Decimal     @map("cost_ratio") @db.Decimal(24, 10)
  /// Fixed fee per item, minor units of the cost currency.
  costFeeMinor BigInt      @default(0) @map("cost_fee_minor")
  /// Commission agreed with the supplier and not in its catalogue (basis points off the cost). Kept across syncs.
  discountBps  Int         @default(0) @map("discount_bps")
  /// What the adapter needs to order it (for example the operator ID).
  meta         Json?
  available    Boolean     @default(true)
  /// Lower wins when costs are equal.
  priority     Int         @default(100)
  syncedAt     DateTime    @map("synced_at")
  supplier     Supplier    @relation(fields: [supplierCode], references: [code])
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// BitoCard's own stock (supplier `stock`): the codes held for this offer.
  stockCodes   StockCode[]

  @@unique([supplierCode, sku])
  @@index([productId])
  @@map("supplier_products")
}

enum StockCodeStatus {
  available
  sold
  withdrawn
}

/// One code (licence key or gift card) in BitoCard's own stock, held for a `stock` supplier offer. Codes are secrets:
/// encrypted, never shown to admins (only the last four characters), handed over once to the order that claims them.
model StockCode {
  id             String          @id @default(uuid()) @db.Uuid
  /// Order added: codes are handed out first in, first out.
  seq            BigInt          @unique @default(autoincrement())
  offerId        String          @map("offer_id") @db.Uuid
  codeEncrypted  String          @map("code_encrypted")
  pinEncrypted   String?         @map("pin_encrypted")
  /// HMAC-SHA256 of the code keyed with ENCRYPTION_KEY, so the same code is never stocked twice.
  codeHash       String          @unique @map("code_hash")
  /// The code's last four characters, so admins can tell codes apart.
  hint           String
  status         StockCodeStatus @default(available)
  /// The order attempt that claimed it (the order's supplier reference).
  orderReference String?         @map("order_reference")
  addedById      String?         @map("added_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  soldAt         DateTime?       @map("sold_at")
  withdrawnAt    DateTime?       @map("withdrawn_at")
  offer          SupplierProduct @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId, status, seq])
  @@index([orderReference])
  @@map("stock_codes")
}

/// BitoCard pricing. The most specific rule wins: product, then category in a market, then category, then the default.
/// BitoCard's pricing: the most specific rule for an offer (product, then supplier, then category, then country) decides
/// how it sells. `discount`: the customer pays face value and the reseller gets `resellerDiscountBps` of it off (never
/// more than the supplier's discount to BitoCard). `markup`: `marginBps` on supplier cost. `fixed`: the wholesale price
/// itself (`fixedMinor` in `fixedCurrency`), for single-value products. `auto` (the default): discount where the supplier
/// gives one (cost below face value), else markup, each with this rule's value. Unique per scope (nulls not distinct).
model PricingRule {
  id                  String           @id @default(uuid()) @db.Uuid
  category            ProductCategory?
  /// The reseller country (market).
  countryCode         String?          @map("country_code") @db.Char(2)
  supplierCode        String?          @map("supplier_code")
  productId           String?          @map("product_id") @db.Uuid
  /// auto, discount, markup or fixed.
  kind                String           @default("auto")
  /// Markup: BitoCard's markup on supplier cost (up to 200%).
  marginBps           Int              @map("margin_bps")
  /// Discount: what the reseller gets off face value.
  resellerDiscountBps Int              @default(0) @map("reseller_discount_bps")
  fixedMinor          BigInt?          @map("fixed_minor")
  fixedCurrency       String?          @map("fixed_currency") @db.Char(3)
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("pricing_rules")
}

/// A reseller's pricing: general (no category), per category, or per product (the most specific wins, field by field).
/// On discount products, `customerDiscountBps` of face value goes to their customers (never more than their own
/// discount). On markup products, `markupBps` over BitoCard's price (capped by the country's Markup Protection Scheme),
/// or a fixed customer price per product (`fixedMinor`, in the reseller's currency).
model ResellerMarkup {
  id                  String           @id @default(uuid()) @db.Uuid
  resellerId          String           @map("reseller_id") @db.Uuid
  category            ProductCategory?
  productId           String?          @map("product_id") @db.Uuid
  markupBps           Int?             @map("markup_bps")
  customerDiscountBps Int?             @map("customer_discount_bps")
  fixedMinor          BigInt?          @map("fixed_minor")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  reseller            Reseller         @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@map("reseller_markups")
}

enum QuoteStatus {
  open
  used
}

/// A locked price for one purchase. The supplier and its cost are internal and never returned to the reseller.
model Quote {
  id                  String      @id @default(uuid()) @db.Uuid
  resellerId          String      @map("reseller_id") @db.Uuid
  mode                LedgerMode
  productId           String      @map("product_id") @db.Uuid
  quantity            Int
  faceValueMinor      BigInt      @map("face_value_minor")
  faceCurrency        String      @map("face_currency") @db.Char(3)
  /// The reseller currency; every amount below is in it, for the whole quantity.
  currency            String      @db.Char(3)
  wholesaleMinor      BigInt      @map("wholesale_minor")
  /// What the customer pays, tax included.
  priceMinor          BigInt      @map("price_minor")
  taxMinor            BigInt      @map("tax_minor")
  taxName             String?     @map("tax_name")
  taxRateBps          Int?        @map("tax_rate_bps")
  resellerProfitMinor BigInt      @map("reseller_profit_minor")
  supplierCode        String      @map("supplier_code")
  supplierProductId   String      @map("supplier_product_id") @db.Uuid
  /// Total supplier cost in the supplier currency.
  supplierCostMinor   BigInt      @map("supplier_cost_minor")
  supplierCurrency    String      @map("supplier_currency") @db.Char(3)
  /// Reseller currency per unit of supplier currency, when they differ.
  fxRate              Decimal?    @map("fx_rate") @db.Decimal(24, 10)
  /// Phone, smartcard or meter number, and what the supplier returned when validating it.
  recipient           Json?
  customerReference   String?     @map("customer_reference")
  /// `bitocard`, or `own`: the reseller's own supplier (supplierProductId is then a reseller offer).
  source              String      @default("bitocard")
  connectionId        String?     @map("connection_id") @db.Uuid
  /// Own supplier: BitoCard's fee, locked with the price (rule, rate, base, minimum, and the most it can be).
  feeRuleId           String?     @map("fee_rule_id") @db.Uuid
  feeRatePpb          Int?        @map("fee_rate_ppb")
  feeBaseMinor        BigInt?     @map("fee_base_minor")
  feeMinMinor         BigInt?     @map("fee_min_minor")
  feeMaxMinor         BigInt?     @map("fee_max_minor")
  status              QuoteStatus @default(open)
  expiresAt           DateTime    @map("expires_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  reseller            Reseller    @relation(fields: [resellerId], references: [id])
  product             Product     @relation(fields: [productId], references: [id])

  @@index([resellerId, createdAt])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// M6: orders, fulfilment, exceptions, receipts and refunds
// ---------------------------------------------------------------------------

enum OrderStatus {
  /**
   * Sent to the supplier, outcome not yet confirmed.
   */
  processing
  completed
  failed
  refunded
}

/// A purchase from a quote. The wholesale cost and tax are held from the wallet until the supplier confirms the outcome.
model Order {
  id                        String           @id @default(uuid()) @db.Uuid
  resellerId                String           @map("reseller_id") @db.Uuid
  /// The store it was sold through: the API key's store, or the store its customer bought from.
  storeId                   String?          @map("store_id") @db.Uuid
  mode                      LedgerMode
  quoteId                   String           @unique @map("quote_id") @db.Uuid
  productId                 String           @map("product_id") @db.Uuid
  quantity                  Int
  faceValueMinor            BigInt           @map("face_value_minor")
  faceCurrency              String           @map("face_currency") @db.Char(3)
  currency                  String           @db.Char(3)
  wholesaleMinor            BigInt           @map("wholesale_minor")
  taxMinor                  BigInt           @map("tax_minor")
  priceMinor                BigInt           @map("price_minor")
  resellerProfitMinor       BigInt           @map("reseller_profit_minor")
  recipient                 Json?
  customerReference         String?          @map("customer_reference")
  status                    OrderStatus      @default(processing)
  /// In the admin exception queue: the supplier has not confirmed the outcome after repeated checks.
  needsReview               Boolean          @default(false) @map("needs_review")
  holdId                    String?          @map("hold_id") @db.Uuid
  /// The supplier handling the current attempt (internal).
  supplierCode              String           @map("supplier_code")
  supplierProductId         String           @map("supplier_product_id") @db.Uuid
  supplierCostMinor         BigInt           @map("supplier_cost_minor")
  /// What the supplier said it charged (Reloadly `balanceInfo.cost`, VTpass `total_amount`), and whether that differs from the expected cost.
  supplierReportedCostMinor BigInt?          @map("supplier_reported_cost_minor")
  costMismatch              Boolean          @default(false) @map("cost_mismatch")
  supplierCurrency          String           @map("supplier_currency") @db.Char(3)
  /// Our reference for the current attempt, sent to the supplier so a status check can find it.
  supplierReference         String           @unique @map("supplier_reference")
  supplierTransactionId     String?          @map("supplier_transaction_id")
  /// `bitocard`, or `own`: fulfilled through the reseller's own supplier account (BitoCard charges only its fee).
  source                    String           @default("bitocard")
  connectionId              String?          @map("connection_id") @db.Uuid
  feeChargeId               String?          @map("fee_charge_id") @db.Uuid
  /// Own supplier: BitoCard's fee taken from the wallet: the most it can be while processing, then what was charged.
  feeMinor                  BigInt?          @map("fee_minor")
  /// Sandbox only: the outcome to simulate.
  simulate                  String?
  checks                    Int              @default(0)
  nextCheckAt               DateTime?        @map("next_check_at")
  failureReason             String?          @map("failure_reason")
  /// Sequential receipt number, given when the order completes.
  receiptNumber             Int?             @unique @map("receipt_number")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  completedAt               DateTime?        @map("completed_at")
  /// When the codes or licence keys were emailed to the customer (`recipient.email`); retried until sent.
  deliveryEmailedAt         DateTime?        @map("delivery_emailed_at")
  /// A storefront customer's order (checkout); they see it in their account.
  customerId                String?          @map("customer_id") @db.Uuid
  customer                  Customer?        @relation(fields: [customerId], references: [id])
  reseller                  Reseller         @relation(fields: [resellerId], references: [id])
  store                     Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product                   Product          @relation(fields: [productId], references: [id])
  deliveries                OrderDelivery[]
  access                    OrderAccess?
  virtualNumber             VirtualNumber?
  esims                     Esim[]
  vpnSubscription           VpnSubscription?
  attempts                  OrderAttempt[]

  @@index([storeId])
  @@index([resellerId, createdAt])
  @@index([status, nextCheckAt])
  @@index([productId, completedAt])
  @@map("orders")
}

/// What the customer receives: gift card codes, licence keys, electricity tokens, eSIM activation strings, VPN
/// credentials and confirmations. Every code, PIN and password is encrypted.
model OrderDelivery {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  /// gift_card, licence_key, token, confirmation, virtual_number, esim or vpn_account.
  kind            String
  codeEncrypted   String?          @map("code_encrypted")
  pinEncrypted    String?          @map("pin_encrypted")
  serial          String?
  details         Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vpnSubscription VpnSubscription?

  @@index([orderId])
  @@map("order_deliveries")
}

/// A fixed-term VPN account issued for one order. The password is never stored here: it is encrypted on the related
/// `vpn_account` order delivery, which can be created before the supplier call so an uncertain retry uses the same value.
model VpnSubscription {
  id                       String        @id @default(uuid()) @db.Uuid
  orderId                  String        @unique @map("order_id") @db.Uuid
  deliveryId               String        @unique @map("delivery_id") @db.Uuid
  resellerId               String        @map("reseller_id") @db.Uuid
  mode                     LedgerMode
  productId                String        @map("product_id") @db.Uuid
  supplierCode             String        @map("supplier_code")
  /// Null while credentials are prepared but the supplier has not confirmed account creation.
  supplierAccountId        String?       @map("supplier_account_id")
  /// provisioning, active, expired (disabled at the end of its term), revoked (disabled after a refund), suspended
  /// (disabled by an admin), failed (never provisioned) or needs_review (the supplier disagrees and an admin must look).
  status                   String        @default("provisioning")
  supplierStatus           String?       @map("supplier_status")
  startsAt                 DateTime?     @map("starts_at")
  expiresAt                DateTime?     @map("expires_at")
  disabledAt               DateTime?     @map("disabled_at")
  lastSyncedAt             DateTime?     @map("last_synced_at")
  nextSyncAt               DateTime?     @map("next_sync_at")
  credentialVersion        Int           @default(1) @map("credential_version")
  /// A new password sent to the supplier but not yet confirmed (encrypted): the same one is sent again until it is.
  pendingPasswordEncrypted String?       @map("pending_password_encrypted")
  passwordChangedAt        DateTime?     @map("password_changed_at")
  /// Consecutive failed supplier checks, and the last one's reason (internal).
  syncFailures             Int           @default(0) @map("sync_failures")
  lastError                String?       @map("last_error")
  /// When admins were last told about this account (needs review, drift), so they are told once per problem.
  alertedAt                DateTime?     @map("alerted_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delivery                 OrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([supplierCode, supplierAccountId])
  @@index([status, nextSyncAt])
  @@index([resellerId, mode, createdAt])
  @@map("vpn_subscriptions")
}

/// A daily check of BitoCard's VPN supplier account: its credit, the accounts it bills (Active) against those BitoCard
/// expects to be active, and the credit used since the last check (internal; admins only).
model VpnReconciliation {
  id             String   @id @default(uuid()) @db.Uuid
  supplierCode   String   @map("supplier_code")
  /// The supplier's credit in US cents, and how much less it is than at the previous check (null after a top-up).
  balanceCents   Int?     @map("balance_cents")
  spentCents     Int?     @map("spent_cents")
  /// Accounts the supplier bills, accounts BitoCard expects active, and the days the credit lasts at that rate.
  supplierActive Int      @map("supplier_active")
  expectedActive Int      @map("expected_active")
  runwayDays     Float?   @map("runway_days")
  /// Active at the supplier but not active here (usernames and IDs only), and active here but not at the supplier.
  unexpected     Json     @default("[]")
  missing        Json     @default("[]")
  /// Every page of accounts was read (false: the list was too long or a page failed, so nothing was concluded).
  complete       Boolean
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([supplierCode, createdAt])
  @@map("vpn_reconciliations")
}

/// The order's page link (`/a/<token>` on the store's address): permanent, but the reseller can replace it, which ends
/// the old one and every access pass. The link only points at the order: the page shows it only to the customer who
/// proves it is theirs (signed in at the store, or an emailed code). Looked up by the token's hash; the token is also
/// kept encrypted so the API can show the link again.
model OrderAccess {
  orderId        String            @id @map("order_id") @db.Uuid
  tokenHash      String            @unique @map("token_hash")
  tokenEncrypted String            @map("token_encrypted")
  /// When codes or keys were first shown on the page (Reveal), and how many times since.
  revealedAt     DateTime?         @map("revealed_at")
  reveals        Int               @default(0)
  /// When the customer was last emailed that their codes were revealed (at most once a day).
  alertedAt      DateTime?         @map("alerted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  replacedAt     DateTime?         @map("replaced_at")
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  codes          OrderAccessCode[]

  @@map("order_access")
}

/// A virtual number sold through an order: its supplier's ID for it (internal), when it is paid up to, renewal and
/// reminder state, and its SMS. Numbers stay with their supplier for life.
model VirtualNumber {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @unique @map("order_id") @db.Uuid
  resellerId       String          @map("reseller_id") @db.Uuid
  mode             LedgerMode
  productId        String          @map("product_id") @db.Uuid
  supplierCode     String          @map("supplier_code")
  /// The supplier's ID for the number (DIDWW's DID ID). Internal: never shown to resellers or customers.
  supplierNumberId String          @map("supplier_number_id")
  /// E.164, for example +442071234567.
  number           String
  /// The supplier's monthly cost, in `costCurrency` minor units: what renewals are priced from.
  monthlyCostMinor BigInt          @map("monthly_cost_minor")
  costCurrency     String          @map("cost_currency") @db.Char(3)
  /// active; expired (paused: in the 15-day grace, renewable); deleted (released, gone for good).
  status           String          @default("active")
  /// Paid up to: renewing adds a month.
  expiresAt        DateTime        @map("expires_at")
  /// Renew from the reseller's wallet 3 days before expiry: off until the customer (on the order page) or the reseller switches it on.
  autoRenew        Boolean         @default(false) @map("auto_renew")
  /// The reseller lets the customer send SMS from the order page (charged to the reseller's wallet).
  customerSending  Boolean         @default(false) @map("customer_sending")
  renewedAt        DateTime?       @map("renewed_at")
  /// Reminders for the current period: 7 days before expiry, on expiry, the delete warning 7 days after.
  remindedAt       DateTime?       @map("reminded_at")
  expiredAt        DateTime?       @map("expired_at")
  warnedAt         DateTime?       @map("warned_at")
  deletedAt        DateTime?       @map("deleted_at")
  /// Why the last automatic renewal did not happen (for example the wallet was short), and when it was tried.
  renewalError     String?         @map("renewal_error")
  renewalAttemptAt DateTime?       @map("renewal_attempt_at")
  /// A renewal the supplier left unclear (a timeout): its period (the hold's reference) and the renewals-left count asked
  /// for, so it is asked again exactly as before (never a second month) while the hold stays. Cleared once settled.
  renewalPending   String?         @map("renewal_pending")
  renewalCycles    Int?            @map("renewal_cycles")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages         NumberMessage[]

  @@unique([supplierCode, supplierNumberId])
  @@index([number, status])
  @@index([status, expiresAt])
  @@index([resellerId, mode, createdAt])
  @@map("virtual_numbers")
}

/// An SMS to or from a virtual number. The text is encrypted at rest; messages are kept 90 days.
model NumberMessage {
  id                String        @id @default(uuid()) @db.Uuid
  numberId          String        @map("number_id") @db.Uuid
  /// in or out.
  direction         String
  /// The other party's number (E.164 without +, as the supplier gives it).
  counterparty      String
  textEncrypted     String        @map("text_encrypted")
  /// received (in); queued, sent, delivered or failed (out).
  status            String
  /// The supplier's message ID: incoming ones are stored once however often they are delivered.
  supplierMessageId String?       @map("supplier_message_id")
  /// Outgoing: SMS parts sent, what the supplier charged (cost currency), and the hold and charge on the wallet.
  parts             Int           @default(1)
  costMinor         BigInt?       @map("cost_minor")
  chargedMinor      BigInt?       @map("charged_minor")
  holdId            String?       @map("hold_id") @db.Uuid
  failureReason     String?       @map("failure_reason")
  /// customer (from the order page) or reseller (API or SHQ).
  sentBy            String?       @map("sent_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  number            VirtualNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([direction, supplierMessageId])
  @@index([numberId, createdAt])
  @@index([createdAt])
  @@map("number_messages")
}

/// A 6-digit code emailed to the order's customer (`recipient.email`) to open its page: hashed, single use, 10 minutes,
/// 5 tries. Sends are limited (one a minute, ten a day per order).
model OrderAccessCode {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  codeHash   String      @map("code_hash")
  attempts   Int         @default(0)
  expiresAt  DateTime    @map("expires_at")
  consumedAt DateTime?   @map("consumed_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  access     OrderAccess @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_access_codes")
}

/// Each call to a supplier for an order and what came back (internal, for admins tracing an order).
model OrderAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  supplierCode String   @map("supplier_code")
  reference    String
  /// place or check.
  action       String
  /// completed, failed or pending.
  outcome      String
  detail       String?
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_attempts")
}

// -- Events and webhooks ------------------------------------------------------------------------------------------

enum WebhookEndpointStatus {
  enabled
  disabled
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
}

/// Something that happened to a reseller's objects. Written in the same transaction as the change it describes (the
/// outbox), then delivered to the reseller's webhook endpoints and listed by GET /v1/events. Kept for 30 days.
model Event {
  id           String            @id @default(uuid()) @db.Uuid
  /// Commit-ordered position, for GET /v1/events?since=.
  seq          BigInt            @unique @default(autoincrement())
  resellerId   String            @map("reseller_id") @db.Uuid
  /// The store the event is about; null for the account's own (wallet, payouts, checks), sent to every store.
  storeId      String?           @map("store_id") @db.Uuid
  mode         LedgerMode
  type         String
  /// The exact JSON body sent to endpoints, so every retry carries the same bytes.
  payload      String
  /// Test events go to this one endpoint only and are not listed.
  endpointId   String?           @map("endpoint_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  /// Set once the event has been fanned out to the endpoints that want it.
  dispatchedAt DateTime?         @map("dispatched_at")
  reseller     Reseller          @relation(fields: [resellerId], references: [id])
  store        Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([resellerId, mode, seq])
  @@index([createdAt])
  @@map("events")
}

/// A reseller's HTTPS address that receives signed events.
model WebhookEndpoint {
  id                      String                @id @default(uuid()) @db.Uuid
  resellerId              String                @map("reseller_id") @db.Uuid
  /// The store whose events it receives (and the account's own).
  storeId                 String                @map("store_id") @db.Uuid
  mode                    LedgerMode
  url                     String
  description             String?
  /// Event types to send; empty means every type.
  events                  String[]              @default([])
  status                  WebhookEndpointStatus @default(enabled)
  /// Why it was disabled: by_reseller, or failing (3 days of failed deliveries).
  disabledReason          String?               @map("disabled_reason")
  disabledAt              DateTime?             @map("disabled_at")
  secretEncrypted         String                @map("secret_encrypted")
  /// After a rotation the old secret also signs, until it expires.
  previousSecretEncrypted String?               @map("previous_secret_encrypted")
  previousSecretExpiresAt DateTime?             @map("previous_secret_expires_at")
  /// Start of the current run of failed deliveries; cleared by any success.
  failingSince            DateTime?             @map("failing_since")
  /// One delivery worker per endpoint at a time holds this lease.
  leaseUntil              DateTime?             @map("lease_until")
  createdAt               DateTime              @default(now()) @map("created_at")
  reseller                Reseller              @relation(fields: [resellerId], references: [id])
  store                   Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries              WebhookDelivery[]

  @@index([resellerId, mode])
  @@index([storeId, mode])
  @@map("webhook_endpoints")
}

/// One event for one endpoint: retried until it succeeds or 3 days have passed.
model WebhookDelivery {
  id                 String                @id @default(uuid()) @db.Uuid
  eventId            String                @map("event_id") @db.Uuid
  endpointId         String                @map("endpoint_id") @db.Uuid
  status             WebhookDeliveryStatus @default(pending)
  attempts           Int                   @default(0)
  nextAttemptAt      DateTime?             @map("next_attempt_at")
  lastAttemptAt      DateTime?             @map("last_attempt_at")
  lastResponseStatus Int?                  @map("last_response_status")
  lastError          String?               @map("last_error")
  createdAt          DateTime              @default(now()) @map("created_at")
  event              Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint           WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  log                WebhookAttempt[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// Every delivery attempt, for the reseller's delivery log.
model WebhookAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  deliveryId     String          @map("delivery_id") @db.Uuid
  /// Sent from the dashboard (resend or test) rather than by the schedule.
  manual         Boolean         @default(false)
  success        Boolean
  responseStatus Int?            @map("response_status")
  /// The start of the response body, for troubleshooting.
  responseBody   String?         @map("response_body")
  error          String?
  durationMs     Int             @map("duration_ms")
  createdAt      DateTime        @default(now()) @map("created_at")
  delivery       WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("webhook_attempts")
}

// -- Identity checks ----------------------------------------------------------------------------------------------

enum VerificationSubject {
  reseller
  customer
}

/// document: ID document and face check (Didit); bvn: Nigerian Bank Verification Number with consent (Flutterwave).
enum VerificationMethod {
  document
  bvn
}

enum VerificationStatus {
  in_progress
  approved
  declined
  in_review
  expired
}

/// One identity check. Keeps only the outcome and the verified name: never document images, ID numbers or the BVN.
model IdentityVerification {
  id                String              @id @default(uuid()) @db.Uuid
  subject           VerificationSubject
  resellerId        String              @map("reseller_id") @db.Uuid
  mode              LedgerMode
  /// The reseller's own reference for the customer (customer checks only).
  customerReference String?             @map("customer_reference")
  method            VerificationMethod
  /// didit, flutterwave or sandbox.
  provider          String
  /// The provider's session or consent reference.
  providerReference String              @map("provider_reference")
  status            VerificationStatus  @default(in_progress)
  /// Where the person completes the check (provider-hosted).
  url               String?
  country           String              @db.Char(2)
  /// When the person agreed to the check (biometric and BVN data need explicit consent).
  consentAt         DateTime            @map("consent_at")
  expectedName      String?             @map("expected_name")
  /// A reseller owner's BVN, encrypted, kept only until their reserved accounts are opened (the bank needs it), then erased;
  /// erased at once if the check fails or expires.
  secretEncrypted   String?             @map("secret_encrypted")
  verifiedName      String?             @map("verified_name")
  documentCountry   String?             @map("document_country") @db.Char(2)
  /// Why it was declined or sent for review (shown to admins; a short code to resellers).
  reason            String?
  requestedById     String?             @map("requested_by_id") @db.Uuid
  decidedById       String?             @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at")
  lastCheckedAt     DateTime?           @map("last_checked_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  reseller          Reseller            @relation(fields: [resellerId], references: [id])
  kycCase           KycCase?

  @@unique([provider, providerReference])
  @@index([resellerId, subject, mode, customerReference, createdAt])
  @@index([status, createdAt])
  @@map("identity_verifications")
}

/// Service credentials and settings an admin sets in the admin app (Settings > Integrations) instead of the environment.
/// `key` is the environment variable name it replaces; an admin value wins over the environment. Secrets are encrypted
/// with ENCRYPTION_KEY and never returned by the API.
model IntegrationSetting {
  key         String   @id
  value       String
  encrypted   Boolean
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}

enum SupplierWebhookStatus {
  /// Stored, not yet processed (or waiting for its next try).
  received
  /// The order it names was checked with the supplier.
  processed
  /// No order matches its reference (yet): retried a few times, then kept for admins.
  unmatched
  /// Processing kept failing: kept for admins; the order's own scheduled checks continue regardless.
  failed
}

/// Every notification a supplier sends (Reloadly first), stored before it is acknowledged so none is lost. The body is
/// never trusted: it only says which order to re-check with the supplier. Retries of the same delivery are stored once.
model SupplierWebhook {
  id                    String                @id @default(uuid()) @db.Uuid
  supplierCode          String                @map("supplier_code")
  eventType             String?               @map("event_type")
  /// SHA-256 of the raw body: a supplier's retry of the same delivery is recognised and stored once.
  bodyHash              String                @map("body_hash")
  /// The raw body, encrypted with ENCRYPTION_KEY (it may carry customer details); never returned by the API.
  bodyEncrypted         String                @map("body_encrypted")
  /// Our order reference the notification names (Reloadly's customIdentifier), and the supplier's transaction ID.
  reference             String?
  supplierTransactionId String?               @map("supplier_transaction_id")
  /// Set when it came to a reseller's own connection's address (signed with their own secret): it can only name
  /// that reseller's own orders. Null for BitoCard's own supplier accounts.
  connectionId          String?               @map("connection_id") @db.Uuid
  orderId               String?               @map("order_id") @db.Uuid
  status                SupplierWebhookStatus @default(received)
  attempts              Int                   @default(0)
  lastError             String?               @map("last_error")
  nextAttemptAt         DateTime              @default(now()) @map("next_attempt_at")
  receivedAt            DateTime              @default(now()) @map("received_at")
  processedAt           DateTime?             @map("processed_at")

  @@unique([supplierCode, bodyHash])
  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@index([connectionId, receivedAt])
  @@map("supplier_webhooks")
}

// ---------------------------------------------------------------------------
// Notifications inbox (every role, both realms)
// ---------------------------------------------------------------------------

enum NotificationSeverity {
  info
  success
  warning
  critical
}

/// Who a notification, device or push preference belongs to. Admins and reseller staff are users; customers are
/// hosted-storefront customers (accounts scoped to one store and owned by its reseller, built with hosted checkout).
enum NotificationAudience {
  admin
  reseller
  customer
}

/// One in-app notification for one recipient (fanned out to everyone whose role should see it when it is created, so
/// read state is per recipient). Exactly one of `userId` (admins and reseller staff) or `customerId` (storefront
/// customers, with their store) is set, checked by the database. Reseller notifications name their reseller account;
/// personal ones (security notices) and admin ones do not. Kept 90 days.
model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  audience   NotificationAudience
  userId     String?              @map("user_id") @db.Uuid
  /// A storefront customer. Its foreign key is added with the customers table.
  customerId String?              @map("customer_id") @db.Uuid
  resellerId String?              @map("reseller_id") @db.Uuid
  /// Customers: the store whose name, address and brand the notification uses.
  storeId    String?              @map("store_id") @db.Uuid
  /// From `notificationTypes` (src/notifications/inbox.ts).
  type       String
  severity   NotificationSeverity @default(info)
  title      String
  body       String
  /// A path in the recipient's app (SHQ, admin, or the customer's store), for example `/orders/<id>`.
  link       String?
  /// Sandbox notifications are labelled; null when the mode does not apply.
  mode       LedgerMode?
  /// The same thing is notified to a recipient once (jobs may run twice): `<type>:<subject id>`.
  dedupeKey  String               @map("dedupe_key")
  readAt     DateTime?            @map("read_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store      Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pushes     PushDelivery[]

  @@unique([userId, dedupeKey])
  @@unique([customerId, dedupeKey])
  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Device push (Web Push to signed-in browsers)
// ---------------------------------------------------------------------------

enum DeviceChannel {
  /// A browser's Web Push subscription (VAPID, RFC 8030/8291). Native app channels can be added later.
  web_push
}

/// One signed-in browser or device that receives push notifications, with its own ID. Belongs to a user (admins,
/// reseller staff) or a storefront customer (on that store's address), exactly one, checked by the database. Tied to
/// the session that registered it: once that session ends (sign-out, expiry, password change), the device is dropped
/// at the next push.
model Device {
  id            String               @id @default(uuid()) @db.Uuid
  audience      NotificationAudience
  userId        String?              @map("user_id") @db.Uuid
  customerId    String?              @map("customer_id") @db.Uuid
  /// Customers: the store whose address the browser subscribed on.
  storeId       String?              @map("store_id") @db.Uuid
  /// The staff session (`sessions`) or, for customers, their storefront session.
  sessionId     String               @map("session_id") @db.Uuid
  channel       DeviceChannel        @default(web_push)
  /// The push service address (unique per browser subscription).
  endpoint      String               @unique
  /// The subscription's p256dh and auth keys, encrypted with ENCRYPTION_KEY.
  keysEncrypted String               @map("keys_encrypted")
  /// For people to recognise it, for example "Chrome on Windows".
  label         String
  failures      Int                  @default(0)
  lastPushedAt  DateTime?            @map("last_pushed_at")
  lastSeenAt    DateTime             @default(now()) @map("last_seen_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store         Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pushes        PushDelivery[]

  @@index([userId])
  @@index([customerId])
  @@map("devices")
}

enum PushDeliveryStatus {
  pending
  sent
  failed
}

/// One notification pushed to one device: at most once (unique), retried briefly, then given up (push is ephemeral).
model PushDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @map("notification_id") @db.Uuid
  deviceId       String             @map("device_id") @db.Uuid
  status         PushDeliveryStatus @default(pending)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now()) @map("next_attempt_at")
  lastError      String?            @map("last_error")
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device         Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

/// A recipient's choice to push (or not) one notification type to their devices (a user or a customer, exactly one).
/// Without a row, the type's default applies. Urgent and security types are always pushed.
model NotificationPreference {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  type       String
  push       Boolean
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([customerId, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// BitoCard's own storefront (bitocard.com): brands and the admin-managed home page layout
// ---------------------------------------------------------------------------

/// How a brand is presented on the storefront and found by search. `slug` is the brand as products name it
/// (`Product.brand`, for example "amazon-us" or "mtn"); without a row, the storefront shows the products' own name.
/// Never names BitoCard's suppliers.
model Brand {
  slug        String   @id
  /// Shown to customers, for example "Amazon".
  name        String
  /// The company behind it when it differs, for example "Apple Inc." or "MultiChoice"; searchable.
  company     String?
  description String?
  /// Square logo, and the card art used on product cards (HTTPS addresses).
  logoUrl     String?  @map("logo_url")
  imageUrl    String?  @map("image_url")
  /// Card background when there is no art, for example "#0b0b0f".
  color       String?
  /// Storefront filters, for example gaming, entertainment, shopping, travel.
  tags        String[] @default([])
  /// Other names people search for, for example "psn", "playstation network".
  aliases     String[] @default([])
  /// Shown first where the storefront lists brands, and used when there are no sales yet to rank.
  featured    Boolean  @default(false)
  /// Lower comes first among featured brands.
  sortOrder   Int      @default(100) @map("sort_order")
  /// Hidden from the storefront (its products too) while false.
  visible     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("brands")
}

/// A storefront page laid out by admins (the home page first): a draft they edit and the published version visitors
/// see. Sections are validated JSON (`src/storefront/layout.ts`). Unpublished means the site shows its coming-soon page.
model StorefrontPage {
  key           String                  @id
  draft         Json
  published     Json?
  /// The published version number; each publish adds a version row.
  version       Int                     @default(0)
  publishedAt   DateTime?               @map("published_at")
  publishedById String?                 @map("published_by_id") @db.Uuid
  updatedById   String?                 @map("updated_by_id") @db.Uuid
  updatedAt     DateTime                @updatedAt @map("updated_at")
  versions      StorefrontPageVersion[]

  @@map("storefront_pages")
}

/// Every published version of a storefront page, so an earlier one can be restored.
model StorefrontPageVersion {
  pageKey       String         @map("page_key")
  version       Int
  sections      Json
  publishedAt   DateTime       @default(now()) @map("published_at")
  publishedById String?        @map("published_by_id") @db.Uuid
  page          StorefrontPage @relation(fields: [pageKey], references: [key], onDelete: Cascade)

  @@id([pageKey, version])
  @@map("storefront_page_versions")
}

/// How a category is shown on storefronts: its icon and banner image (uploaded by admins). Labels stay in code.
model CategoryPresentation {
  category    ProductCategory @id
  iconUrl     String?         @map("icon_url")
  imageUrl    String?         @map("image_url")
  updatedById String?         @map("updated_by_id") @db.Uuid
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("category_presentations")
}

enum MediaStatus {
  /// A signed upload link was issued; the file is not checked yet.
  pending
  /// Uploaded and checked: a real image of the declared type and size.
  ready
}

/**
 * A file in object storage (DigitalOcean Spaces), uploaded by a browser with a signed link. Platform files (brands,
 * products, suppliers, categories, storefront images) have no reseller; a reseller's files sit in their own folder.
 * Entities keep the public address (`logoUrl` and the like); this row is the library and the record of who uploaded it.
 */
model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  /// The object key: <root>/platform/brands/<slug>/logos/<id>.png or <root>/resellers/<id>/store/logos/<id>.png.
  key          String      @unique
  /// The folder the key is in, for browsing (the key without the file name).
  folder       String
  url          String
  /// What it is for, for example brand_logo or store_logo (`src/media/purposes.ts`).
  purpose      String
  /// The brand slug, product key, supplier code or category it was uploaded for, when there is one.
  targetId     String?     @map("target_id")
  /// Null for platform files.
  resellerId   String?     @map("reseller_id") @db.Uuid
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  filename     String
  contentType  String      @map("content_type")
  sizeBytes    Int         @map("size_bytes")
  width        Int?
  height       Int?
  status       MediaStatus @default(pending)
  /// The signed upload link stops working at this time; unfinished uploads are removed after it.
  expiresAt    DateTime    @map("expires_at")
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  reseller     Reseller?   @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId, status, createdAt])
  @@index([folder, status])
  @@index([status, expiresAt])
  @@map("media_assets")
}

/**
 * A person's other confirmed email addresses. The primary one stays `users.email` (sign-in and notices); another becomes
 * primary only by swapping with it, so the primary can never be removed. An address belongs to one person per realm:
 * each table is unique on (realm, email) and the API checks both before adding or signing up.
 */
model UserEmail {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  realm      Realm
  /// Stored lower-case.
  email      String
  verifiedAt DateTime @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([realm, email])
  @@index([userId])
  @@map("user_emails")
}

/// Every confirmed reseller sign-in number, including the primary copied to users.phone for session presentation.
model UserPhone {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  realm      Realm
  phone      String
  verifiedAt DateTime @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([realm, phone])
  @@index([userId])
  @@map("user_phones")
}

/**
 * Logos and card art an admin uploaded for a brand registry entry (Storefront > Brand registry), keyed by the entry's
 * slug, so one upload covers every product brand slug the entry lists. Between a brand's own settings and the
 * registry file's defaults.
 */
model BrandAsset {
  slug        String   @id
  logoUrl     String?  @map("logo_url")
  cardUrl     String?  @map("card_url")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("brand_assets")
}

// ---------------------------------------------------------------------------
// M10b: payment methods, storefront customers and checkout
// ---------------------------------------------------------------------------

enum PaymentMethodPurpose {
  /// Resellers topping up their wallet.
  wallet_top_up
  /// Storefront customers paying for an order.
  checkout
}

/// A payment gateway an admin offers in a country, for wallet top-ups or customer checkout (Settings > Markets).
/// It is offered only while it is also set up for live payments (credentials set, not switched to its sandbox).
model PaymentMethod {
  countryCode String               @map("country_code") @db.Char(2)
  purpose     PaymentMethodPurpose
  /// stripe, flutterwave, monnify or pawapay.
  gateway     String
  enabled     Boolean              @default(true)
  /// Lower first; the first offered is the default.
  position    Int                  @default(0)
  updatedAt   DateTime             @updatedAt @map("updated_at")
  country     Country              @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([countryCode, purpose, gateway])
  @@map("payment_methods")
}

/// A storefront customer: an account at one store only (the same email can be a customer at any other store).
model Customer {
  id                        String                    @id @default(uuid()) @db.Uuid
  storeId                   String                    @map("store_id") @db.Uuid
  /// Stored lower-case.
  email                     String
  name                      String
  /// Argon2id.
  passwordHash              String                    @map("password_hash")
  emailVerifiedAt           DateTime?                 @map("email_verified_at")
  phone                     String?
  phoneVerifiedAt           DateTime?                 @map("phone_verified_at")
  status                    UserStatus                @default(active)
  failedSignIns             Int                       @default(0) @map("failed_sign_ins")
  lockedUntil               DateTime?                 @map("locked_until")
  lastSignInAt              DateTime?                 @map("last_sign_in_at")
  /// Asked for the identity check where it applies (true) or not: set by the store's owner. Never means checked.
  identityCheck             Boolean                   @default(true) @map("identity_check")
  /// The customer's country, chosen at sign-up (a reseller's store: the reseller's) and then fixed: their wallet,
  /// checkouts and prices are in its currency. Null only for accounts from before it was asked, until they choose.
  country                   String?                   @db.Char(2)
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  store                     Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  market                    Country?                  @relation(fields: [country], references: [code], onDelete: Restrict)
  sessions                  CustomerSession[]
  codes                     CustomerCode[]
  checkouts                 Checkout[]
  orders                    Order[]
  notifications             Notification[]
  devices                   Device[]
  preferences               NotificationPreference[]
  ledgerAccounts            LedgerAccount[]
  payments                  Payment[]
  reservedAccounts          ReservedAccount[]
  /// An admin froze the customer's crypto account: no ads, trades or withdrawals until unfrozen.
  cryptoFrozenAt            DateTime?                 @map("crypto_frozen_at")
  cryptoFrozenReason        String?                   @map("crypto_frozen_reason")
  p2pProfile                P2pProfile?
  cryptoFreezes             CryptoFreeze[]
  p2pAds                    P2pAd[]
  p2pBuys                   P2pTrade[]                @relation("p2p_buyer")
  p2pSales                  P2pTrade[]                @relation("p2p_seller")
  cryptoAddresses           CryptoAddress[]
  cryptoDeposits            CryptoDeposit[]
  cryptoWithdrawalAddresses CryptoWithdrawalAddress[]
  cryptoWithdrawals         CryptoWithdrawal[]
  bankAccounts              CustomerBankAccount[]
  payouts                   CustomerPayout[]
  spinAllowances            SpinAllowance[]
  spins                     Spin[]
  spinExchanges             SpinExchange[]
  publicSpinClaim           PublicSpinClaim?
  manualTopUps              ManualTopUp[]
  exchangeQuotes            ExchangeQuote[]
  exchangeTrades            ExchangeTrade[]

  @@unique([storeId, email])
  @@unique([storeId, phone])
  @@map("customers")
}

/// A customer's sign-in. The store's server keeps the token in its own cookie; only its hash is stored here.
model CustomerSession {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

enum CustomerCodePurpose {
  email_verification
  phone_verification
  password_reset
}

/// Single-use 6-digit codes emailed to customers. Only a hash is stored.
model CustomerCode {
  id         String              @id @default(uuid()) @db.Uuid
  customerId String              @map("customer_id") @db.Uuid
  purpose    CustomerCodePurpose
  codeHash   String              @map("code_hash") @db.Char(64)
  target     String?
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@map("customer_codes")
}

enum CheckoutStatus {
  /// The customer has the payment page and has not paid yet.
  awaiting_payment
  /// Paid; the order is being fulfilled.
  paid
  completed
  /// Not paid (refused or abandoned): nothing to refund.
  failed
  /// The order failed after payment; the refund to the customer's payment method is being sent.
  refund_pending
  refunded
}

/// A storefront customer buying one quoted product: the payment, then the order placed once it is paid.
model Checkout {
  id                String         @id @default(uuid()) @db.Uuid
  storeId           String         @map("store_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  /// The account selling: the store's reseller, or BitoCard's house account for the market.
  resellerId        String         @map("reseller_id") @db.Uuid
  mode              LedgerMode
  quoteId           String         @unique @map("quote_id") @db.Uuid
  paymentId         String?        @unique @map("payment_id") @db.Uuid
  orderId           String?        @unique @map("order_id") @db.Uuid
  gateway           String
  status            CheckoutStatus @default(awaiting_payment)
  /// What the customer pays, tax included.
  amountMinor       BigInt         @map("amount_minor")
  currency          String         @db.Char(3)
  /// Paid from the customer's wallet in another currency (their US dollar wallet): what left it, converted at
  /// BitoCard's rate. Refunds go back there exactly.
  walletCurrency    String?        @map("wallet_currency") @db.Char(3)
  walletAmountMinor BigInt?        @map("wallet_amount_minor")
  /// The provider's ID for the refund, once sent.
  refundReference   String?        @map("refund_reference")
  refundAttempts    Int            @default(0) @map("refund_attempts")
  /// Paid into the reseller's own payment gateway (their connection): BitoCard never holds the money, the order's cost
  /// comes from the reseller's wallet, and BitoCard's `gateway_payment` fee is charged (`feeChargeId`).
  connectionId      String?        @map("connection_id") @db.Uuid
  feeChargeId       String?        @map("fee_charge_id") @db.Uuid
  /// Why it was refunded: `undelivered` (the order failed) or `admin` (a delivered order refunded by finance).
  refundKind        String?        @map("refund_kind")
  refundedAt        DateTime?      @map("refunded_at")
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  store             Store          @relation(fields: [storeId], references: [id])
  customer          Customer       @relation(fields: [customerId], references: [id])
  reseller          Reseller       @relation(fields: [resellerId], references: [id])
  payment           Payment?       @relation(fields: [paymentId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, updatedAt])
  @@map("checkouts")
}

/// A dispute: a store customer's complaint about an order or payment (raised on the store, or logged by the reseller for
/// their own systems' customers), a reseller's own dispute with BitoCard, or a chargeback. The reseller investigates
/// customer disputes and chargebacks first, then resolves them or escalates them to BitoCard with a report and a
/// recommendation; a reseller's own disputes, and those at BitoCard's own store, go to BitoCard at once. Only BitoCard
/// executes what moves money (refunds, wallet credits, chargeback decisions).
model Dispute {
  id                     String           @id @default(uuid()) @db.Uuid
  /// Shown to people as D-000123.
  number                 Int              @unique @default(autoincrement())
  resellerId             String           @map("reseller_id") @db.Uuid
  mode                   LedgerMode
  /// customer, reseller or chargeback.
  kind                   String
  /// order, payment, funding, trade or other.
  topic                  String
  /// open (with the reseller), escalated (with BitoCard), contested (BitoCard is contesting a chargeback), resolved.
  status                 String           @default("open")
  subject                String
  storeId                String?          @map("store_id") @db.Uuid
  customerId             String?          @map("customer_id") @db.Uuid
  /// The reseller's own reference for a customer on their own systems.
  customerReference      String?          @map("customer_reference")
  orderId                String?          @map("order_id") @db.Uuid
  paymentId              String?          @map("payment_id") @db.Uuid
  checkoutId             String?          @map("checkout_id") @db.Uuid
  chargebackId           String?          @unique @map("chargeback_id") @db.Uuid
  currency               String           @db.Char(3)
  /// What the reseller recommends when escalating: refund_customer, credit_reseller, reject, contest_chargeback or accept_chargeback.
  recommendation         String?
  recommendedAmountMinor BigInt?          @map("recommended_amount_minor")
  report                 String?
  escalatedAt            DateTime?        @map("escalated_at")
  /// What was done: resolved_by_reseller, refunded_customer, credited_reseller, rejected, chargeback_won or chargeback_lost.
  outcome                String?
  outcomeAmountMinor     BigInt?          @map("outcome_amount_minor")
  outcomeNote            String?          @map("outcome_note")
  resolvedAt             DateTime?        @map("resolved_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  messages               DisputeMessage[]

  @@index([resellerId, mode, status])
  @@index([status, escalatedAt])
  @@index([customerId, createdAt])
  @@map("disputes")
}

/// One message on a dispute.
model DisputeMessage {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  /// customer, reseller, bitocard or system.
  author     String
  authorId   String?  @map("author_id") @db.Uuid
  authorName String?  @map("author_name")
  /// all: everyone on the dispute, the customer too; staff: the reseller and BitoCard only.
  visibility String   @default("all")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

/// An eSIM an order delivered, kept after its order for its status, data use, expiry, top-ups and cancelling. It stays
/// with the supplier that issued it. Its activation code is only on the order's delivery (encrypted); never here.
model Esim {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  resellerId      String      @map("reseller_id") @db.Uuid
  mode            LedgerMode
  productId       String      @map("product_id") @db.Uuid
  supplierCode    String      @map("supplier_code")
  /// The supplier's own ID for the eSIM (eSIM Access's esimTranNo: ICCIDs are reused). Internal: never shown.
  supplierEsimId  String      @map("supplier_esim_id")
  iccid           String
  /// ready (not installed yet), installed, active, used_up, expired, cancelled, revoked or suspended.
  status          String      @default("ready")
  /// The supplier's own states as last reported (internal, for admins).
  supplierStatus  String?     @map("supplier_status")
  profileStatus   String?     @map("profile_status")
  dataTotalBytes  BigInt?     @map("data_total_bytes")
  dataUsedBytes   BigInt?     @map("data_used_bytes")
  usageUpdatedAt  DateTime?   @map("usage_updated_at")
  expiresAt       DateTime?   @map("expires_at")
  /// The supplier takes top-ups for it (and whether they extend by days: day passes).
  topUps          String      @default("none") @map("top_ups")
  installedAt     DateTime?   @map("installed_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  /// The last low-data threshold (percent left) and expiry warning the customer was told about, so each is sent once.
  lowDataNotified Int?        @map("low_data_notified")
  expiryNotified  DateTime?   @map("expiry_notified")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  topUpOrders     EsimTopUp[]

  @@unique([supplierCode, supplierEsimId])
  @@index([orderId])
  @@index([resellerId, mode, createdAt])
  @@map("esims")
}

/// More data (or days) added to an eSIM: paid by the reseller's wallet, or by the store's customer from their wallet
/// (`customer_id`), held while the supplier adds it, taken once it confirms, returned if it refuses.
model EsimTopUp {
  id                String     @id @default(uuid()) @db.Uuid
  esimId            String     @map("esim_id") @db.Uuid
  resellerId        String     @map("reseller_id") @db.Uuid
  customerId        String?    @map("customer_id") @db.Uuid
  mode              LedgerMode
  /// Our reference, sent to the supplier as its transaction ID (a repeat is the same top-up).
  reference         String     @unique
  /// The supplier's package (internal) and what it adds.
  supplierPackage   String     @map("supplier_package")
  name              String
  days              Int?
  costMinor         BigInt     @map("cost_minor")
  costCurrency      String     @map("cost_currency") @db.Char(3)
  /// BitoCard's price to the reseller, and (paid by a customer) the customer's price, in `currency`.
  wholesaleMinor    BigInt     @map("wholesale_minor")
  priceMinor        BigInt     @map("price_minor")
  currency          String     @db.Char(3)
  /// A customer who paid from their US dollar wallet: what left it.
  walletCurrency    String?    @map("wallet_currency") @db.Char(3)
  walletAmountMinor BigInt?    @map("wallet_amount_minor")
  holdId            String?    @map("hold_id") @db.Uuid
  /// pending (with the supplier), completed, failed.
  status            String     @default("pending")
  failureReason     String?    @map("failure_reason")
  attempts          Int        @default(0)
  nextCheckAt       DateTime?  @map("next_check_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  completedAt       DateTime?  @map("completed_at")
  esim              Esim       @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId, createdAt])
  @@index([status, nextCheckAt])
  @@map("esim_top_ups")
}

// ---------------------------------------------------------------------------
// Crypto wallets and P2P trading
// ---------------------------------------------------------------------------

/// A crypto asset BitoCard's wallets hold. Balances are kept in the ledger in base units of `decimals` places
/// (6 for the stablecoins, 8 for BTC, ETH and BNB: ETH's 18 would overflow a bigint).
model CryptoAsset {
  code                 String   @id @db.VarChar(10)
  name                 String
  decimals             Int
  /// Customers can hold and trade it.
  enabled              Boolean  @default(false)
  /// BitoCard's P2P fee in basis points, taken in the asset from what the buyer receives.
  p2pFeeBps            Int      @default(20) @map("p2p_fee_bps")
  sortOrder            Int      @default(0) @map("sort_order")
  /// The most one customer can withdraw on chain in 24 hours (asset units, decimal string).
  withdrawalDailyLimit String   @default("0") @map("withdrawal_daily_limit")
  /// Withdrawals from this amount (asset units, decimal string) wait for an admin's approval.
  withdrawalReviewFrom String   @default("0") @map("withdrawal_review_from")
  /// The most one taker may exchange of this coin in 24 hours (coin units, as text); null: no daily limit.
  exchangeDailyLimit   String?  @map("exchange_daily_limit")
  /// Admins are told when BitoCard's coin reserve falls below this (coin units, as text); null: never.
  exchangeReserveAlert String?  @map("exchange_reserve_alert")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("crypto_assets")
}

/// An amount of a customer's crypto frozen by an admin (moved to `crypto_frozen`), until released or seized.
model CryptoFreeze {
  id          String     @id @default(uuid()) @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  mode        LedgerMode
  asset       String     @db.VarChar(10)
  amount      BigInt
  reason      String
  /// frozen, released or seized.
  status      String     @default("frozen")
  frozenBy    String?    @map("frozen_by") @db.Uuid
  resolvedBy  String?    @map("resolved_by") @db.Uuid
  resolveNote String?    @map("resolve_note")
  createdAt   DateTime   @default(now()) @map("created_at")
  resolvedAt  DateTime?  @map("resolved_at")
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@map("crypto_freezes")
}

/// A customer's name on the P2P market: a nickname chosen once, never their name, email or store.
model P2pProfile {
  customerId  String   @id @map("customer_id") @db.Uuid
  nickname    String
  /// Lower-case, for uniqueness.
  nicknameKey String   @unique @map("nickname_key")
  /// The customer chose it (a generated one can be changed once).
  chosen      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("p2p_profiles")
}

/// An ad on the P2P market (one order book per mode, country and asset). A sell ad locks its crypto when posted; a
/// buy ad locks the fiat it needs. Partial fills take from `remaining`.
model P2pAd {
  id               String     @id @default(uuid()) @db.Uuid
  mode             LedgerMode
  customerId       String     @map("customer_id") @db.Uuid
  country          String     @db.Char(2)
  /// The market's fiat currency.
  currency         String     @db.Char(3)
  asset            String     @db.VarChar(10)
  /// sell (the owner sells crypto) or buy.
  side             String
  /// Fiat minor units per whole unit of the asset (NGN 1,650.00 per USDT = 165000).
  priceMinor       BigInt     @map("price_minor")
  /// Crypto base units.
  totalAmount      BigInt     @map("total_amount")
  remainingAmount  BigInt     @map("remaining_amount")
  filledAmount     BigInt     @default(0) @map("filled_amount")
  /// Fiat limits per order.
  minFiatMinor     BigInt     @map("min_fiat_minor")
  maxFiatMinor     BigInt     @map("max_fiat_minor")
  /// Buy ads: fiat still locked, and how much of it came from P2P proceeds (spent first) rather than the wallet.
  fiatLockedMinor  BigInt     @default(0) @map("fiat_locked_minor")
  fiatFromProceeds BigInt     @default(0) @map("fiat_from_proceeds")
  terms            String?
  /// active, paused, completed or cancelled.
  status           String     @default("active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  trades           P2pTrade[]

  @@index([mode, country, asset, side, status, priceMinor])
  @@index([customerId, status])
  @@map("p2p_ads")
}

/// One trade against an ad. Instant trades settle both legs in the transaction that creates them.
model P2pTrade {
  id               String     @id @default(uuid()) @db.Uuid
  /// Shown as P2P-000123.
  number           Int        @unique @default(autoincrement())
  mode             LedgerMode
  adId             String     @map("ad_id") @db.Uuid
  buyerId          String     @map("buyer_id") @db.Uuid
  sellerId         String     @map("seller_id") @db.Uuid
  /// The customer who took the ad (the other is the ad's owner).
  takerId          String     @map("taker_id") @db.Uuid
  country          String     @db.Char(2)
  currency         String     @db.Char(3)
  asset            String     @db.VarChar(10)
  priceMinor       BigInt     @map("price_minor")
  /// Crypto the seller gave, the fee BitoCard took from it and what the buyer received.
  amount           BigInt
  feeAmount        BigInt     @map("fee_amount")
  fiatMinor        BigInt     @map("fiat_minor")
  /// Where the buyer's fiat came from: P2P proceeds first, then the wallet (top-ups).
  fiatFromProceeds BigInt     @default(0) @map("fiat_from_proceeds")
  fiatFromWallet   BigInt     @default(0) @map("fiat_from_wallet")
  /// instant (BitoCard wallet) for now; classic (paid off platform) later.
  settlement       String     @default("instant")
  status           String     @default("completed")
  createdAt        DateTime   @default(now()) @map("created_at")
  completedAt      DateTime?  @map("completed_at")
  ad               P2pAd      @relation(fields: [adId], references: [id], onDelete: Restrict)
  buyer            Customer   @relation("p2p_buyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller           Customer   @relation("p2p_seller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([adId])
  @@map("p2p_trades")
}

/// Where an asset moves on chain: USDT on TRON, BNB on BNB Chain. `decimals` is the token's own (USDT on BNB Chain has
/// 18); amounts are cut down to the asset's ledger places when credited. Contracts are matched exactly, never by symbol.
model CryptoNetwork {
  id                 String   @id @default(uuid()) @db.Uuid
  asset              String   @db.VarChar(10)
  /// ETHEREUM, BSC, TRON, SOLANA or BITCOIN.
  chain              String
  /// The token contract (mainnet), or null for the chain's own coin.
  contract           String?
  /// The same token on the chain's testnet (sandbox stores), or null.
  testContract       String?  @map("test_contract")
  decimals           Int
  /// Blocks after the one holding a deposit before it is credited.
  confirmations      Int
  depositsEnabled    Boolean  @default(false) @map("deposits_enabled")
  /// Deposits at or above this (asset units, decimal string) are confirmed by two different providers first.
  doubleCheckFrom    String   @default("1000") @map("double_check_from")
  withdrawalsEnabled Boolean  @default(false) @map("withdrawals_enabled")
  /// BitoCard's network fee per withdrawal (asset units, decimal string), taken on top of the amount sent.
  withdrawalFee      String   @default("0") @map("withdrawal_fee")
  /// The smallest amount a customer can send (asset units, decimal string).
  minWithdrawal      String   @default("0") @map("min_withdrawal")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([asset, chain])
  @@map("crypto_networks")
}

/// An address a customer saved to withdraw crypto to: usable 24 hours after it is added, screened against sanctions lists.
model CryptoWithdrawalAddress {
  id          String             @id @default(uuid()) @db.Uuid
  /// A store customer's or a reseller's saved address (exactly one).
  customerId  String?            @map("customer_id") @db.Uuid
  resellerId  String?            @map("reseller_id") @db.Uuid
  mode        LedgerMode
  chain       String
  address     String
  label       String
  /// Withdrawals to it can start from then (24 hours after it was added).
  usableFrom  DateTime           @map("usable_from")
  /// clear, flagged or unscreened (no screening provider answered), with who answered and when.
  screening   String             @default("unscreened")
  screenedBy  String?            @map("screened_by")
  screenedAt  DateTime?          @map("screened_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reseller    Reseller?          @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  withdrawals CryptoWithdrawal[]

  @@unique([customerId, mode, chain, address])
  @@unique([resellerId, mode, chain, address])
  @@map("crypto_withdrawal_addresses")
}

/// One asset's daily custody check: what the ledger says BitoCard holds for customers (`crypto_custody`, less withdrawals
/// sent but not yet settled, plus deposits seen but not yet credited) against what the signer's wallets hold on chain.
model CryptoReconciliation {
  id         String     @id @default(uuid()) @db.Uuid
  mode       LedgerMode
  asset      String     @db.VarChar(10)
  /// Ledger units: what the ledger expects on chain, and what the signer reported.
  expected   BigInt
  held       BigInt
  /// held - expected: below zero is a shortfall (admins are told); above, a surplus (fees not yet swept, for example).
  difference BigInt
  /// matched, surplus, shortfall or unavailable (the signer could not be asked).
  status     String
  /// The parts behind `expected` and `held` (per chain), and any error.
  detail     Json
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([mode, asset, createdAt])
  @@map("crypto_reconciliations")
}

/// A store customer's bank account for their P2P money: in their verified name (live), usable 24 hours after it is added.
model CustomerBankAccount {
  id                     String           @id @default(uuid()) @db.Uuid
  customerId             String           @map("customer_id") @db.Uuid
  mode                   LedgerMode
  country                String           @db.Char(2)
  currency               String           @db.Char(3)
  bankCode               String           @map("bank_code")
  bankName               String           @map("bank_name")
  accountNumberEncrypted String           @map("account_number_encrypted")
  accountNumberLast4     String           @map("account_number_last4")
  accountName            String           @map("account_name")
  payoutsFrom            DateTime         @map("payouts_from")
  createdAt              DateTime         @default(now()) @map("created_at")
  removedAt              DateTime?        @map("removed_at")
  customer               Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payouts                CustomerPayout[]

  @@index([customerId, mode])
  @@map("customer_bank_accounts")
}

/// A store customer's withdrawal of P2P money to their bank account (`customer_withdrawable` to the bank, through BitoCard's
/// transfer provider): set aside in `customer_payouts_pending` first, returned only if the transfer definitely failed.
model CustomerPayout {
  id                 String              @id @default(uuid()) @db.Uuid
  customerId         String              @map("customer_id") @db.Uuid
  mode               LedgerMode
  bankAccountId      String              @map("bank_account_id") @db.Uuid
  amountMinor        BigInt              @map("amount_minor")
  currency           String              @db.Char(3)
  status             PayoutStatus        @default(pending)
  reference          String              @unique
  provider           String
  providerTransferId String?             @map("provider_transfer_id")
  failureReason      String?             @map("failure_reason")
  /// Its outcome stayed unclear: admins were told.
  needsReviewAt      DateTime?           @map("needs_review_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  completedAt        DateTime?           @map("completed_at")
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankAccount        CustomerBankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([customerId, createdAt])
  @@index([status])
  @@map("customer_payouts")
}

/// A customer's on-chain withdrawal. Its amount plus BitoCard's network fee is moved to `crypto_withdrawing` when it is
/// asked for; it is confirmed with an emailed code, may wait for an admin, is sent by BitoCard's signer (never by the
/// API, which holds no keys) and is settled once the transfer is confirmed on chain, or returned if it definitely failed.
/// A finance admin's manual top-up of a reseller's or a store customer's wallet. Nothing moves until the admin who asked
/// enters the 6-digit code emailed to their own address (10 minutes, 5 attempts, a resend a minute); then one ledger
/// entry (`manual_top_up:<id>`) credits the wallet from the provider balance (`received`: money BitoCard received outside
/// its gateways, such as a bank transfer) or from `adjustments` (`goodwill`: BitoCard's expense).
model ManualTopUp {
  id                String     @id @default(uuid()) @db.Uuid
  /// Shown as MT-000123.
  number            Int        @unique @default(autoincrement())
  mode              LedgerMode
  /// Exactly one of the two (database check).
  resellerId        String?    @map("reseller_id") @db.Uuid
  customerId        String?    @map("customer_id") @db.Uuid
  currency          String     @db.Char(3)
  amountMinor       BigInt     @map("amount_minor")
  /// received or goodwill.
  source            String
  /// The bank transfer or payment reference for received money.
  externalReference String?    @map("external_reference")
  reason            String
  /// awaiting_code, completed or cancelled (an unconfirmed one past its code's expiry is shown as expired).
  status            String     @default("awaiting_code")
  /// The admin who asked: only they receive and enter the code.
  requestedBy       String     @map("requested_by") @db.Uuid
  cancelledBy       String?    @map("cancelled_by") @db.Uuid
  codeHash          String?    @map("code_hash")
  codeExpiresAt     DateTime?  @map("code_expires_at")
  codeAttempts      Int        @default(0) @map("code_attempts")
  codeSentAt        DateTime?  @map("code_sent_at")
  /// Codes sent for this request (capped, so resends cannot give unlimited guesses).
  codeSends         Int        @default(1) @map("code_sends")
  entryId           String?    @map("entry_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  completedAt       DateTime?  @map("completed_at")
  reseller          Reseller?  @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  customer          Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([resellerId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("manual_top_ups")
}

/// An exchange desk's markup on the live market price of one coin in one currency, per mode (`desk` is `bitocard`;
/// resellers' desks later). Its price is the coin's US dollar market price x the currency's mid rate x (1 + buy markup)
/// when the customer buys, x (1 - sell markup) when they sell. Off until enabled.
model ExchangeMarkup {
  id            String     @id @default(uuid()) @db.Uuid
  desk          String     @default("bitocard")
  mode          LedgerMode
  asset         String     @db.VarChar(10)
  currency      String     @db.Char(3)
  buyMarkupBps  Int        @default(150) @map("buy_markup_bps")
  sellMarkupBps Int        @default(150) @map("sell_markup_bps")
  /// Per-trade limits in the currency's minor units (no maximum when null).
  minFiatMinor  BigInt     @default(0) @map("min_fiat_minor")
  maxFiatMinor  BigInt?    @map("max_fiat_minor")
  enabled       Boolean    @default(false)
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([desk, mode, asset, currency])
  @@map("exchange_markups")
}

/// A price held for 30 seconds for one customer: used once, by the trade it quotes.
model ExchangeQuote {
  id          String     @id @default(uuid()) @db.Uuid
  desk        String     @default("bitocard")
  mode        LedgerMode
  customerId  String     @map("customer_id") @db.Uuid
  /// buy (the customer buys coins) or sell.
  side        String
  asset       String     @db.VarChar(10)
  currency    String     @db.Char(3)
  /// Base units of the coin, and fiat minor units.
  amount      BigInt
  fiatMinor   BigInt     @map("fiat_minor")
  /// Fiat minor units per whole coin, after the markup.
  priceMinor  BigInt     @map("price_minor")
  /// The market price it was built on (US dollars x 1e8), when CoinGecko updated it, the mid rate and the markup.
  marketUsdE8 BigInt     @map("market_usd_e8")
  marketAt    DateTime?  @map("market_at")
  fxMid       Decimal    @map("fx_mid") @db.Decimal(24, 10)
  markupBps   Int        @map("markup_bps")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("exchange_quotes")
}

/// An instant trade with an exchange desk, settled in one ledger entry (`exchange_trade:<id>`). Shown as EX-000123.
model ExchangeTrade {
  id           String     @id @default(uuid()) @db.Uuid
  number       Int        @unique @default(autoincrement())
  quoteId      String     @unique @map("quote_id") @db.Uuid
  desk         String     @default("bitocard")
  mode         LedgerMode
  customerId   String     @map("customer_id") @db.Uuid
  side         String
  asset        String     @db.VarChar(10)
  currency     String     @db.Char(3)
  amount       BigInt
  fiatMinor    BigInt     @map("fiat_minor")
  priceMinor   BigInt     @map("price_minor")
  marketUsdE8  BigInt     @map("market_usd_e8")
  fxMid        Decimal    @map("fx_mid") @db.Decimal(24, 10)
  markupBps    Int        @map("markup_bps")
  /// The desk's margin in fiat minor units: what the trade made over the market price (never negative).
  markupMinor  BigInt     @map("markup_minor")
  /// Buying: how much came from P2P money and from the store wallet.
  fromProceeds BigInt     @default(0) @map("from_proceeds")
  fromWallet   BigInt     @default(0) @map("from_wallet")
  createdAt    DateTime   @default(now()) @map("created_at")
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([mode, createdAt])
  @@map("exchange_trades")
}

/// A reseller's held price to trade its own fiat and coin reserve directly with BitoCard.
model ExchangeDesk {
  resellerId         String   @id @map("reseller_id") @db.Uuid
  fallbackToBitocard Boolean  @default(true) @map("fallback_to_bitocard")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("exchange_desks")
}

/// A reseller's held price to trade its own fiat and coin reserve directly with BitoCard.
model ResellerDeskQuote {
  id          String     @id @default(uuid()) @db.Uuid
  resellerId  String     @map("reseller_id") @db.Uuid
  mode        LedgerMode
  side        String
  asset       String     @db.VarChar(10)
  currency    String     @db.Char(3)
  amount      BigInt
  fiatMinor   BigInt     @map("fiat_minor")
  priceMinor  BigInt     @map("price_minor")
  marketUsdE8 BigInt     @map("market_usd_e8")
  fxMid       Decimal    @map("fx_mid") @db.Decimal(24, 10)
  markupBps   Int        @map("markup_bps")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([resellerId, mode, createdAt])
  @@map("reseller_desk_quotes")
}

/// The reseller-to-BitoCard trade: one quote, one balanced ledger entry, no customer account involved.
model ResellerDeskTrade {
  id          String     @id @default(uuid()) @db.Uuid
  number      Int        @unique @default(autoincrement())
  quoteId     String     @unique @map("quote_id") @db.Uuid
  resellerId  String     @map("reseller_id") @db.Uuid
  mode        LedgerMode
  side        String
  asset       String     @db.VarChar(10)
  currency    String     @db.Char(3)
  amount      BigInt
  fiatMinor   BigInt     @map("fiat_minor")
  priceMinor  BigInt     @map("price_minor")
  markupMinor BigInt     @map("markup_minor")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([resellerId, mode, createdAt])
  @@map("reseller_desk_trades")
}

/// A finance admin funding or drawing down one of BitoCard's exchange reserves. Nothing moves until the admin who asked
/// enters the code emailed to them (10 minutes, 5 attempts, a resend a minute). Fiat: from or to the provider balance
/// (`manual`), into the market's house account; coins: from or to `crypto_custody` (coins BitoCard holds on chain),
/// into the root house account.
model ReserveMovement {
  id                String     @id @default(uuid()) @db.Uuid
  /// Shown as RM-000123.
  number            Int        @unique @default(autoincrement())
  mode              LedgerMode
  /// fund or withdraw.
  kind              String
  /// fiat or crypto.
  reserve           String
  /// The asset code, or the fiat currency.
  currency          String     @db.VarChar(10)
  /// Fiat reserves: the market whose house account holds it.
  country           String?    @db.Char(2)
  amount            BigInt
  externalReference String?    @map("external_reference")
  reason            String
  /// awaiting_code, completed or cancelled.
  status            String     @default("awaiting_code")
  requestedBy       String     @map("requested_by") @db.Uuid
  cancelledBy       String?    @map("cancelled_by") @db.Uuid
  codeHash          String?    @map("code_hash")
  codeExpiresAt     DateTime?  @map("code_expires_at")
  codeAttempts      Int        @default(0) @map("code_attempts")
  codeSentAt        DateTime?  @map("code_sent_at")
  /// Codes sent for this request (capped, so resends cannot give unlimited guesses).
  codeSends         Int        @default(1) @map("code_sends")
  entryId           String?    @map("entry_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  completedAt       DateTime?  @map("completed_at")

  @@index([status, createdAt])
  @@map("reserve_movements")
}

/// Money an admin recorded as sent to a supplier outside BitoCard (a bank transfer to its account): funds
/// `supplier_float`, confirmed by a code emailed to the admin who asked, exactly like a reserve movement.
model SupplierFundingMovement {
  id            String     @id @default(uuid()) @db.Uuid
  /// Shown as SF-000123.
  number        Int        @unique @default(autoincrement())
  mode          LedgerMode
  supplierCode  String     @map("supplier_code")
  /// The supplier's cost currency.
  currency      String     @db.VarChar(10)
  amount        BigInt
  /// What the money was for, and (when given) the bank transfer's own reference. Recorded in the activity log.
  reason        String
  /// awaiting_code, completed or cancelled.
  status        String     @default("awaiting_code")
  requestedBy   String     @map("requested_by") @db.Uuid
  cancelledBy   String?    @map("cancelled_by") @db.Uuid
  codeHash      String?    @map("code_hash")
  codeExpiresAt DateTime?  @map("code_expires_at")
  codeAttempts  Int        @default(0) @map("code_attempts")
  codeSentAt    DateTime?  @map("code_sent_at")
  /// Codes sent for this request (capped, so resends cannot give unlimited guesses).
  codeSends     Int        @default(1) @map("code_sends")
  entryId       String?    @map("entry_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  completedAt   DateTime?  @map("completed_at")
  supplier      Supplier   @relation(fields: [supplierCode], references: [code], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([supplierCode])
  @@map("supplier_funding_movements")
}

model CryptoWithdrawal {
  id              String                   @id @default(uuid()) @db.Uuid
  /// Shown as CW-000123.
  number          Int                      @unique @default(autoincrement())
  /// Whose coins: a store customer or a reseller (exactly one).
  customerId      String?                  @map("customer_id") @db.Uuid
  resellerId      String?                  @map("reseller_id") @db.Uuid
  /// For a reseller's withdrawal, the team member who asked: only they can confirm it with the emailed code.
  requestedBy     String?                  @map("requested_by") @db.Uuid
  mode            LedgerMode
  asset           String                   @db.VarChar(10)
  chain           String
  addressId       String?                  @map("address_id") @db.Uuid
  address         String
  /// Ledger units sent to the address, and BitoCard's fee on top.
  amount          BigInt
  fee             BigInt
  /// What the signer sends, in on-chain units (text: 18-decimal tokens exceed a bigint).
  rawAmount       String                   @map("raw_amount")
  /// awaiting_code, review, queued, submitting, broadcast, completed, failed, rejected or cancelled.
  status          String                   @default("awaiting_code")
  codeHash        String?                  @map("code_hash")
  codeExpiresAt   DateTime?                @map("code_expires_at")
  codeAttempts    Int                      @default(0) @map("code_attempts")
  codeSentAt      DateTime?                @map("code_sent_at")
  /// Why it waits for an admin (amount, screening), and the admin's decision.
  reviewReason    String?                  @map("review_reason")
  reviewedBy      String?                  @map("reviewed_by") @db.Uuid
  reviewNote      String?                  @map("review_note")
  reviewedAt      DateTime?                @map("reviewed_at")
  /// The same on every request to the signer, so a repeat never sends twice.
  signerReference String                   @unique @map("signer_reference")
  txHash          String?                  @map("tx_hash")
  confirmations   Int                      @default(0)
  attempts        Int                      @default(0)
  nextCheckAt     DateTime?                @map("next_check_at")
  /// Set once it has waited too long for the signer or the chain (admins were told).
  needsReviewAt   DateTime?                @map("needs_review_at")
  error           String?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  completedAt     DateTime?                @map("completed_at")
  customer        Customer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reseller        Reseller?                @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  savedAddress    CryptoWithdrawalAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([status, nextCheckAt])
  @@index([resellerId, createdAt])
  @@index([customerId, createdAt])
  @@map("crypto_withdrawals")
}

/// A customer's own deposit address in a family (bitcoin, evm, tron), derived from BitoCard's xpub at `index`.
model CryptoAddress {
  id             String     @id @default(uuid()) @db.Uuid
  /// Exactly one owner: a store customer or a reseller (Premium resellers' own coin wallets; a database check).
  customerId     String?    @map("customer_id") @db.Uuid
  resellerId     String?    @map("reseller_id") @db.Uuid
  mode           LedgerMode
  family         String
  index          Int
  address        String
  /// Which xpub made it (a short hash), so a changed key never mixes up old addresses.
  keyFingerprint String     @map("key_fingerprint")
  /// Watched for deposits until then: renewed whenever the customer shows it.
  watchUntil     DateTime   @map("watch_until")
  /// Last read outside its watch window (TRON and Bitcoin list each address's history, so unwatched ones are swept in turn).
  sweptAt        DateTime?  @map("swept_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reseller       Reseller?  @relation(fields: [resellerId], references: [id], onDelete: Restrict)

  @@unique([customerId, mode, family])
  @@unique([resellerId, mode, family])
  @@unique([mode, family, index])
  @@unique([mode, family, address])
  @@index([mode, family, watchUntil])
  @@index([mode, family, sweptAt])
  @@map("crypto_addresses")
}

/// A transfer to a customer's address, seen on chain: pending until it has its confirmations (and, when large, a second
/// provider agrees), then credited once (`crypto_deposit:<chain>:<tx>:<index>`).
model CryptoDeposit {
  id              String     @id @default(uuid()) @db.Uuid
  /// The address's owner: a store customer or a reseller (exactly one).
  customerId      String?    @map("customer_id") @db.Uuid
  resellerId      String?    @map("reseller_id") @db.Uuid
  mode            LedgerMode
  chain           String
  asset           String     @db.VarChar(10)
  address         String
  txHash          String     @map("tx_hash")
  /// The log index (tokens) or output index (Bitcoin); 0 for a plain coin transfer.
  outputIndex     Int        @map("output_index")
  /// On-chain units, as text (may exceed a bigint for 18-decimal tokens).
  rawAmount       String     @map("raw_amount")
  /// Ledger units credited (the asset's places).
  amount          BigInt
  blockNumber     BigInt?    @map("block_number")
  confirmations   Int        @default(0)
  /// pending, credited, ignored (too small or too large to credit) or failed (no longer on chain).
  status          String     @default("pending")
  /// Providers that have confirmed it.
  confirmedBy     String[]   @default([]) @map("confirmed_by")
  checkedAt       DateTime?  @map("checked_at")
  /// When the chain stopped showing it (cleared when it is seen again); it fails 6 hours after this.
  missingSince    DateTime?  @map("missing_since")
  creditedAt      DateTime?  @map("credited_at")
  /// When the signer was told about the deposit's address (so it sweeps it and counts it in its balances).
  signerTrackedAt DateTime?  @map("signer_tracked_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reseller        Reseller?  @relation(fields: [resellerId], references: [id], onDelete: Restrict)

  @@unique([chain, txHash, outputIndex])
  @@index([resellerId, createdAt])
  @@index([status, chain])
  @@index([status, mode, checkedAt])
  @@index([customerId, createdAt])
  @@map("crypto_deposits")
}

/// The order BitoCard asks chain providers for each chain (lower first), and how each last answered.
model ChainRoute {
  chain     String
  provider  String
  priority  Int       @default(100)
  enabled   Boolean   @default(true)
  lastBlock BigInt?   @map("last_block")
  lastError String?   @map("last_error")
  checkedAt DateTime? @map("checked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([chain, provider])
  @@map("chain_routes")
}

/// A chain provider's notification, kept once per body: only the transactions it names, which are re-read before anything is credited.
model ChainNotice {
  id          String      @id @default(uuid()) @db.Uuid
  provider    String
  chain       String
  bodyHash    String      @unique @map("body_hash")
  /// The mode to record in; null for providers' webhooks (their Sandbox switch decides). Set for transactions a scan
  /// found but no provider could read yet (provider `scan`), kept here to be retried.
  mode        LedgerMode?
  hashes      String[]
  processedAt DateTime?   @map("processed_at")
  attempts    Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([processedAt])
  @@map("chain_notices")
}

/// How far deposit scanning has read each chain in each mode (block ranges for EVM chains).
model ChainCursor {
  chain     String
  mode      LedgerMode
  block     BigInt
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@id([chain, mode])
  @@map("chain_cursors")
}

/// Spin and win: a customer's one-time $1 in crypto, won over 50 to 100 spins (a few a day). One per person (email) and
/// mode across every store, so the same person at several stores gets it once. The wins are fixed when it starts.
model SpinAllowance {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  mode       LedgerMode
  /// The customer's email in lower case: one allowance per person and mode, whichever store they use.
  emailKey   String     @map("email_key")
  /// Each spin's win in US cents, in order (each 1 to 10, adding up to total_cents).
  schedule   Int[]
  totalCents Int        @default(100) @map("total_cents")
  spinsUsed  Int        @default(0) @map("spins_used")
  wonCents   Int        @default(0) @map("won_cents")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  spins      Spin[]

  @@unique([mode, emailKey])
  @@index([customerId])
  @@map("spin_allowances")
}

/// One spin of the wheel: what it won (US cents), paid in which coin and how much, credited once (ledger `crypto_spin:<id>`).
model Spin {
  id          String        @id @default(uuid()) @db.Uuid
  allowanceId String        @map("allowance_id") @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  mode        LedgerMode
  /// 1 for the first spin of the allowance.
  number      Int
  cents       Int
  asset       String        @db.VarChar(10)
  /// In the asset's base units.
  amount      BigInt
  /// The wheel segment it landed on (0 at the top, clockwise).
  segment     Int
  /// The coin's US dollar price used (BNB), as text; null for stablecoins counted at $1.
  priceUsd    String?       @map("price_usd")
  createdAt   DateTime      @default(now()) @map("created_at")
  allowance   SpinAllowance @relation(fields: [allowanceId], references: [id], onDelete: Restrict)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([allowanceId, number])
  @@index([customerId, createdAt])
  @@index([mode, createdAt])
  @@map("spins")
}

enum PublicSpinClaimStatus {
  active
  claimed
  invalidated
  expired
}

/// Customer Catcher: the server-owned six-spin claim behind an opaque, HttpOnly storefront cookie. Prize values are
/// fixed on creation and never trusted from the browser. A claim is credited at most once after account creation.
model PublicSpinClaim {
  id                String                @id @default(uuid()) @db.Uuid
  tokenHash         String                @unique @map("token_hash") @db.Char(64)
  storeId           String                @map("store_id") @db.Uuid
  countryCode       String                @map("country_code") @db.Char(2)
  mode              LedgerMode
  status            PublicSpinClaimStatus @default(active)
  limit             Int                   @default(6)
  /// The full $1 allowance schedule; the visitor uses its first `limit` entries before sign-up.
  schedule          Int[]
  /// Presented outcomes, stored as objects with number, cents, asset, amount, segment and created_at.
  wins              Json                  @default("[]")
  spinsUsed         Int                   @default(0) @map("spins_used")
  wonCents          Int                   @default(0) @map("won_cents")
  customerId        String?               @unique @map("customer_id") @db.Uuid
  claimCurrency     String?               @map("claim_currency") @db.VarChar(3)
  claimAmountMinor  BigInt?               @map("claim_amount_minor")
  invalidatedReason String?               @map("invalidated_reason")
  expiresAt         DateTime              @map("expires_at")
  claimedAt         DateTime?             @map("claimed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  store             Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  country           Country               @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([storeId, status, expiresAt])
  @@map("public_spin_claims")
}

enum ResellerBusinessType {
  unregistered
  registered
}

enum KycCaseStatus {
  /// Being filled in by the applicant.
  draft
  /// Waiting for a reviewer.
  submitted
  approved
  declined
  /// The reviewer asked for some items again (`resubmit_items`); the applicant fills them in and submits again.
  resubmit
}

/// BitoCard Verify (verify.bitocard.com): one person's (KYC) or business's (KYB) application behind an identity check.
/// Its decision is applied to the identity check (`verification_id`), so every gate reads the check as before.
/// Documents are stored encrypted in a private bucket (`kyc_documents`); typed ID numbers are encrypted, with an HMAC
/// fingerprint to find the same ID on other cases.
model KycCase {
  id                 String                @id @default(uuid()) @db.Uuid
  verificationId     String                @unique @map("verification_id") @db.Uuid
  subject            VerificationSubject
  /// kyc (a person) or kyb (a reseller's business: unregistered, or registered with its documents).
  kind               String
  mode               LedgerMode
  country            String                @db.Char(2)
  /// The reseller verified (KYB), or the customer's seller (customer checks).
  resellerId         String                @map("reseller_id") @db.Uuid
  /// The reseller's own reference for the customer (customer checks; a store customer's id on hosted stores).
  customerReference  String?               @map("customer_reference")
  storeId            String?               @map("store_id") @db.Uuid
  status             KycCaseStatus         @default(draft)
  consentAt          DateTime?             @map("consent_at")
  businessType       ResellerBusinessType? @map("business_type")
  registeredName     String?               @map("registered_name")
  registrationNumber String?               @map("registration_number")
  businessAddress    String?               @map("business_address")
  idType             String?               @map("id_type")
  /// Encrypted with ENCRYPTION_KEY; shown in full only to reviewers.
  idNumberEncrypted  String?               @map("id_number_encrypted")
  /// HMAC of country, ID type and number: the same ID on other cases.
  idFingerprint      String?               @map("id_fingerprint")
  fullName           String?               @map("full_name")
  dateOfBirth        String?               @map("date_of_birth")
  /// The liveness steps issued (codes), in order.
  livenessSteps      String[]              @map("liveness_steps")
  /// Who reviews it, fixed at submission: admin, or the customer's seller (registered and KYB-verified).
  reviewer           String?
  resubmitItems      String[]              @map("resubmit_items")
  reason             String?
  note               String?
  verifiedName       String?               @map("verified_name")
  decidedById        String?               @map("decided_by_id") @db.Uuid
  /// admin or reseller.
  decidedRealm       String?               @map("decided_realm")
  returnUrl          String?               @map("return_url")
  submittedAt        DateTime?             @map("submitted_at")
  decidedAt          DateTime?             @map("decided_at")
  /// When the documents are deleted (retention), null while it is open.
  purgeAfter         DateTime?             @map("purge_after")
  purgedAt           DateTime?             @map("purged_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  verification       IdentityVerification  @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  reseller           Reseller              @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  documents          KycDocument[]
  sessions           KycSession[]

  @@index([status, reviewer, submittedAt])
  @@index([resellerId, subject, status])
  @@index([idFingerprint])
  @@index([purgeAfter])
  @@map("kyc_cases")
}

/// One uploaded file of a case (ID sides, selfie, liveness frames, business documents), encrypted in the private bucket.
model KycDocument {
  id          String   @id @default(uuid()) @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  /// id_front, id_back, selfie, liveness_<step>_<frame>, business_registration, business_address, business_directors.
  kind        String
  objectKey   String   @map("object_key")
  contentType String   @map("content_type")
  size        Int
  sha256      String
  createdAt   DateTime @default(now()) @map("created_at")
  case        KycCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, kind])
  @@map("kyc_documents")
}

/// Links into verify.bitocard.com (single use, 30 minutes) and the app sessions they become (2 hours idle), by hash.
model KycSession {
  id        String    @id @default(uuid()) @db.Uuid
  caseId    String    @map("case_id") @db.Uuid
  /// handoff (the link) or session (what the link was exchanged for).
  kind      String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  case      KycCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("kyc_sessions")
}

/// Spin and win rewards exchanged into a customer's store wallet (ledger `spin_exchange:<id>`): every coin's rewards at
/// once, valued in US cents (stablecoins at $1, BNB at its price) and paid in the wallet's currency.
model SpinExchange {
  id          String     @id @default(uuid()) @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  mode        LedgerMode
  /// What was exchanged, per coin, in base units as text: `{ "USDT": "120000", "BNB": "53000" }`.
  amounts     Json
  /// Their value in US cents, rounded down.
  usdCents    Int        @map("usd_cents")
  /// The wallet credited and how much, in its minor units.
  currency    String     @db.VarChar(10)
  amountMinor BigInt     @map("amount_minor")
  /// US dollars to the wallet's currency (1 for US dollars), as text.
  rate        String
  createdAt   DateTime   @default(now()) @map("created_at")
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([mode, createdAt])
  @@map("spin_exchanges")
}

/// How a store's domain came to BitoCard: bought through it (Vercel's registrar) or connected (bought elsewhere).
enum DomainSource {
  purchased
  connected
}

/// `purchasing` (bought, waiting for the registrar), `pending` (added, waiting for DNS or verification), `active` (the
/// store is served on it), `failed` (the purchase failed: the money was returned), `expired`, `suspended` (by an admin)
/// or `removed`.
enum DomainStatus {
  purchasing
  pending
  active
  failed
  expired
  suspended
  removed
}

/// A reseller store's own domain, served by the storefront through Vercel (the storefront project's domains).
model StoreDomain {
  id               String       @id @default(uuid()) @db.Uuid
  resellerId       String       @map("reseller_id") @db.Uuid
  storeId          String       @map("store_id") @db.Uuid
  /// Lower case, without www (the apex the reseller chose, or a subdomain of a domain they own).
  name             String
  source           DomainSource
  status           DomainStatus @default(pending)
  /// Where its DNS is: `vercel` (Vercel's nameservers, editable in SHQ) or `external` (the reseller's own DNS host).
  dnsMode          String       @default("external") @map("dns_mode")
  /// The store's main address: links, payment returns and emails use it.
  primary          Boolean      @default(false)
  verified         Boolean      @default(false)
  misconfigured    Boolean      @default(true)
  /// Vercel's ownership challenges while not verified ([{ type, domain, value, reason }]).
  verification     Json?
  lastCheckedAt    DateTime?    @map("last_checked_at")
  lastError        String?      @map("last_error")
  // Buying and renewing (purchased domains only).
  orderId          String?      @map("order_id")
  /// Vercel's price for the registration being paid for, in US cents.
  costCents        Int?         @map("cost_cents")
  /// What the reseller pays for it (Vercel's price plus BitoCard's margin), in US cents.
  priceCents       Int?         @map("price_cents")
  holdId           String?      @map("hold_id") @db.Uuid
  expiresAt        DateTime?    @map("expires_at")
  autoRenew        Boolean      @default(true) @map("auto_renew")
  renewalAttemptAt DateTime?    @map("renewal_attempt_at")
  renewalError     String?      @map("renewal_error")
  remindedAt       Json?        @map("reminded_at")
  // Email from the store's domain (Resend) and the mailbox provider chosen.
  emailDomainId    String?      @map("email_domain_id")
  emailStatus      String?      @map("email_status")
  emailRecords     Json?        @map("email_records")
  mailProvider     String?      @map("mail_provider")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  reseller         Reseller     @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([resellerId])
  @@index([storeId])
  @@index([status])
  @@map("store_domains")
}

/// Visits to a reseller store per UTC day and address (its bitocard.com subdomain or a custom domain), counted on the
/// storefront's server without cookies: page views, and visitors told apart only within the day (see `StoreVisitor`).
model StoreVisitDay {
  storeId  String   @map("store_id") @db.Uuid
  host     String
  day      DateTime @db.Date
  views    Int      @default(0)
  visitors Int      @default(0)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, host, day])
  @@index([day])
  @@map("store_visit_days")
}

/// Today's visitors of a store: an HMAC of the address, browser and host keyed with that day's random salt, only to count
/// each visitor once a day. Deleted with the salt once the day is over, so visits can never be linked across days.
model StoreVisitor {
  storeId String   @map("store_id") @db.Uuid
  day     DateTime @db.Date
  hash    String

  @@id([storeId, day, hash])
  @@index([day])
  @@map("store_visitors")
}

/// One random salt per UTC day for `StoreVisitor` hashes, deleted once the day is over.
model StoreVisitSalt {
  day       DateTime @id @db.Date
  salt      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("store_visit_salts")
}

/// Each published version of a reseller store's home page, so an earlier one can be restored into the draft.
model StoreHomeVersion {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  version       Int
  template      String
  variant       String
  sections      Json
  publishedById String?  @map("published_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
  @@map("store_home_versions")
}

/// A support ticket (shown as T-000123): a store customer's question to their store, a reseller's to BitoCard, or one a
/// reseller logs for a customer on their own systems. The store answers its customers first and can pass a ticket to
/// BitoCard (`queue: bitocard`); BitoCard answers resellers' tickets and passed ones. Disputes about money stay disputes.
model SupportTicket {
  id                String                 @id @default(uuid()) @db.Uuid
  number            Int                    @unique @default(autoincrement())
  resellerId        String                 @map("reseller_id") @db.Uuid
  mode              LedgerMode
  /// customer (a store customer, or one on the reseller's own systems) or reseller (the reseller's own, to BitoCard).
  requester         String
  /// Who answers: reseller (the store) or bitocard.
  queue             String
  /// open (waiting for whoever answers), pending (waiting for the requester) or resolved.
  status            String                 @default("open")
  /// order, payment, account, product, technical or other.
  category          String
  /// low, normal, high or urgent (set by staff).
  priority          String                 @default("normal")
  subject           String
  storeId           String?                @map("store_id") @db.Uuid
  customerId        String?                @map("customer_id") @db.Uuid
  /// The reseller's own reference for a customer on their own systems.
  customerReference String?                @map("customer_reference")
  /// The reseller team member who opened it (reseller tickets).
  userId            String?                @map("user_id") @db.Uuid
  orderId           String?                @map("order_id") @db.Uuid
  checkoutId        String?                @map("checkout_id") @db.Uuid
  /// form, api, chat or bot.
  source            String                 @default("form")
  /// The staff member it is assigned to: a reseller team member on the reseller queue, an admin on BitoCard's.
  assigneeId        String?                @map("assignee_id") @db.Uuid
  /// When an assistant run claimed the next reply (so two runs never reply at once).
  botClaimedAt      DateTime?              @map("bot_claimed_at")
  /// The engineering issue it became (GitHub): its repository, number, address and state (open or closed).
  githubRepo        String?                @map("github_repo")
  githubIssueNumber Int?                   @map("github_issue_number")
  githubIssueUrl    String?                @map("github_issue_url")
  githubIssueState  String?                @map("github_issue_state")
  engineeringAt     DateTime?              @map("engineering_at")
  escalatedAt       DateTime?              @map("escalated_at")
  resolvedAt        DateTime?              @map("resolved_at")
  lastMessageAt     DateTime               @default(now()) @map("last_message_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  messages          SupportTicketMessage[]

  @@index([resellerId, mode, status])
  @@index([queue, status, lastMessageAt])
  @@index([customerId, createdAt])
  @@index([githubRepo, githubIssueNumber])
  @@map("support_tickets")
}

/// One message on a support ticket.
model SupportTicketMessage {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @map("ticket_id") @db.Uuid
  /// customer, reseller, bitocard, bot or system.
  author          String
  authorId        String?       @map("author_id") @db.Uuid
  authorName      String?       @map("author_name")
  /// The assistant's picture when it wrote (bot messages), so each answer shows its face.
  authorAvatarUrl String?       @map("author_avatar_url")
  /// all: the requester sees it too; staff: those answering only (the reseller and BitoCard on a customer's ticket,
  /// BitoCard only on a reseller's own).
  visibility      String        @default("all")
  body            String
  /// An assistant's suggested reply waiting for staff to send, edit or discard (never shown to the requester).
  draft           Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// A live chat: a store customer with their store (BitoCard at bitocard.com), or a reseller's team with BitoCard. One
/// open conversation per customer (or reseller) at a time; staff take it over, close it, or turn it into a ticket.
model SupportConversation {
  id                 String                  @id @default(uuid()) @db.Uuid
  resellerId         String                  @map("reseller_id") @db.Uuid
  mode               LedgerMode
  /// customer (a store customer) or reseller (a reseller's team chatting with BitoCard).
  requester          String
  /// Who answers: reseller (the store) or bitocard.
  queue              String
  /// bot (an assistant is answering), waiting (for a person), with_staff (a person is answering) or closed.
  status             String                  @default("waiting")
  storeId            String?                 @map("store_id") @db.Uuid
  customerId         String?                 @map("customer_id") @db.Uuid
  /// The reseller team member who started it (reseller chats).
  userId             String?                 @map("user_id") @db.Uuid
  /// The staff member answering (a reseller team member, or an admin on BitoCard's queue).
  assigneeId         String?                 @map("assignee_id") @db.Uuid
  /// The ticket it became, if staff turned it into one.
  ticketId           String?                 @map("ticket_id") @db.Uuid
  lastMessageAt      DateTime                @default(now()) @map("last_message_at")
  /// When the requester last wrote: a conversation waits for staff from here.
  lastAskedAt        DateTime                @default(now()) @map("last_asked_at")
  /// When staff were last told it is waiting (at most every 10 minutes per conversation).
  alertedAt          DateTime?               @map("alerted_at")
  /// The assistant answering it (status `bot`), and when one run claimed the next answer (so two runs never answer at once).
  botId              String?                 @map("bot_id") @db.Uuid
  botClaimedAt       DateTime?               @map("bot_claimed_at")
  closedAt           DateTime?               @map("closed_at")
  /// A signed-out visitor who gave their name and email (store chats without an account).
  visitorId          String?                 @map("visitor_id") @db.Uuid
  visitor            SupportVisitor?         @relation(fields: [visitorId], references: [id])
  /// When a visitor was last emailed that staff replied (at most every 10 minutes per conversation).
  requesterAlertedAt DateTime?               @map("requester_alerted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  messages           SupportChatMessage[]
  attachments        SupportChatAttachment[]

  @@index([queue, status, lastMessageAt])
  @@index([resellerId, mode, status])
  @@index([customerId, status])
  @@index([userId, status])
  @@map("support_conversations")
}

/// One message in a live chat.
model SupportChatMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @map("conversation_id") @db.Uuid
  /// customer, reseller, bitocard, bot or system.
  author          String
  authorId        String?                 @map("author_id") @db.Uuid
  authorName      String?                 @map("author_name")
  /// The assistant's picture when it wrote (bot messages), so each answer shows its face.
  authorAvatarUrl String?                 @map("author_avatar_url")
  body            String
  createdAt       DateTime                @default(now()) @map("created_at")
  conversation    SupportConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments     SupportChatAttachment[]

  @@index([conversationId, createdAt])
  @@map("support_chat_messages")
}

/// A file sent in a chat (a photo or a PDF), sealed by the API in the private bucket and only read back through it.
model SupportChatAttachment {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  messageId      String              @map("message_id") @db.Uuid
  objectKey      String              @map("object_key")
  /// The file's name as sent (shown; never part of the storage key).
  name           String
  contentType    String              @map("content_type")
  size           Int
  width          Int?
  height         Int?
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        SupportChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("support_chat_attachments")
}

/// A signed-out visitor chatting with a store: the name and email they gave, and their browser's token (hash only).
model SupportVisitor {
  id            String                @id @default(uuid()) @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  name          String
  email         String
  tokenHash     String                @unique @map("token_hash")
  lastSeenAt    DateTime              @default(now()) @map("last_seen_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  conversations SupportConversation[]

  @@index([storeId])
  @@map("support_visitors")
}

/// A reseller's own key for an AI provider, for their support bots (they pay the provider; no BitoCard allowance).
/// Encrypted with ENCRYPTION_KEY, checked with the provider before it is saved, never returned (only its last four).
model AiKey {
  id           String    @id @default(uuid()) @db.Uuid
  resellerId   String    @map("reseller_id") @db.Uuid
  /// anthropic, openai or deepseek.
  provider     String
  keyEncrypted String    @map("key_encrypted")
  last4        String
  /// The models the key could use when last checked.
  models       String[]  @default([])
  checkedAt    DateTime  @map("checked_at")
  /// When a bot's call was refused for the key (it stops using it until it is replaced).
  failedAt     DateTime? @map("failed_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([resellerId, provider])
  @@map("ai_keys")
}

/// One AI call for support: who it was for, how it was paid (BitoCard's keys or the store's own), its tokens and cost.
model AiUsage {
  id           String     @id @default(uuid()) @db.Uuid
  resellerId   String     @map("reseller_id") @db.Uuid
  storeId      String?    @map("store_id") @db.Uuid
  botId        String?    @map("bot_id") @db.Uuid
  mode         LedgerMode
  /// bitocard (its keys, counted against the store's allowance) or own (the store's key).
  funding      String
  provider     String
  model        String
  /// chat, ticket, generate or test.
  kind         String
  inputTokens  Int        @map("input_tokens")
  cachedTokens Int        @map("cached_tokens")
  outputTokens Int        @map("output_tokens")
  /// Millionths of a US dollar, from the admin's price list (0 without a price).
  costMicros   BigInt     @map("cost_micros")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([storeId, funding, createdAt])
  @@index([resellerId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

/// A support bot (assistant): one per store (or BitoCard's one for resellers in SHQ, `scope: platform`). It answers
/// chats and/or tickets with an AI agent (BitoCard's keys on Premium, or the reseller's own), from its knowledge.
model SupportBot {
  id               String                @id @default(uuid()) @db.Uuid
  resellerId       String                @map("reseller_id") @db.Uuid
  /// store (a store's customers) or platform (BitoCard's assistant for resellers in SHQ).
  scope            String                @default("store")
  storeId          String?               @unique @map("store_id") @db.Uuid
  /// chat and/or tickets.
  roles            String[]              @default([])
  /// auto (sends ticket replies) or draft (staff send them).
  ticketReplyMode  String                @default("draft") @map("ticket_reply_mode")
  /// anthropic, openai or deepseek.
  provider         String
  model            String
  /// bitocard (its keys, Premium) or own (the reseller's key).
  funding          String
  name             String
  avatarUrl        String?               @map("avatar_url")
  greeting         String?
  /// friendly, formal or brief.
  tone             String                @default("friendly")
  instructions     String?
  /// draft, active, paused (by its owner) or suspended (by BitoCard).
  status           String                @default("draft")
  suspendedReason  String?               @map("suspended_reason")
  knowledgeId      String?               @map("knowledge_id") @db.Uuid
  /// Applies BitoCard's sections by itself when the store's data changes (never the owner's).
  autoRefresh      Boolean               @default(false) @map("auto_refresh")
  /// When the store's data first differed from the knowledge in use.
  knowledgeStaleAt DateTime?             @map("knowledge_stale_at")
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  knowledge        SupportBotKnowledge[]

  @@index([resellerId])
  @@index([status])
  @@map("support_bots")
}

/// A version of a bot's knowledge document (Markdown). Never edited in place: a change is a new version.
model SupportBotKnowledge {
  id              String     @id @default(uuid()) @db.Uuid
  botId           String     @map("bot_id") @db.Uuid
  version         Int
  /// upload, generated (by BitoCard from the store), edited or refreshed (BitoCard's sections updated).
  source          String
  /// md, or csv (FAQs, turned into Markdown when uploaded).
  format          String     @default("md")
  content         String
  chars           Int
  /// A fingerprint of the store data BitoCard's sections were made from (null for a document with none).
  dataHash        String?    @map("data_hash")
  /// Each BitoCard section's hash as BitoCard wrote it, to tell when the owner edited one.
  managedSections Json       @default("{}") @map("managed_sections")
  createdById     String?    @map("created_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  bot             SupportBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, version])
  @@map("support_bot_knowledge")
}

/// A month's bill: per store (and one for the account's own usage), per currency, live only. Each line was taken from
/// the wallet when it happened; what the wallet could not pay is owed until a top-up (or Pay invoice) pays it.
model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  /// Shown as INV-000123.
  number      Int           @unique @default(autoincrement())
  resellerId  String        @map("reseller_id") @db.Uuid
  /// Null: the account's own usage.
  storeId     String?       @map("store_id") @db.Uuid
  /// The store's id, or `account`: one invoice per scope, currency and month.
  scopeKey    String        @map("scope_key")
  currency    String        @db.Char(3)
  /// The calendar month (UTC) it covers.
  periodStart DateTime      @map("period_start")
  periodEnd   DateTime      @map("period_end")
  /// `open` (the month is running), `closed` (owing), `paid` (closed and nothing owed).
  status      String        @default("open")
  totalMinor  BigInt        @default(0) @map("total_minor")
  paidMinor   BigInt        @default(0) @map("paid_minor")
  closedAt    DateTime?     @map("closed_at")
  /// 7 days after it closes, or sooner when one of the store's subscriptions renews first.
  dueAt       DateTime?     @map("due_at")
  paidAt      DateTime?     @map("paid_at")
  /// Set once when it went past its due date unpaid (the credit limit dropped a step).
  overdueAt   DateTime?     @map("overdue_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  reseller    Reseller      @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  lines       InvoiceLine[]

  @@unique([resellerId, scopeKey, currency, periodStart])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  /// subscription, domain, platform_fee, usage
  kind        String
  description String
  amountMinor BigInt   @map("amount_minor")
  /// Taken from the wallet so far; the rest is owed.
  paidMinor   BigInt   @map("paid_minor")
  /// The ledger reference of what it charged: each charge is one line.
  reference   String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_lines")
}
