# Copy to .env for local development. Never commit .env.
#
# Only what the API needs to start and to protect admin access lives here. Every service key (email, SMS, Google,
# payments, exchange rates, suppliers, identity checks, storage, domains, push) is set by a super admin in the admin
# app: Settings > Integrations, encrypted in the database. Everything else has a working default in
# src/config/config.ts; add it here only to change it.

# --- Required (scripts/check-env.mjs refuses to deploy without them) ------------------------------------------------

# Postgres (Neon, pooled connection string). Use a development database locally, never production's.
DATABASE_URL=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). Encrypts admin
# authenticator secrets, service keys set in the admin app, webhook secrets and order codes. It must be the key the
# database's stored secrets were sealed with; never change it once set.
ENCRYPTION_KEY=

# Bearer token the scheduler sends to /v1/cron/<job>. At least 32 random characters.
CRON_SECRET=

# --- Local development (the defaults are production's) ----------------------------------------------------------

# Browser origins allowed to call the API with cookies: storefront, docs, admin, SHQ.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Cookies over plain HTTP on localhost. Refused in production.
COOKIE_SECURE=off

# The admins' own addresses (comma separated): the only ones the admin sign-in page sets up and emails set-password
# links to. Empty: none. ADMIN_APP_URL is where those links point.
ADMIN_SETUP_EMAILS=
ADMIN_APP_URL=http://localhost:3003

# Shared with the storefront (the same value in its environment, at least 32 characters): it signs shoppers' addresses
# for rate limits.
STORE_SERVER_SECRET=
