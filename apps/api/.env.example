# Copy to .env for local development. Never commit .env.

# Postgres (Neon, pooled connection string). Required for anything that touches the database.
DATABASE_URL=

# Upstash Redis (REST). Optional locally: rate limits fall back to in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). Required for admin sign-in.
ENCRYPTION_KEY=

# Browser origins allowed to call the API with cookies, and the shared cookie domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3004,https://*.bitocard.com
SESSION_COOKIE_DOMAIN=
COOKIE_SECURE=off

# Email (Resend, then MailerSend). Leave empty locally: emails are captured and logged instead.
RESEND_API_KEY=
MAILERSEND_API_KEY=
EMAIL_FROM=BitoCard <no-reply@bitocard.com>

# SMS sign-in codes (Termii). Leave empty locally: texts are captured and logged instead.
TERMII_API_KEY=
TERMII_API_URL=https://api.ng.termii.com
TERMII_SENDER_ID=BitoCard

# Sign in with Google (resellers). Leave empty to switch it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
DASHBOARD_URL=http://localhost:3004

# Payments, reserved accounts and payouts. Leave empty locally: test mode (the sandbox) never calls providers,
# and live money movements report the provider as unavailable.
FLUTTERWAVE_SECRET_KEY=
# The secret hash set under Webhooks in the Flutterwave dashboard (webhook URL: https://api.bitocard.com/v1/webhooks/flutterwave).
FLUTTERWAVE_WEBHOOK_HASH=
# Monnify (Nigeria reserved accounts; webhook URL: https://api.bitocard.com/v1/webhooks/monnify). Sandbox: https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_API_URL=https://api.monnify.com
PAYMENT_RETURN_URL=http://localhost:3004/wallet

# Exchange rates: Open Exchange Rates, checked against Flutterwave. Rates older than FX_MAX_AGE_MINUTES are not used.
OPEN_EXCHANGE_RATES_APP_ID=
FX_MAX_AGE_MINUTES=180

# Suppliers. Without credentials a supplier serves only the sandbox (test mode), never live orders.
# Reloadly (gift cards, airtime, data): RELOADLY_SANDBOX=on uses its sandbox APIs.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=on
# VTpass (Nigerian pay-TV and electricity). Sandbox: https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_API_URL=https://sandbox.vtpass.com/api
# VTpass needs a phone number on every payment; used when the customer gave none.
VTPASS_CONTACT_PHONE=08011111111

# Scheduled jobs (vercel.json crons) send this as a Bearer token. Generate a long random value.
CRON_SECRET=
# Operational alerts, for example conversions paused.
ALERT_EMAIL=alerts@bitocard.com

# Webhooks to resellers. Local development only: allow http:// and private addresses as endpoints (refused in production).
WEBHOOK_ALLOW_PRIVATE_URLS=off
# GET /v1/events holds back events newer than this many seconds.
EVENTS_SETTLE_SECONDS=5

# Requests per minute per caller on /v1.
RATE_LIMIT_PER_MINUTE=600

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
