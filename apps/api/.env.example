# Copy to .env for local development. Never commit .env.
#
# Only what the API needs to start and to protect admin access lives here. Service keys and their settings (email,
# SMS, Google sign-in, payments, exchange rates, suppliers, identity checks, links and alerts) are set by a super admin
# in the admin app: Settings > Integrations. They are encrypted in the database and apply within 30 seconds, without a
# restart. The same names still work as environment variables (a value set in the admin app wins); tests use that.

# --- Required ---------------------------------------------------------------------------------------------------

# Postgres (Neon, pooled connection string).
DATABASE_URL=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). Encrypts admin
# authenticator secrets, service keys set in the admin app, webhook secrets and order codes. Never change it once set.
ENCRYPTION_KEY=

# Scheduled jobs (vercel.json crons) send this as a Bearer token. Generate a long random value.
CRON_SECRET=

# Browser origins allowed to call the API with cookies (the CSRF check), and the shared cookie domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,https://*.bitocard.com
SESSION_COOKIE_DOMAIN=
COOKIE_SECURE=off

# Email domains admins may sign in with (checked server-side).
ADMIN_EMAIL_DOMAINS=bitocard.com,golojan.co.uk
# The admins' own addresses (comma separated): the only ones the admin sign-in page sets up (as super admins) and
# emails set-password or reset links to. Empty: none. ADMIN_APP_URL is where the links point (default
# https://admin.bitocard.com).
ADMIN_SETUP_EMAILS=
ADMIN_APP_URL=http://localhost:3003

# --- Optional ---------------------------------------------------------------------------------------------------

# Upstash Redis (REST), added by the Vercel Marketplace. Without it, rate limits use in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests per minute per caller on /v1.
RATE_LIMIT_PER_MINUTE=600
ADDRESS_RATE_LIMIT_PER_MINUTE=1200
# Sign-in, password and code routes, per address (still counted, in memory, if Redis is down).
AUTH_RATE_LIMIT_PER_MINUTE=30
# Proxies in front of the API to trust for the client address: 1 on Vercel or behind one load balancer, 0 if none.
TRUST_PROXY=1
# Shared with the storefront (its STORE_SERVER_SECRET, at least 32 characters): it signs each shopper's address so
# signed-out shoppers are rate limited one by one. Unset, they share the store server's limit.
STORE_SERVER_SECRET=

# Webhooks to resellers. Local development only: allow http:// and private addresses as endpoints (refused in production).
WEBHOOK_ALLOW_PRIVATE_URLS=off
# Delivery transport: vercel (Vercel Queues; the default on Vercel, using OIDC) or database (the default elsewhere).
# WEBHOOK_QUEUE=
# GET /v1/events holds back events newer than this many seconds.
EVENTS_SETTLE_SECONDS=5

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
