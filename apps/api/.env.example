# Copy to .env for local development. Never commit .env.

# Postgres (Neon, pooled connection string). Required for anything that touches the database.
DATABASE_URL=

# Upstash Redis (REST). Optional locally: rate limits fall back to in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). Required for admin sign-in.
ENCRYPTION_KEY=

# Browser origins allowed to call the API with cookies, and the shared cookie domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3004,https://*.bitocard.com
SESSION_COOKIE_DOMAIN=
COOKIE_SECURE=off

# Email (Resend, then MailerSend). Leave empty locally: emails are captured and logged instead.
RESEND_API_KEY=
MAILERSEND_API_KEY=
EMAIL_FROM=BitoCard <no-reply@bitocard.com>

# SMS sign-in codes (Termii). Leave empty locally: texts are captured and logged instead.
TERMII_API_KEY=
TERMII_API_URL=https://api.ng.termii.com
TERMII_SENDER_ID=BitoCard

# Sign in with Google (resellers). Leave empty to switch it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
DASHBOARD_URL=http://localhost:3004

# Requests per minute per caller on /v1.
RATE_LIMIT_PER_MINUTE=600

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
