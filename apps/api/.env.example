# Copy to .env for local development. Never commit .env.

# Postgres (Neon, pooled connection string). Required for anything that touches the database.
DATABASE_URL=

# Upstash Redis (REST). Optional locally: rate limits fall back to in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests per minute per caller on /v1.
RATE_LIMIT_PER_MINUTE=600

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
