{
  "name": "@bitocard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\" && node scripts/export-openapi.mjs --check",
    "openapi": "node scripts/export-openapi.mjs",
    "db:migrate:create": "prisma migrate dev --create-only --name",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:studio": "prisma studio",
    "test:docker": "node --env-file=test/docker.env --test --test-concurrency=1 \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "push:keys": "node scripts/push-keys.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.10",
    "@vercel/queue": "^0.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "nestjs-pino": "^5.3.0",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bitocard/eslint-config": "*",
    "@electric-sql/pglite": "^0.4.3",
    "@nestjs/cli": "^12.0.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.0",
    "typescript": "^6.0.2"
  }
}
