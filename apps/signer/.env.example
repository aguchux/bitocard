# BitoCard signer settings. Copy to .env for local development; in production set them in the host's secret store.
# Never commit real values. See docs/crypto-signer.md.

# mainnet (live stores) or testnet (sandbox stores). Run one signer per network.
SIGNER_NETWORK=testnet
# The same value as CRYPTO_SIGNER_SECRET in the admin app (at least 32 characters).
SIGNER_SECRET=
# The signer's own Postgres database (not the API's).
DATABASE_URL=postgres://bitocard:bitocard@localhost:5432/bitocard_signer
PORT=3010

# turnkey (production) or local (test networks only: a recovery phrase in SIGNER_MNEMONIC).
SIGNER_VAULT=turnkey
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# SIGNER_MNEMONIC=

# The account xpubs, exactly as saved in the admin app (Settings > Integrations > Blockchain > Wallet keys).
SIGNER_XPUB_EVM=
SIGNER_XPUB_TRON=
SIGNER_XPUB_BITCOIN=
SIGNER_XPUB_LITECOIN=
SIGNER_XPUB_DOGECOIN=

# Nodes the signer builds and broadcasts through (https). A chain without one is refused.
SIGNER_RPC_ETHEREUM=
SIGNER_RPC_BSC=
SIGNER_RPC_POLYGON=
SIGNER_RPC_ARBITRUM=
SIGNER_RPC_BASE=
SIGNER_RPC_OPTIMISM=
SIGNER_TRON_URL=https://nile.trongrid.io
SIGNER_TRON_API_KEY=
SIGNER_ESPLORA_BITCOIN=https://mempool.space/testnet4/api
SIGNER_ESPLORA_LITECOIN=https://litecoinspace.org/testnet/api
SIGNER_BLOCKCYPHER_TOKEN=

# What may be sent, in on-chain units (see docs/crypto-signer.md). Anything not listed is refused.
SIGNER_LIMITS=[]
