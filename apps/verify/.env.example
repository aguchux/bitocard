# The BitoCard API. The applicant's pages call it from this app's server (API_URL wins there); the review console
# calls it from the browser with the reseller's session cookie (NEXT_PUBLIC_API_URL).
# Locally: run the API on 3001 with ALLOWED_ORIGINS including http://localhost:3006 and open http://localhost:3006.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where resellers sign in before reviewing their customers (SHQ).
NEXT_PUBLIC_SHQ_URL=http://localhost:3004
