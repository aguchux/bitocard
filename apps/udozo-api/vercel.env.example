# The environment of Udozo's API on Vercel (the udozo-api project, Root Directory apps/udozo-api; api.udozo.com).
# Set each as a Production environment variable of that project (Sensitive for the secrets); never commit real values.
# APP_PRODUCT defaults to udozo in this copy of the API and must be udozo in production; Vercel sets VERCEL_ENV,
# and its Cron sends CRON_SECRET with every scheduled job.
# Nothing here is shared with BitoCard: its own database, Redis, keys and secrets.

# Udozo's own Neon database, the pooled address (never BitoCard's). Migrations run on it in every production build.
DATABASE_URL=
# A new key of its own, made once (`openssl rand -base64 32`) and kept safe: it seals Udozo's stored secrets.
ENCRYPTION_KEY=
# Vercel Cron sends it to Udozo's /v1/cron/<job>: 32 characters or more, its own.
CRON_SECRET=
# Shared with udozo.com's app (apps/udozo) only.
STORE_SERVER_SECRET=
ALLOWED_ORIGINS=https://udozo.com,https://www.udozo.com,https://shq.udozo.com,https://admin.udozo.com,https://verify.udozo.com
SESSION_COOKIE_DOMAIN=.udozo.com
COOKIE_SECURE=on
ADMIN_APP_URL=https://admin.udozo.com
ADMIN_EMAIL_DOMAINS=udozo.com
ADMIN_SETUP_EMAILS=
# Email, needed before the first admin can be set up: the set-password link is emailed, and without a provider it is
# kept, never sent. A Resend key with sending access to udozo.com (verified in Resend). Once an admin is in, save it in
# Settings > Integrations > Email instead (the admin's value wins) and remove it here. The sender defaults to
# "Udozo <no-reply@udozo.com>"; EMAIL_FROM changes it.
RESEND_API_KEY=
# Udozo's own Upstash database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=600
WEBHOOK_ALLOW_PRIVATE_URLS=off
EVENTS_SETTLE_SECONDS=5
LOG_LEVEL=info
