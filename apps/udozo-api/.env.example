# Udozo's API: copy to .env for local development. Never commit .env. Production's environment is set on the udozo-api
# Vercel project (vercel.env.example).
#
# Only what the API needs to start and to protect admin access lives here. Service keys and their settings (email,
# SMS, payments, AI, storage, push, domains) are set by a super admin in Udozo's admin app: Settings > Integrations.
# They are encrypted in the database and apply within 30 seconds, without a restart. The same names still work as
# environment variables (a value set in the admin app wins); tests use that.

# --- Required ---------------------------------------------------------------------------------------------------

# Udozo's own Postgres (Neon, pooled connection string), never BitoCard's.
DATABASE_URL=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). Encrypts admin
# authenticator secrets, service keys set in the admin app and webhook secrets. Never change it once set.
ENCRYPTION_KEY=

# Scheduled jobs (vercel.json crons) send this as a Bearer token. Generate a long random value.
CRON_SECRET=

# Browser origins allowed to call the API with cookies (the CSRF check), and the shared cookie domain. Locally:
# udozo.com's app (3007), Seller HQ (3011), the admin app (3012) and Verify (3006).
ALLOWED_ORIGINS=http://localhost:3007,http://localhost:3011,http://localhost:3012,http://localhost:3006
SESSION_COOKIE_DOMAIN=
COOKIE_SECURE=off

# Email domains Udozo's admins may sign in with (checked server-side).
ADMIN_EMAIL_DOMAINS=udozo.com
# The admins' own addresses (comma separated): the only ones the admin sign-in page sets up (as super admins) and
# emails set-password or reset links to. Empty: none. ADMIN_APP_URL is where the links point (default
# https://admin.udozo.com).
ADMIN_SETUP_EMAILS=
ADMIN_APP_URL=http://localhost:3012

# --- Optional ---------------------------------------------------------------------------------------------------

# Udozo's own Upstash Redis (REST). Without it, rate limits use in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests per minute per caller on /v1.
RATE_LIMIT_PER_MINUTE=600
ADDRESS_RATE_LIMIT_PER_MINUTE=1200
# Sign-in, password and code routes, per address (still counted, in memory, if Redis is down).
AUTH_RATE_LIMIT_PER_MINUTE=30
# Proxies in front of the API to trust for the client address: 1 on Vercel, 0 if none.
TRUST_PROXY=1
# Shared with udozo.com's app (its STORE_SERVER_SECRET, at least 32 characters): it signs each shopper's address so
# signed-out shoppers are rate limited one by one. Unset, they share the store server's limit.
STORE_SERVER_SECRET=

# Webhooks to resellers. Local development only: allow http:// and private addresses as endpoints (refused in production).
WEBHOOK_ALLOW_PRIVATE_URLS=off
# Delivery transport: vercel (Vercel Queues; the default on Vercel, using OIDC) or database (the default elsewhere).
# WEBHOOK_QUEUE=
# GET /v1/events holds back events newer than this many seconds.
EVENTS_SETTLE_SECONDS=5

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
