# Copy to .env for local development. Never commit .env. (On Vercel the variables are vercel.env.example's.)
#
# Only what the API needs to start and to protect admin access lives here. Every service key (email, SMS, Google,
# Facebook, WhatsApp, payments, storage, push, AI) is set by a super admin in Udozo's admin app: Settings >
# Integrations, encrypted in the database. Everything else has a working default in src/config/config.ts (Udozo's own
# in productDefaults); add it here only to change it.

# --- Required (scripts/check-env.mjs refuses to deploy without them) ------------------------------------------------

# Postgres: Udozo's own database (Neon, pooled). Use a development database locally, never production's.
DATABASE_URL=

# 32 random bytes, base64 (node -e "console.log(crypto.randomBytes(32).toString('base64'))"). It must be the key the
# database's stored secrets were sealed with; never change it once set.
ENCRYPTION_KEY=

# Bearer token the scheduler sends to /v1/cron/<job>. At least 32 random characters.
CRON_SECRET=

# --- Local development (the defaults are production's) ----------------------------------------------------------

# Browser origins allowed to call the API with cookies: udozo.com, Seller HQ, the admin, Verify.
ALLOWED_ORIGINS=http://localhost:3007,http://localhost:3011,http://localhost:3012,http://localhost:3006
# Cookies over plain HTTP on localhost. Refused in production.
COOKIE_SECURE=off

# The admins' own addresses (comma separated): the only ones the admin sign-in page sets up and emails set-password
# links to. Empty: none. ADMIN_APP_URL is where those links point.
ADMIN_SETUP_EMAILS=
ADMIN_APP_URL=http://localhost:3012

# Shared with udozo.com, connect.udozo.com and pos.udozo.com (the same value in their environment, at least 32
# characters): signs shoppers' addresses, photo originals and traffic reports.
STORE_SERVER_SECRET=
