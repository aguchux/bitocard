{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@udozo/api && npm run vercel-build -w @udozo/api",
  "ignoreCommand": "npx turbo-ignore",
  "functions": {
    "api/webhook-queue.mjs": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "webhook-deliveries",
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/v1/cron/exchange-rates",
      "schedule": "5 * * * *"
    },
    {
      "path": "/v1/cron/payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/v1/cron/earnings",
      "schedule": "15 * * * *"
    },
    {
      "path": "/v1/cron/plans",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/v1/cron/invoices",
      "schedule": "20 * * * *"
    },
    {
      "path": "/v1/cron/domains",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/v1/cron/support",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/v1/cron/support-replies",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/v1/cron/webhooks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/v1/cron/webhooks-cleanup",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/v1/cron/identity",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/v1/cron/push",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/v1/cron/notifications-cleanup",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/v1/cron/media-cleanup",
      "schedule": "55 3 * * *"
    },
    {
      "path": "/v1/cron/classifieds",
      "schedule": "*/15 * * * *"
    }
  ]
}
