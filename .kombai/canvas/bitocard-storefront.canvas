      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{\n  --color-navy-950:#040935;--color-navy-900:#070f4c;--color-navy-800:#111a5e;--color-navy-700:#1d2873;\n  --color-brand-50:#fff0f7;--color-brand-100:#ffe0ef;--color-brand-400:#ff5ca8;--color-brand-500:#ff2382;--color-brand-600:#e3106b;--color-brand-700:#c00b58;\n  --color-azure-500:#2477ff;--color-page:#fcfdff;\n}\n.bc-font{font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n.no-bar{scrollbar-width:none}\n.no-bar::-webkit-scrollbar{display:none}\n</style>\n<div class=\"bc-font min-h-screen overflow-x-hidden bg-[var(--color-page)] text-[var(--color-navy-900)] antialiased\" data-kid=\"1\">\n    <!-- Header (phone) -->\n    <header class=\"border-b border-slate-100 bg-white/95\" data-kid=\"1-1\">\n        <div class=\"flex h-16 items-center gap-2 px-4\" data-kid=\"1-1-1\">\n            <a class=\"mr-auto inline-flex items-center gap-1.5 text-[22px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\">\n                <img alt=\"\" class=\"h-[26px] w-auto\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/bitocard-mark.png\"/>\n                <span class=\"inline-flex text-[var(--color-navy-900)]\" data-kid=\"1-1-1-1-2\">\n                    Bito\n                    <span class=\"text-[var(--color-brand-500)]\" data-kid=\"1-1-1-1-2-1\">\n                        card\n                    </span>\n                </span>\n            </a>\n            <button class=\"inline-flex min-h-11 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 text-sm font-semibold\" data-kid=\"1-1-1-2\">\n                <img alt=\"\" class=\"h-3.5 w-5 rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/node_modules/country-flag-icons/3x2/NG.svg\"/>\n                NG\n                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"icon-chevron-down\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Open menu\" class=\"grid size-11 place-items-center rounded-xl border border-slate-200 bg-white text-xl\" data-kid=\"1-1-1-3\">\n                <i class=\"icon-menu\" data-kid=\"1-1-1-3-1\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <!-- Hero -->\n    <section class=\"relative isolate overflow-hidden bg-[var(--color-navy-950)] text-white\" data-kid=\"1-2\">\n        <img alt=\"\" class=\"absolute inset-0 -z-20 h-full w-full object-cover object-[70%_center]\" data-kid=\"1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/hero/globe.webp\"/>\n        <div class=\"absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(5,10,51,.82),rgba(5,10,51,.55)_55%,rgba(5,10,51,.25))]\" data-kid=\"1-2-2\">\n        </div>\n        <div class=\"px-4 pt-8 pb-6\" data-kid=\"1-2-3\">\n            <h1 class=\"text-[40px] leading-[1.04] font-extrabold tracking-tight\" data-kid=\"1-2-3-1\">\n                One marketplace.\n                <br data-kid=\"1-2-3-1-1\"/>\n                <span class=\"text-[var(--color-brand-500)]\" data-kid=\"1-2-3-1-2\">\n                    More ways to pay.\n                </span>\n            </h1>\n            <p class=\"mt-3 text-base text-slate-200\" data-kid=\"1-2-3-2\">\n                Shop gift cards, top up mobile, pay bills, and explore digital essentials.\n            </p>\n            <!-- Search: two rows on phones -->\n            <form class=\"mt-5 rounded-2xl bg-white p-1.5 text-[var(--color-navy-900)] shadow-lg ring-1 ring-slate-200\" data-kid=\"1-2-3-3\">\n                <div class=\"flex items-stretch\" data-kid=\"1-2-3-3-1\">\n                    <label class=\"flex min-h-12 flex-1 items-center gap-2 rounded-xl pr-1 pl-2.5\" data-kid=\"1-2-3-3-1-1\">\n                        <span class=\"text-base text-slate-500\" data-kid=\"1-2-3-3-1-1-1\">\n                            <i class=\"icon-search\" data-kid=\"1-2-3-3-1-1-1-1\">\n                            </i>\n                        </span>\n                        <input class=\"w-full min-w-0 bg-transparent text-sm outline-none placeholder:text-slate-400\" data-kid=\"1-2-3-3-1-1-2\" placeholder=\"Find a product, brand or service\" type=\"search\"/>\n                    </label>\n                    <button aria-label=\"Search\" class=\"grid w-12 place-items-center rounded-xl bg-[var(--color-brand-500)] text-white\" data-kid=\"1-2-3-3-1-2\" type=\"button\">\n                        <span class=\"text-xl\" data-kid=\"1-2-3-3-1-2-1\">\n                            <i class=\"icon-search\" data-kid=\"1-2-3-3-1-2-1-1\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n                <button class=\"mt-1.5 flex min-h-11 w-full items-center gap-2 border-t border-slate-100 px-3 text-sm font-semibold\" data-kid=\"1-2-3-3-2\" type=\"button\">\n                    <img alt=\"\" class=\"h-4 w-6 rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-2-3-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/node_modules/country-flag-icons/3x2/NG.svg\"/>\n                    Nigeria\n                    <span class=\"ml-auto text-sm text-slate-400\" data-kid=\"1-2-3-3-2-2\">\n                        <i class=\"icon-chevron-down\" data-kid=\"1-2-3-3-2-2-1\">\n                        </i>\n                    </span>\n                </button>\n            </form>\n            <!-- Category chips scroll sideways with right fade -->\n            <div class=\"relative -mx-4 mt-4\" data-kid=\"1-2-3-4\">\n                <ul class=\"no-bar flex gap-2 overflow-x-auto px-4 pr-10 text-sm font-semibold text-white/90\" data-kid=\"1-2-3-4-1\">\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-1\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-pink-500\" data-kid=\"1-2-3-4-1-1-1\">\n                            <i class=\"icon-gift\" data-kid=\"1-2-3-4-1-1-1-1\">\n                            </i>\n                        </span>\n                        Gift cards\n                    </li>\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-2\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-sky-400\" data-kid=\"1-2-3-4-1-2-1\">\n                            <i class=\"icon-smartphone\" data-kid=\"1-2-3-4-1-2-1-1\">\n                            </i>\n                        </span>\n                        Mobile\n                    </li>\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-3\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-emerald-400\" data-kid=\"1-2-3-4-1-3-1\">\n                            <i class=\"icon-receipt-text\" data-kid=\"1-2-3-4-1-3-1-1\">\n                            </i>\n                        </span>\n                        Bills\n                    </li>\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-4\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-fuchsia-400\" data-kid=\"1-2-3-4-1-4-1\">\n                            <i class=\"icon-signal\" data-kid=\"1-2-3-4-1-4-1-1\">\n                            </i>\n                        </span>\n                        eSIMs\n                    </li>\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-5\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-amber-400\" data-kid=\"1-2-3-4-1-5-1\">\n                            <i class=\"icon-laptop\" data-kid=\"1-2-3-4-1-5-1-1\">\n                            </i>\n                        </span>\n                        Software\n                    </li>\n                    <li class=\"flex min-h-11 shrink-0 items-center gap-2 rounded-xl bg-white/10 pr-3 pl-1.5\" data-kid=\"1-2-3-4-1-6\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-cyan-400\" data-kid=\"1-2-3-4-1-6-1\">\n                            <i class=\"icon-credit-card\" data-kid=\"1-2-3-4-1-6-1-1\">\n                            </i>\n                        </span>\n                        Virtual cards\n                    </li>\n                </ul>\n                <div class=\"pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-[var(--color-navy-950)] to-transparent\" data-kid=\"1-2-3-4-2\">\n                </div>\n            </div>\n            <!-- Floating brand tiles (illustration) -->\n            <div aria-hidden=\"true\" class=\"relative mx-auto mt-6 h-[132px] max-w-[343px]\" data-kid=\"1-2-3-5\">\n                <div class=\"absolute top-3 left-1.5 h-[72px] w-[114px] -rotate-6 overflow-hidden rounded-xl shadow-[0_14px_30px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-5-1\">\n                    <img alt=\"\" class=\"h-full w-full scale-[1.04] object-cover\" data-kid=\"1-2-3-5-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/playstation.webp\"/>\n                </div>\n                <div class=\"absolute top-0 left-[116px] flex h-[72px] w-[114px] rotate-6 items-center justify-center overflow-hidden rounded-xl bg-[#ffcc00] shadow-[0_14px_30px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-5-2\">\n                    <span class=\"flex size-11 items-center justify-center rounded-[22%] bg-white p-1.5 shadow-md\" data-kid=\"1-2-3-5-2-1\">\n                        <img alt=\"\" class=\"h-full w-full object-contain\" data-kid=\"1-2-3-5-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-icons/mtn.svg\"/>\n                    </span>\n                </div>\n                <div class=\"absolute top-6 right-1.5 flex h-[72px] w-[114px] -rotate-6 items-center justify-center overflow-hidden rounded-xl bg-[#e50914] shadow-[0_14px_30px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-5-3\" data-name=\"Netflix floating brand tile\">\n                    <span class=\"flex size-11 items-center justify-center rounded-[22%] bg-white p-1.5 shadow-md\" data-kid=\"1-2-3-5-3-1\">\n                        <img alt=\"\" class=\"h-full w-full object-contain\" data-kid=\"1-2-3-5-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-icons/netflix.svg\"/>\n                    </span>\n                </div>\n                <div class=\"absolute bottom-0 left-[64px] h-[66px] w-[106px] rotate-3 overflow-hidden rounded-xl shadow-[0_14px_30px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-5-4\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-5-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/xbox.webp\"/>\n                </div>\n                <span class=\"absolute right-[62px] bottom-1 grid size-10 rotate-12 place-items-center rounded-xl bg-[var(--color-brand-500)] text-xl shadow-xl ring-1 ring-white/30\" data-kid=\"1-2-3-5-5\">\n                    <i class=\"icon-gift\" data-kid=\"1-2-3-5-5-1\">\n                    </i>\n                </span>\n                <span class=\"absolute bottom-5 left-[184px] grid size-9 -rotate-12 place-items-center rounded-lg bg-[var(--color-azure-500)] text-lg shadow-xl ring-1 ring-white/30\" data-kid=\"1-2-3-5-6\">\n                    <i class=\"icon-credit-card\" data-kid=\"1-2-3-5-6-1\">\n                    </i>\n                </span>\n            </div>\n        </div>\n    </section>\n    <main class=\"space-y-8 px-4 pt-7 pb-4\" data-kid=\"1-3\">\n        <!-- Trending now -->\n        <section data-kid=\"1-3-1\">\n            <div class=\"mb-3 flex items-end gap-3\" data-kid=\"1-3-1-1\">\n                <div class=\"mr-auto\" data-kid=\"1-3-1-1-1\">\n                    <h2 class=\"text-[22px] leading-tight font-extrabold tracking-tight\" data-kid=\"1-3-1-1-1-1\">\n                        Trending now\n                    </h2>\n                    <p class=\"mt-0.5 text-sm text-slate-500\" data-kid=\"1-3-1-1-1-2\">\n                        Popular brands. Great selection.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-10 shrink-0 items-center gap-1 rounded-lg px-1 text-sm font-semibold text-[var(--color-brand-600)]\" data-kid=\"1-3-1-1-2\">\n                    View all\n                    <i class=\"icon-arrow-right\" data-kid=\"1-3-1-1-2-1\">\n                    </i>\n                </a>\n            </div>\n            <nav class=\"no-bar -mx-4 mb-3 flex gap-2 overflow-x-auto px-4\" data-kid=\"1-3-1-2\">\n                <a class=\"inline-flex min-h-10 shrink-0 items-center rounded-full border border-[var(--color-brand-500)] bg-white px-4 text-sm font-semibold text-[var(--color-brand-600)]\" data-kid=\"1-3-1-2-1\">\n                    All\n                </a>\n                <a class=\"inline-flex min-h-10 shrink-0 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600\" data-kid=\"1-3-1-2-2\">\n                    Global\n                </a>\n                <a class=\"inline-flex min-h-10 shrink-0 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600\" data-kid=\"1-3-1-2-3\">\n                    Gaming\n                </a>\n                <a class=\"inline-flex min-h-10 shrink-0 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600\" data-kid=\"1-3-1-2-4\">\n                    Streaming\n                </a>\n                <a class=\"inline-flex min-h-10 shrink-0 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600\" data-kid=\"1-3-1-2-5\">\n                    Travel\n                </a>\n            </nav>\n            <ul class=\"no-bar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-2\" data-kid=\"1-3-1-3\">\n                <li class=\"w-[72%] shrink-0 snap-start\" data-kid=\"1-3-1-3-1\">\n                    <a class=\"flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm\" data-kid=\"1-3-1-3-1-1\">\n                        <div class=\"aspect-[16/9] overflow-hidden rounded-xl\" data-kid=\"1-3-1-3-1-1-1\">\n                            <img alt=\"PlayStation gift card\" class=\"h-full w-full scale-[1.04] object-cover\" data-kid=\"1-3-1-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/playstation.webp\"/>\n                        </div>\n                        <div class=\"flex flex-1 flex-col px-1 pt-3\" data-kid=\"1-3-1-3-1-1-2\">\n                            <h3 class=\"line-clamp-2 text-base leading-snug font-bold\" data-kid=\"1-3-1-3-1-1-2-1\">\n                                PlayStation Store gift card\n                            </h3>\n                            <p class=\"mt-0.5 line-clamp-2 text-sm text-slate-500\" data-kid=\"1-3-1-3-1-1-2-2\">\n                                Gift cards · United States\n                            </p>\n                            <div class=\"mt-auto flex items-end justify-between gap-2 pt-3\" data-kid=\"1-3-1-3-1-1-2-3\">\n                                <span class=\"text-base font-extrabold\" data-kid=\"1-3-1-3-1-1-2-3-1\">\n                                    From $10\n                                </span>\n                                <span class=\"grid size-9 place-items-center rounded-full bg-pink-50 text-lg text-[var(--color-brand-500)]\" data-kid=\"1-3-1-3-1-1-2-3-2\">\n                                    <i class=\"icon-arrow-right\" data-kid=\"1-3-1-3-1-1-2-3-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                        </div>\n                    </a>\n                </li>\n                <li class=\"w-[72%] shrink-0 snap-start\" data-kid=\"1-3-1-3-2\">\n                    <a class=\"flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm\" data-kid=\"1-3-1-3-2-1\">\n                        <div class=\"aspect-[16/9] overflow-hidden rounded-xl\" data-kid=\"1-3-1-3-2-1-1\">\n                            <img alt=\"Xbox gift card\" class=\"h-full w-full object-cover\" data-kid=\"1-3-1-3-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/xbox.webp\"/>\n                        </div>\n                        <div class=\"flex flex-1 flex-col px-1 pt-3\" data-kid=\"1-3-1-3-2-1-2\">\n                            <h3 class=\"line-clamp-2 text-base leading-snug font-bold\" data-kid=\"1-3-1-3-2-1-2-1\">\n                                Xbox gift card\n                            </h3>\n                            <p class=\"mt-0.5 line-clamp-2 text-sm text-slate-500\" data-kid=\"1-3-1-3-2-1-2-2\">\n                                Games, apps and add-ons on Xbox and Windows.\n                            </p>\n                            <div class=\"mt-auto flex items-end justify-between gap-2 pt-3\" data-kid=\"1-3-1-3-2-1-2-3\">\n                                <span class=\"text-base font-extrabold\" data-kid=\"1-3-1-3-2-1-2-3-1\">\n                                    From $15\n                                </span>\n                                <span class=\"grid size-9 place-items-center rounded-full bg-pink-50 text-lg text-[var(--color-brand-500)]\" data-kid=\"1-3-1-3-2-1-2-3-2\">\n                                    <i class=\"icon-arrow-right\" data-kid=\"1-3-1-3-2-1-2-3-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                        </div>\n                    </a>\n                </li>\n                <li class=\"w-[72%] shrink-0 snap-start\" data-kid=\"1-3-1-3-3\">\n                    <a class=\"flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm\" data-kid=\"1-3-1-3-3-1\">\n                        <div class=\"flex aspect-[16/9] flex-col items-center justify-center gap-[6%] overflow-hidden rounded-xl bg-gradient-to-br from-indigo-500 to-blue-700\" data-kid=\"1-3-1-3-3-1-1\">\n                            <img alt=\"\" class=\"aspect-[3/2] w-[34%] rounded-md shadow-lg\" data-kid=\"1-3-1-3-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/node_modules/country-flag-icons/3x2/US.svg\"/>\n                            <span class=\"rounded-full bg-white/90 px-2.5 py-0.5 text-[10px] font-bold tracking-wide text-[var(--color-navy-900)] uppercase\" data-kid=\"1-3-1-3-3-1-1-2\">\n                                Local number\n                            </span>\n                        </div>\n                        <div class=\"flex flex-1 flex-col px-1 pt-3\" data-kid=\"1-3-1-3-3-1-2\">\n                            <h3 class=\"line-clamp-2 text-base leading-snug font-bold\" data-kid=\"1-3-1-3-3-1-2-1\">\n                                United States local number, Waukesha\n                            </h3>\n                            <p class=\"mt-0