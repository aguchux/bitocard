      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{\n  --color-navy-950:#040935;--color-navy-900:#070f4c;--color-navy-800:#111a5e;--color-navy-700:#1d2873;\n  --color-brand-50:#fff0f7;--color-brand-100:#ffe0ef;--color-brand-400:#ff5ca8;--color-brand-500:#ff2382;--color-brand-600:#e3106b;--color-brand-700:#c00b58;\n  --color-azure-500:#2477ff;--color-page:#fcfdff;\n}\n.bc-font{font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n</style>\n<div class=\"bc-font min-h-screen bg-[var(--color-page)] text-[var(--color-navy-900)] antialiased\" data-kid=\"1\">\n    <!-- Header -->\n    <header class=\"sticky top-0 z-30 border-b border-slate-100 bg-white/95 backdrop-blur\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1400px] items-center gap-6 px-8\" data-kid=\"1-1-1\">\n            <a class=\"inline-flex items-center gap-2 text-[26px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\">\n                <img alt=\"\" class=\"h-[30px] w-auto\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/bitocard-mark.png\"/>\n                <span class=\"inline-flex text-[var(--color-navy-900)]\" data-kid=\"1-1-1-1-2\" data-name=\"header brand wordmark\">\n                    Bito\n                    <span class=\"text-[var(--color-brand-500)]\" data-kid=\"1-1-1-1-2-1\">\n                        card\n                    </span>\n                </span>\n            </a>\n            <nav class=\"flex items-center gap-1 text-[15px] font-semibold\" data-kid=\"1-1-1-2\">\n                <button class=\"inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3 hover:bg-slate-50\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"text-lg\" data-kid=\"1-1-1-2-1-1\">\n                        <i class=\"icon-layout-grid\" data-kid=\"1-1-1-2-1-1-1\">\n                        </i>\n                    </span>\n                    Catalog\n                    <span class=\"text-sm text-slate-400\" data-kid=\"1-1-1-2-1-2\">\n                        <i class=\"icon-chevron-down\" data-kid=\"1-1-1-2-1-2-1\">\n                        </i>\n                    </span>\n                </button>\n                <a class=\"inline-flex min-h-11 items-center rounded-lg px-3 hover:bg-slate-50\" data-kid=\"1-1-1-2-2\">\n                    Virtual numbers\n                </a>\n                <a class=\"inline-flex min-h-11 items-center rounded-lg px-3 hover:bg-slate-50\" data-kid=\"1-1-1-2-3\">\n                    Virtual cards\n                </a>\n                <a class=\"inline-flex min-h-11 items-center rounded-lg px-3 hover:bg-slate-50\" data-kid=\"1-1-1-2-4\">\n                    Crypto\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-xl px-3 text-[15px] font-semibold hover:bg-slate-50\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"text-lg text-slate-500\" data-kid=\"1-1-1-3-1-1\">\n                        <i class=\"icon-earth\" data-kid=\"1-1-1-3-1-1-1\">\n                        </i>\n                    </span>\n                    Nigeria\n                    <span class=\"text-sm text-slate-400\" data-kid=\"1-1-1-3-1-2\">\n                        <i class=\"icon-chevron-down\" data-kid=\"1-1-1-3-1-2-1\">\n                        </i>\n                    </span>\n                </button>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-[15px] font-semibold hover:border-slate-300\" data-kid=\"1-1-1-3-2\">\n                    <img alt=\"\" class=\"h-4 w-6 rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-1-1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/node_modules/country-flag-icons/3x2/NG.svg\"/>\n                    NGN (₦)\n                    <span class=\"text-sm text-slate-400\" data-kid=\"1-1-1-3-2-2\">\n                        <i class=\"icon-chevron-down\" data-kid=\"1-1-1-3-2-2-1\">\n                        </i>\n                    </span>\n                </button>\n                <a class=\"inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 text-[15px] font-semibold hover:border-slate-300\" data-kid=\"1-1-1-3-3\">\n                    Sign in\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-xl bg-[var(--color-brand-500)] px-4 text-[15px] font-semibold text-white shadow-sm hover:bg-[var(--color-brand-600)]\" data-kid=\"1-1-1-3-4\">\n                    <span class=\"text-xl\" data-kid=\"1-1-1-3-4-1\">\n                        <i class=\"icon-store\" data-kid=\"1-1-1-3-4-1-1\">\n                        </i>\n                    </span>\n                    Start Reselling\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- Hero (full bleed) -->\n    <section class=\"relative isolate overflow-hidden bg-[var(--color-navy-950)] text-white\" data-kid=\"1-2\">\n        <img alt=\"\" class=\"absolute inset-0 -z-20 h-full w-full object-cover object-right\" data-kid=\"1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/hero/globe.webp\"/>\n        <div class=\"absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(5,10,51,.88),rgba(5,10,51,.5)_45%,rgba(5,10,51,0)_68%)]\" data-kid=\"1-2-2\">\n        </div>\n        <div class=\"mx-auto grid max-w-[1400px] grid-cols-12 items-center gap-8 px-8 py-14\" data-kid=\"1-2-3\">\n            <div class=\"col-span-7\" data-kid=\"1-2-3-1\">\n                <h1 class=\"text-[72px] leading-[1.02] font-extrabold tracking-tight\" data-kid=\"1-2-3-1-1\">\n                    One marketplace.\n                    <br data-kid=\"1-2-3-1-1-1\"/>\n                    <span class=\"text-[var(--color-brand-500)]\" data-kid=\"1-2-3-1-1-2\">\n                        More ways to pay.\n                    </span>\n                </h1>\n                <p class=\"mt-4 max-w-2xl text-xl text-slate-200\" data-kid=\"1-2-3-1-2\">\n                    Shop gift cards, top up mobile, pay bills, and explore digital essentials.\n                </p>\n                <form class=\"mt-7 flex min-h-16 max-w-3xl items-stretch rounded-2xl bg-white p-1.5 text-[var(--color-navy-900)] shadow-lg ring-1 ring-slate-200\" data-kid=\"1-2-3-1-3\">\n                    <label class=\"flex flex-1 items-center gap-3 rounded-xl px-4\" data-kid=\"1-2-3-1-3-1\">\n                        <span class=\"text-xl\" data-kid=\"1-2-3-1-3-1-1\">\n                            <i class=\"icon-search\" data-kid=\"1-2-3-1-3-1-1-1\">\n                            </i>\n                        </span>\n                        <input class=\"w-full bg-transparent text-[17px] outline-none placeholder:text-slate-400\" data-kid=\"1-2-3-1-3-1-2\" placeholder=\"Find a product, brand or service\" type=\"search\"/>\n                    </label>\n                    <button class=\"flex w-52 items-center gap-2 border-l border-slate-200 px-4 text-[15px] font-semibold\" data-kid=\"1-2-3-1-3-2\" type=\"button\">\n                        <img alt=\"\" class=\"h-4 w-6 rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-2-3-1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/node_modules/country-flag-icons/3x2/NG.svg\"/>\n                        Nigeria\n                        <span class=\"ml-auto text-sm text-slate-400\" data-kid=\"1-2-3-1-3-2-2\">\n                            <i class=\"icon-chevron-down\" data-kid=\"1-2-3-1-3-2-2-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Search\" class=\"grid w-20 place-items-center rounded-xl bg-[var(--color-brand-500)] text-white hover:bg-[var(--color-brand-600)]\" data-kid=\"1-2-3-1-3-3\" type=\"button\">\n                        <span class=\"text-2xl\" data-kid=\"1-2-3-1-3-3-1\">\n                            <i class=\"icon-search\" data-kid=\"1-2-3-1-3-3-1-1\">\n                            </i>\n                        </span>\n                    </button>\n                </form>\n                <ul class=\"mt-5 flex items-center gap-x-5 text-sm font-semibold text-white/90\" data-kid=\"1-2-3-1-4\">\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-1\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-pink-500\" data-kid=\"1-2-3-1-4-1-1\">\n                            <i class=\"icon-gift\" data-kid=\"1-2-3-1-4-1-1-1\">\n                            </i>\n                        </span>\n                        Gift cards\n                    </li>\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-2\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-sky-400\" data-kid=\"1-2-3-1-4-2-1\">\n                            <i class=\"icon-smartphone\" data-kid=\"1-2-3-1-4-2-1-1\">\n                            </i>\n                        </span>\n                        Mobile\n                    </li>\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-3\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-emerald-400\" data-kid=\"1-2-3-1-4-3-1\">\n                            <i class=\"icon-receipt-text\" data-kid=\"1-2-3-1-4-3-1-1\">\n                            </i>\n                        </span>\n                        Bills\n                    </li>\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-4\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-fuchsia-400\" data-kid=\"1-2-3-1-4-4-1\">\n                            <i class=\"icon-signal\" data-kid=\"1-2-3-1-4-4-1-1\">\n                            </i>\n                        </span>\n                        eSIMs\n                    </li>\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-5\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-amber-400\" data-kid=\"1-2-3-1-4-5-1\">\n                            <i class=\"icon-laptop\" data-kid=\"1-2-3-1-4-5-1-1\">\n                            </i>\n                        </span>\n                        Software\n                    </li>\n                    <li class=\"flex min-h-11 items-center gap-2\" data-kid=\"1-2-3-1-4-6\">\n                        <span class=\"grid size-8 place-items-center rounded-lg bg-white/10 text-base text-cyan-400\" data-kid=\"1-2-3-1-4-6-1\">\n                            <i class=\"icon-credit-card\" data-kid=\"1-2-3-1-4-6-1-1\">\n                            </i>\n                        </span>\n                        Virtual cards\n                    </li>\n                </ul>\n            </div>\n            <!-- Floating brand tiles (illustration) -->\n            <div aria-hidden=\"true\" class=\"relative col-span-5 h-[24rem]\" data-kid=\"1-2-3-2\">\n                <div class=\"absolute top-[10%] left-[8%] h-28 w-44 -rotate-6 overflow-hidden rounded-2xl shadow-[0_20px_45px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-2-1\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/playstation.webp\"/>\n                </div>\n                <div class=\"absolute top-[4%] right-[8%] flex h-28 w-44 rotate-6 items-center justify-center overflow-hidden rounded-2xl bg-[#ffcc00] shadow-[0_20px_45px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-2-2\">\n                    <span class=\"flex size-[4.5rem] items-center justify-center rounded-[22%] bg-white p-2.5 shadow-md\" data-kid=\"1-2-3-2-2-1\">\n                        <img alt=\"\" class=\"h-full w-full object-contain\" data-kid=\"1-2-3-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-icons/mtn.svg\"/>\n                    </span>\n                </div>\n                <div class=\"absolute bottom-[5%] left-[22%] h-28 w-44 rotate-6 overflow-hidden rounded-2xl shadow-[0_20px_45px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-2-3\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-cards/xbox.webp\"/>\n                </div>\n                <div class=\"absolute right-[2%] bottom-[18%] flex h-28 w-44 -rotate-6 items-center justify-center overflow-hidden rounded-2xl bg-[#e50914] shadow-[0_20px_45px_rgba(0,0,0,.45)] ring-1 ring-white/25\" data-kid=\"1-2-3-2-4\">\n                    <span class=\"flex size-[4.5rem] items-center justify-center rounded-[22%] bg-white p-2.5 shadow-md\" data-kid=\"1-2-3-2-4-1\">\n                        <img alt=\"\" class=\"h-full w-full object-contain\" data-kid=\"1-2-3-2-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/storefront/public/brand-icons/netflix.svg\"/>\n                    </span>\n                </div>\n                <span class=\"absolute top-[34%] left-[0%] grid size-12 -rotate-12 place-items-center rounded-xl bg-[var(--color-azure-500)] text-2xl shadow-xl ring-1 ring-white/30\" data-kid=\"1-2-3-2-5\">\n                    <i class=\"icon-smartphone\" data-kid=\"1-2-3-2-5-1\">\n                    </i>\n                </span>\n                <span class=\"absolute top-[-2%] right-[0%] grid size-14 rotate-12 place-items-center rounded-2xl bg-[var(--color-brand-500)] text-[28px] shadow-xl ring-1 ring-white/30\" data-kid=\"1-2-3-2-6\">\n                    <i class=\"icon-gift\" data-kid=\"1-2-3-2-6-1\">\n                    </i>\n                </span>\n                <span class=\"absolute right-[44%] bottom-[0%] grid size-12 rotate-12 place-items-center rounded-xl bg-[var(--color-azure-500)] text-2xl shadow-xl ring-1 ring-white/30\" data-kid=\"1-2-3-2-7\">\n                    <i class=\"icon-credit-card\" data-kid=\"1-2-3-2-7-1\">\n                    </i>\n                </span>\n                <span class=\"absolute top-[62%] left-[4%] size-9 rotate-12 rounded-lg bg-[var(--color-brand-400)] shadow-xl\" data-kid=\"1-2-3-2-8\">\n                </span>\n            </div>\n        </div>\n    </section>\n    <main class=\"mx-auto max-w-[1400px] px-8 pt-7 pb-4\" data-kid=\"1-3\">\n        <div class=\"grid grid-cols-12 gap-7\" data-kid=\"1-3-1\">\n            <!-- Trending now (8 cols, 2 rows) -->\n            <section class=\"col-span-8 row-span-2\" data-kid=\"1-3-1-1\">\n                <div class=\"mb-4 flex items-end gap-6\" data-kid=\"1-3-1-1-1\">\n                    <div class=\"mr-auto\" data-kid=\"1-3-1-1-1-1\">\n                        <h2 class=\"text-3xl leading-tight font-extrabold tracking-tight\" data-kid=\"1-3-1-1-1-1-1\">\n                            Trending now\n                        </h2>\n                        <p class=\"mt-1 text-base text-slate-500\" data-kid=\"1-3-1-1-1-1-2\">\n                            Popular brands. Great selection. Delivered digitally.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2 text-base font-semibold text-[var(--color-brand-600)] hover:bg-pink-50\" data-kid=\"1-3-1-1-1-2\">\n                        View all\n                        <i class=\"icon-arrow-right\" data-kid=\"1-3-1-1-1-2-1\">\n                        </i>\n                    </a>\n                </div>\n                <nav class=\"mb-4 flex gap-2\" data-kid=\"1-3-1-1-2\">\n                    <a class=\"inline-flex min-h-10 items-center rounded-full border border-[var(--color-brand-500)] bg-white px-4 text-sm font-semibold text-[var(--color-brand-600)]\" data-kid=\"1-3-1-1-2-1\">\n                        All\n                    </a>\n                    <a class=\"inline-flex min-h-10 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600 hover:border-slate-300\" data-kid=\"1-3-1-1-2-2\">\n                        Global\n                    </a>\n                    <a class=\"inline-flex min-h-10 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600 hover:border-slate-300\" data-kid=\"1-3-1-1-2-3\">\n                        Gaming\n                    </a>\n                    <a class=\"inline-flex min-h-10 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600 hover:border-slate-300\" data-kid=\"1-3-1-1-2-4\">\n                        Streaming\n                    </a>\n                    <a class=\"inline-flex min-h-10 items-center rounded-full border border-slate-200 bg-white px-4 text-sm text-slate-600 hover:border-slate-300\" data-kid=\"1-3-1-1-2-5\">\n                        Travel\n                    </a>\n                </nav>\n                <ul class=\"grid grid-cols-3 gap-4\" data-kid=\"1-3-1-1-3\">\n                    <li data-kid=\"1-3-1-1-3-1\">\n                        <a class=\"group flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md\" data-kid=\"1-3-1-1-3-1-1\">\n                            <div class=\"aspect-[16/9] overflow-hidden rounded-xl\" data-kid=\"1-3-1-1-3-1-1-1\">\n                                <img alt=\"