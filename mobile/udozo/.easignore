# What EAS Build never needs: it installs the packages itself.
node_modules/
.expo/
dist/
web-build/
test/
*.log
# The Play service account is only for eas submit, never in a build
google-service-account.json
# Firebase Admin keys belong to the API (Settings > Integrations > Phone push), never a build
*firebase-adminsdk*.json
# Play listing images and their renderer
store-listing/
