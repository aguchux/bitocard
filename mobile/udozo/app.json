{
  "expo": {
    "name": "Udozo",
    "slug": "udozo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "udozo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.udozo.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:udozo.com",
        "webcredentials:udozo.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.udozo.app",
      "adaptiveIcon": {
        "backgroundColor": "#185174",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPattern": "/.*/l/.*"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPattern": "/.*/seller/.*"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPattern": "/.*/brand/.*"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPattern": "/.*/c/.*"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPrefix": "/account/"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "pathPrefix": "/pay/"
            },
            {
              "scheme": "https",
              "host": "udozo.com",
              "path": "/signin/whatsapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#185174",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#185174",
          "defaultChannel": "notices"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Udozo uses your photos when you add them to an ad or a chat.",
          "cameraPermission": "Udozo uses the camera when you take photos or record a video for an ad or a chat.",
          "microphonePermission": "Udozo uses the microphone for the sound of a video you record for an ad."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Udozo uses the camera to take photos for an ad or a chat, and to scan a shop's code to pay.",
          "microphonePermission": "Udozo uses the microphone for the sound of a video you record for an ad.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Udozo asks for Face ID before you pay, pay out or show a release code."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.udozo.com",
      "siteUrl": "https://udozo.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "618f4ba2-0c6d-4c4a-bb97-46e3ddaedde8"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "golojan"
  }
}
