{
  "expo": {
    "name": "BitoCard",
    "slug": "bitocard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitocard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bitocard.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:bitocard.com",
        "webcredentials:bitocard.com"
      ]
    },
    "android": {
      "package": "com.bitocard.app",
      "adaptiveIcon": {
        "backgroundColor": "#002b85",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/orders"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/account/orders/"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/wallet"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/account/wallet/"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/account/sold/"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/airtime"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/account/airtime/"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/support"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/account/support/"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/verification"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "path": "/account/notifications"
            },
            {
              "scheme": "https",
              "host": "bitocard.com",
              "pathPrefix": "/p/gift_cards"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070f4c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#070f4c"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BitoCard asks for Face ID before money leaves your wallet."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BitoCard uses your photos when you sell a gift card: photos of the card for checking.",
          "cameraPermission": "BitoCard uses the camera when you photograph a gift card you are selling.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.bitocard.com",
      "siteUrl": "https://bitocard.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "golojan"
  }
}
