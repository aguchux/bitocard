# The local copy of BitoCard and Udozo (docs/LOCAL_TESTING.md). `npm run local:setup` copies this to .env.docker
# (git-ignored, never in an image) and fills in the generated secrets. Fill in the rest yourself.

# Where the live data is copied from: each product's live database address (Neon). Only read, by pg_dump; never
# given to the apps. Leave one empty to skip that product's copy.
SOURCE_BITOCARD_DATABASE_URL=
SOURCE_UDOZO_DATABASE_URL=

# Each product's live ENCRYPTION_KEY, so the copy's encrypted fields (phone numbers, sealed codes, saved settings)
# can be read locally. The copy's provider keys are deleted when it is scrubbed, whatever this is. Left as generated,
# the apps run, but anything encrypted on live cannot be read.
BITOCARD_ENCRYPTION_KEY=
UDOZO_ENCRYPTION_KEY=

# Generated by local:setup; local only.
LOCAL_CRON_SECRET=
BITOCARD_STORE_SERVER_SECRET=
UDOZO_STORE_SERVER_SECRET=
